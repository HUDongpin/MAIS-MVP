{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    // Signature labs (components/visualizations/signature/*.jsx) are ported
    // byte-for-byte from the Claude Math Visual library and are not converted
    // to TypeScript. checkJs stays false so those files compile without
    // type-checking; every other file in the repo keeps strict checking.
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".tmp/a06-verify/next-dist/types/**/*.ts",
    ".tmp/audit-e2e/next-dev/types/**/*.ts",
    ".tmp/audit-e2e/next-dist/types/**/*.ts",
    ".tmp/content-qa-session/next-dist/types/**/*.ts",
    ".tmp/figure-qa-session/next-dist/types/**/*.ts",
    ".tmp/galaxy-verify/next-dist/types/**/*.ts",
    ".tmp/games-qa-session/next-dist/types/**/*.ts",
    ".tmp/island-ux-session/next-dist/types/**/*.ts",
    ".tmp/lab-ux-session/next-dist/types/**/*.ts",
    ".tmp/login-ux-session/next-dist/types/**/*.ts",
    ".tmp/mais-dev/next-dist/types/**/*.ts",
    ".tmp/next-dev-verify/types/**/*.ts",
    "components/visualizations/signature/**/*.jsx",
    "next-env.d.ts",
    ".tmp/teacher-ux-session/next-dist/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "private",
    "private/**/*",
    "Users",
    "Users/**/*"
  ]
}
