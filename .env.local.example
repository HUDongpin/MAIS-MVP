# Server-only LLM settings for the AI Tutor.
# Do not expose these values with NEXT_PUBLIC_.
# AI Tutor text, image attachments, realtime reply voice, and speech input use Ali Qwen.
# Leave QWEN_API_KEY blank for local helper mode. Set it to enable live AI Tutor responses.
# Provider profiles split deterministic QA from mocked/live readiness:
# offline-fixture = no provider spend for backend/e2e regression;
# mocked-live = fake-key local provider contract tests; live-smoke/production = real server-only readiness.
AI_TUTOR_PROVIDER_PROFILE=
QWEN_API_KEY=
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_TEXT_MODEL=qwen3.7-plus
QWEN_IMAGE_MODEL=qwen3.7-plus
QWEN_REALTIME_MODEL=qwen3.5-omni-flash-realtime
QWEN_REALTIME_API_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_ASR_REALTIME_MODEL=qwen3-asr-flash-realtime
QWEN_ASR_REALTIME_API_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# Optional legacy/shared LLM settings for non-AI Tutor server consumers.
# Legacy production aliases LLM_API_KEY, LLM_MODEL, and LLM_API_URL are also accepted.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# Optional: pin api.deepseek.com to a verified reachable IPv4 when local DNS
# intermittently resolves to a TLS-timeout route. Leave blank by default.
DEEPSEEK_API_RESOLVE_IP=

# Teacher assignment creation generation.
# Text-only assignment generation uses DeepSeek; image-attached generation uses Qwen.
ASSIGNMENT_CREATION_QUESTION_COUNT=5
ASSIGNMENT_CREATION_LLM_MAX_COMPLETION_TOKENS=3000
ASSIGNMENT_CREATION_LLM_TIMEOUT_MS=30000

# EdUHK OpenAPI app gateway for teacher question generation.
# Keep app ids and keys server-only.
EDUHK_LLM_BASE_URL=https://maas.eduhk.hk
EDUHK_ITEM_GENERATE_APP_ID=
EDUHK_ITEM_GENERATE_API_KEY=
EDUHK_ITEM_GENERATE_APP_ID_2=
EDUHK_ITEM_GENERATE_API_KEY_2=
EDUHK_LLM_PROVIDER_TIMEOUT_MS=30000

# Server-only secret used to sign HttpOnly login sessions.
# Required for `next start` and production deployments.
AUTH_SESSION_SECRET=

# Google OAuth / OpenID Connect sign-in. Keep all values server-only and
# explicitly enable only after environment-specific redirect URIs are verified.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_STATE_SECRET=

# Enterprise WeChat group robot notifications for teacher operations.
# Keep webhook URLs server-only. WECOM_GROUP_CHANNELS_JSON maps visible channel ids
# to environment variable names, never to the actual webhook URL.
WECOM_NOTIFICATIONS_ENABLED=false
WECOM_GROUP_CHANNELS_JSON=[{"id":"s3a-parent-group","name":"S3A Parent Group","envKey":"WECOM_WEBHOOK_S3A_PARENT_GROUP","classIds":["class-demo-s3a"]}]
WECOM_WEBHOOK_S3A_PARENT_GROUP=
WECOM_REQUEST_TIMEOUT_MS=12000
TEACHER_REMINDER_CRON_SECRET=

# SQLite persistence. Defaults to .local/hk-math-db.sqlite for local development.
# On Vercel without HK_MATH_DB_PATH, the app uses writable but ephemeral /tmp storage.
# Use an absolute path for a mounted persistent volume in a single-node pilot.
HK_MATH_DB_PATH=

# Durable Vercel/production persistence.
# For real Production on Vercel, set these in the Vercel Production environment
# and keep POSTGRES_URL server-only. Without this, smoke accounts can drift across
# serverless function instances and authenticated browser flows may return 401.
HK_MATH_STORAGE_PROVIDER=sqlite
POSTGRES_URL=

# Learning Record Store (LRS) / xAPI learning analytics.
# Keep LRS credentials server-only. The browser sends learning events to
# /api/learning-events; the server forwards validated xAPI statements to LRS.
LRS_ENABLED=false
LRS_ENDPOINT=
LRS_USERNAME=
LRS_PASSWORD=
LRS_XAPI_VERSION=1.0.3
LRS_ACTIVITY_BASE_IRI=https://mais-mvp.local/xapi
LRS_REQUEST_TIMEOUT_MS=12000
LRS_DELIVERY_MAX_ATTEMPTS=3
LRS_RETRY_BASE_DELAY_MS=0
LRS_SMOKE_TEST_SECRET=
# Do not mix learning analytics with BUG_LRS operational telemetry.
# BUG_LRS_ENDPOINT / BUG_LRS_USERNAME / BUG_LRS_PASSWORD live in the separate bug triage channel when configured.

# Demo seed controls. Keep disabled in production unless this is an explicit demo deployment.
HK_MATH_ENABLE_DEMO_USER=false
HK_MATH_DEMO_PASSWORD=

# Optional server-only bootstrap for the first administrator account.
# Set these only in a controlled local/staging/production environment; never expose with NEXT_PUBLIC_.
MAIS_BOOTSTRAP_ADMIN_EMAIL=
MAIS_BOOTSTRAP_ADMIN_USERNAME=
MAIS_BOOTSTRAP_ADMIN_NAME=
MAIS_BOOTSTRAP_ADMIN_PASSWORD=

# Mainland PEP content rollout guard.
# Defaults to enabled in local development and disabled in production when unset.
# Set true only in approved staging/canary/production environments after QA signoff.
MAINLAND_PEP_CONTENT_ENABLED=

# Local/demo password reset support. Keep false in real production email deployments.
HK_MATH_EXPOSE_LOCAL_RESET_LINKS=false

# Password reset delivery. Use either Resend or a private webhook before enabling
# real production account recovery. PASSWORD_RESET_BASE_URL should be the public
# app origin used in emailed links, for example https://your-domain.example.
RESEND_API_KEY=
PASSWORD_RESET_FROM=
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_BASE_URL=
PASSWORD_RESET_DELIVERY_TIMEOUT_MS=12000

# AI Tutor safety and cost controls.
AI_TUTOR_MAX_REQUESTS_PER_MINUTE=6
AI_TUTOR_MAX_REQUESTS_PER_HOUR=30
AI_TUTOR_MAX_COMPLETION_TOKENS=900
AI_TUTOR_MAX_ESTIMATED_TOKENS_PER_REQUEST=12000
AI_TUTOR_TOTAL_DEADLINE_MS=7500
# Edge wrapper returns fallback before the total deadline so students see a result within the live SLA.
AI_TUTOR_EDGE_RESPONSE_RESERVE_MS=3500
AI_TUTOR_PROVIDER_TIMEOUT_MS=8000
AI_TUTOR_LATENCY_ALERT_P95_MS=12000
AI_TUTOR_LATENCY_ALERT_TIMEOUT_RATE=0.02
AI_TUTOR_LIVE_TEXT_FIRST_EVENT_MS=1000
AI_TUTOR_LIVE_TEXT_MAX_CASE_LATENCY_MS=12000
AI_TUTOR_LIVE_TEXT_P95_LATENCY_MS=8000
AI_TUTOR_LIVE_TEXT_P99_LATENCY_MS=12000
AI_TUTOR_VOICE_PROVIDER_TIMEOUT_MS=30000
AI_TUTOR_VOICE_MAX_REQUESTS_PER_MINUTE=12
AI_TUTOR_VOICE_MAX_REQUESTS_PER_HOUR=120
AI_TUTOR_SPEECH_PROVIDER_TIMEOUT_MS=30000
AI_TUTOR_SPEECH_MAX_REQUESTS_PER_MINUTE=8
AI_TUTOR_SPEECH_MAX_REQUESTS_PER_HOUR=80
AI_TUTOR_SPEECH_MAX_AUDIO_SECONDS=20
AI_TUTOR_TOKEN_LIMIT_5H=200000000
AI_TUTOR_DEMO_TOKEN_LIMIT_5H=200000000

# Governed media object storage for AI/OCR/profile/work-sample images.
# AI_MEDIA_ENCRYPTION_KEY must be a 32-byte base64 value or equivalent secret stored only in local/Vercel env vars.
AI_MEDIA_OBJECT_STORAGE_REQUIRED=false
AI_MEDIA_OBJECT_STORE_DIR=.local/media-objects
AI_MEDIA_ENCRYPTION_KEY=
AI_MEDIA_REQUIRE_ENCRYPTION=true
AI_MEDIA_REQUIRE_PASSED_SCAN=true
AI_MEDIA_RETENTION_DAYS=90
AI_MEDIA_DATA_URL_MAX_BYTES=2000000
AI_MEDIA_MAX_REQUESTS_PER_MINUTE=20
LESSON_AUDIO_MAX_REQUESTS_PER_MINUTE=10
LESSON_AUDIO_MAX_REQUESTS_PER_HOUR=120

# Handwriting recognition for Practice/Lesson answer boards.
# SimpleTex is the primary production OCR path for handwritten math/STEM.
# Store real SimpleTex credentials only in .env.local / Vercel env vars; never expose them with NEXT_PUBLIC_.
# SimpleTex support may recommend UAT auth for development/testing. When using UAT,
# leave SIMPLETEX_APP_ID and SIMPLETEX_APP_SECRET empty so requests use the `token` header.
SIMPLETEX_UAT=
SIMPLETEX_API_URL=https://server.simpletex.cn/api/simpletex_ocr
# Optional SimpleTex APP auth. Do not set these together with SIMPLETEX_UAT unless
# the API route is intentionally configured to prefer APP auth.
SIMPLETEX_APP_ID=
SIMPLETEX_APP_SECRET=

# Optional Mathpix fallback.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
MATHPIX_STROKES_API_URL=https://api.mathpix.com/v3/strokes
HANDWRITING_RECOGNITION_CONFIDENCE_THRESHOLD=0.7
HANDWRITING_RECOGNITION_MAX_REQUESTS_PER_MINUTE=20
HANDWRITING_RECOGNITION_MAX_REQUESTS_PER_HOUR=160
HANDWRITING_RECOGNITION_PROVIDER_TIMEOUT_MS=12000
HANDWRITING_RECOGNITION_SIMPLETEX_MAX_ATTEMPTS=2
HANDWRITING_RECOGNITION_SIMPLETEX_RETRY_DELAY_MS=350

# Optional vision LLM fallback. Uses QWEN_API_KEY when enabled.
HANDWRITING_RECOGNITION_LLM_FALLBACK_ENABLED=false
HANDWRITING_RECOGNITION_LLM_MODEL=
HANDWRITING_RECOGNITION_LLM_API_URL=

# Adaptive Learning guarded LLM reranker controls.
# The adaptive reranker requests JSON mode and disables DeepSeek thinking so small
# candidate-selection JSON responses are less likely to be truncated.
ADAPTIVE_LLM_MAX_REQUESTS_PER_MINUTE=3
ADAPTIVE_LLM_MAX_REQUESTS_PER_HOUR=20
ADAPTIVE_LLM_MAX_COMPLETION_TOKENS=1200
ADAPTIVE_LLM_PROVIDER_TIMEOUT_MS=30000
