# MAIS-MVP environment template.
# The full local template is .env.local.example. This file documents the
# demo-seed backfill flag that must stay off for a production children's site.

# Merge stable-id demo seed rows into the persistent data store
# (example students, classes, enrollments, and submissions such as
# enrollment-us-ca-p1-student-jon and submission-us-ca-p1-add-subtract-check-jon).
# Defaults off. Vercel production (VERCEL_ENV=production) refuses the backfill
# unless this is exactly 1 or true. HK_MATH_ENABLE_DEMO_USER does not override
# that refusal. Outside Vercel production, leave this unset so local, dev,
# test, and CI demo accounts keep working. Set 0 or false to force it off.
MAIS_DEMO_SEED_BACKFILL=
