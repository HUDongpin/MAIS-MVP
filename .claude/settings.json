{
  "permissions": {
    "deny": [
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git add .)",
      "Bash(git add . *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); case \"$p\" in *git*) printf '%s' \"$p\" | node \"$CLAUDE_PROJECT_DIR/scripts/claude-root-git-guard.mjs\";; esac",
            "timeout": 10,
            "statusMessage": "Checking shared-root git guard"
          }
        ]
      }
    ]
  }
}
