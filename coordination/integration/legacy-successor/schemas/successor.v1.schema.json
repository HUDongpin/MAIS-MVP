{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mais:legacy-successor:successor:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "relation",
    "manifest",
    "evidenceCommit",
    "historicalManifest",
    "historicalReceipt",
    "candidateChanged",
    "checkerChanged",
    "baselineOnly",
    "liveAllowed"
  ],
  "properties": {
    "schemaVersion": {
      "const": "promotion-legacy-successor-descriptor.v1"
    },
    "relation": {
      "const": "immutable-content-successor"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rawSha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "rawSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidenceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "historicalManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rawSha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "rawSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "historicalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rawSha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "rawSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "candidateChanged": {
      "const": true
    },
    "checkerChanged": {
      "const": true
    },
    "baselineOnly": {
      "const": false
    },
    "liveAllowed": {
      "const": false
    }
  }
}
