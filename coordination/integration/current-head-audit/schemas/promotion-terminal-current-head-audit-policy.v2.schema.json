{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.local/schemas/promotion-terminal-current-head-audit-policy.v2.schema.json",
  "title": "Promotion Terminal Current-HEAD Audit Policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "gateId",
    "pilotUnitId",
    "attemptId",
    "candidateDigest",
    "sourceCommit",
    "targetBaselineCommit",
    "checkerVersion",
    "terminalArtifacts",
    "auditContract",
    "authorizations",
    "liveAllowed",
    "maturityClaim",
    "policyDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "promotion-terminal-current-head-audit-policy.v2" },
    "policyId": { "const": "us-ca-math-rag-v2-g6-ratios-v1-attempt-001-terminal-current-head-audit-v2" },
    "gateId": { "const": "promotion-gate-shadow-v1" },
    "pilotUnitId": { "const": "us-ca-math-rag-v2-g6-ratios-v1" },
    "attemptId": { "const": "attempt-001" },
    "candidateDigest": { "$ref": "#/$defs/sha256" },
    "sourceCommit": { "$ref": "#/$defs/commit" },
    "targetBaselineCommit": { "$ref": "#/$defs/commit" },
    "checkerVersion": { "const": "promotion-gate-shadow-v1" },
    "terminalArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "evidenceIndex",
        "canonicalReceipt",
        "independentReceipt",
        "a18Authority",
        "a23Authority",
        "disposition",
        "registry",
        "a11Postrun",
        "a22Postrun"
      ],
      "properties": {
        "manifest": { "$ref": "#/$defs/artifact" },
        "evidenceIndex": { "$ref": "#/$defs/artifact" },
        "canonicalReceipt": { "$ref": "#/$defs/artifact" },
        "independentReceipt": { "$ref": "#/$defs/artifact" },
        "a18Authority": { "$ref": "#/$defs/artifact" },
        "a23Authority": { "$ref": "#/$defs/artifact" },
        "disposition": { "$ref": "#/$defs/artifact" },
        "registry": { "$ref": "#/$defs/artifact" },
        "a11Postrun": { "$ref": "#/$defs/artifact" },
        "a22Postrun": { "$ref": "#/$defs/artifact" }
      }
    },
    "auditContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "ledgerPath",
        "bundleAlgorithm",
        "frozenCoreBundleDigest"
      ],
      "properties": {
        "version": { "const": "promotion-terminal-current-head-audit-v2" },
        "ledgerPath": { "const": "coordination/integration/current-head-audit/promotion-terminal-audit-releases.v2.json" },
        "bundleAlgorithm": { "const": "sha256-stable-json-path-raw-v1" },
        "frozenCoreBundleDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditAllowed",
        "shadowRetryAllowed",
        "integrationAllowed",
        "liveAllowed",
        "previewAllowed",
        "deployAllowed"
      ],
      "properties": {
        "auditAllowed": { "const": true },
        "shadowRetryAllowed": { "const": false },
        "integrationAllowed": { "const": false },
        "liveAllowed": { "const": false },
        "previewAllowed": { "const": false },
        "deployAllowed": { "const": false }
      }
    },
    "liveAllowed": { "const": false },
    "maturityClaim": { "const": "not-shadow-mature" },
    "policyDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rawSha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "rawSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
