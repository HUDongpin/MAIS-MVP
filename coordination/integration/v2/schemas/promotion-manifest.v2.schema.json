{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.example/schemas/promotion-manifest.v2.schema.json",
  "title": "Promotion Gate Shadow manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gateId",
    "pilotUnitId",
    "attemptId",
    "mode",
    "checkerVersion",
    "checkerRelease",
    "parentPackage",
    "candidatePackage",
    "sourceCommit",
    "targetBaselineCommit",
    "candidateArtifacts",
    "candidateDigest",
    "accessPolicy",
    "requiredOwners",
    "evidenceIndex",
    "evidenceBindings",
    "allowlistedCheckIds",
    "legacyResolution",
    "liveReachability",
    "lifecycle",
    "operationPlan",
    "authorizations",
    "knownBlockers"
  ],
  "properties": {
    "schemaVersion": { "const": "promotion-manifest.v2" },
    "gateId": { "const": "promotion-shadow-gate-v2" },
    "pilotUnitId": { "const": "us-ca-math-rag-v2-g6-ratios-v2" },
    "attemptId": { "const": "attempt-005" },
    "mode": { "const": "shadow" },
    "checkerVersion": { "const": "promotion-gate-shadow-v2.4" },
    "checkerRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledgerPath", "ledgerRawSha256", "version", "bundleAlgorithm", "bundleDigest", "releaseCommit"],
      "properties": {
        "ledgerPath": { "$ref": "#/$defs/path" },
        "ledgerRawSha256": { "$ref": "#/$defs/sha256" },
        "version": { "const": "promotion-gate-shadow-v2.4" },
        "bundleAlgorithm": { "const": "sha256-stable-json-path-raw-v2" },
        "bundleDigest": { "$ref": "#/$defs/sha256" },
        "releaseCommit": { "$ref": "#/$defs/commit" }
      }
    },
    "parentPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "const": "us-ca-math-rag-v2-candidate" },
        "status": { "const": "candidate-only" }
      }
    },
    "candidatePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "rawSha256", "status"],
      "properties": {
        "id": { "const": "us-ca-math-rag-v2-g6-ratios-v2-candidate" },
        "version": { "const": "2.0.0-shadow.1" },
        "path": { "$ref": "#/$defs/path" },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "status": { "const": "candidate-only" }
      }
    },
    "sourceCommit": { "$ref": "#/$defs/commit" },
    "targetBaselineCommit": { "$ref": "#/$defs/commit" },
    "candidateArtifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "candidateDigest": { "$ref": "#/$defs/sha256" },
    "accessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readPaths", "forbiddenModifyPaths", "tempWritePolicy", "forbiddenCapabilities"],
      "properties": {
        "readPaths": { "type": "array", "items": { "$ref": "#/$defs/path" }, "minItems": 1, "uniqueItems": true },
        "forbiddenModifyPaths": { "type": "array", "items": { "$ref": "#/$defs/path" }, "minItems": 1, "uniqueItems": true },
        "tempWritePolicy": { "const": "new-os-temp-root-outside-repository-only" },
        "forbiddenCapabilities": {
          "const": ["database-write", "deployment", "live-registry-write", "network", "production-write", "provider", "vercel"]
        }
      }
    },
    "requiredOwners": {
      "const": ["A21", "A18", "A23", "A04", "A05", "A11", "A22", "A24", "A25"]
    },
    "evidenceIndex": { "$ref": "#/$defs/fileBinding" },
    "evidenceBindings": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/evidenceBinding" }
    },
    "allowlistedCheckIds": {
      "const": [
        "candidate-binding-v2",
        "git-baseline-v2",
        "owner-evidence-v2",
        "content-qa-v2",
        "shadow-adapter-v2",
        "live-unreachable-v2",
        "legacy-drift-ratchet-v2",
        "source-immutability-v2",
        "output-isolation-v2",
        "rollback-rehearsal-v2",
        "external-side-effects-v2",
        "state-transition-v2",
        "semantic-stability-v2"
      ]
    },
    "legacyResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryPath", "rawSha256"],
      "properties": {
        "registryPath": { "$ref": "#/$defs/path" },
        "rawSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "liveReachability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibilityManifestPath", "compatibilityManifestRawSha256", "expectedRuntimePolicy"],
      "properties": {
        "compatibilityManifestPath": { "$ref": "#/$defs/path" },
        "compatibilityManifestRawSha256": { "$ref": "#/$defs/sha256" },
        "expectedRuntimePolicy": { "type": "object" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priorState", "currentState", "requestedState", "failureStates"],
      "properties": {
        "priorState": { "const": "candidate_hold" },
        "currentState": { "const": "shadow_ready" },
        "requestedState": { "const": "shadow_passed" },
        "failureStates": { "const": ["repair_required", "rejected"] }
      }
    },
    "operationPlan": { "type": "object" },
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shadowAllowed", "integrationAllowed", "liveAllowed", "previewAllowed", "deployAllowed"],
      "properties": {
        "shadowAllowed": { "const": true },
        "integrationAllowed": { "const": false },
        "liveAllowed": { "const": false },
        "previewAllowed": { "const": false },
        "deployAllowed": { "const": false }
      }
    },
    "knownBlockers": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000)[^\\\\]+$"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rawSha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "rawSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "path", "rawFileSha256", "recordSha256"],
      "properties": {
        "kind": { "enum": ["safe-card", "practice", "lesson"] },
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/path" },
        "rawFileSha256": { "$ref": "#/$defs/sha256" },
        "recordSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "evidenceId", "evidencePath", "rawSha256", "semanticDigest", "reviewedCommit", "expectedResult", "currentness"],
      "properties": {
        "role": { "enum": ["A21", "A18", "A23", "A04", "A05", "A11", "A22", "A24", "A25"] },
        "evidenceId": { "type": "string", "minLength": 1 },
        "evidencePath": { "$ref": "#/$defs/path" },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "semanticDigest": { "$ref": "#/$defs/sha256" },
        "reviewedCommit": { "$ref": "#/$defs/commit" },
        "expectedResult": { "enum": ["pass", "not_applicable"] },
        "currentness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidateDigest", "sourceCommit", "targetBaselineCommit", "checkerVersion"],
          "properties": {
            "candidateDigest": { "$ref": "#/$defs/sha256" },
            "sourceCommit": { "$ref": "#/$defs/commit" },
            "targetBaselineCommit": { "$ref": "#/$defs/commit" },
            "checkerVersion": { "const": "promotion-gate-shadow-v2.4" }
          }
        }
      }
    }
  }
}
