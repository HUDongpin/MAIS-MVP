      "promptZhHans": "已知分式 \\(\\frac{2x^2 - 8}{x^2 - x - 6}\\)。\n(1) 求该分式有意义的 x 的取值范围；\n(2) 将该分式化为最简分式；\n(3) 当 x = 4 时，求该分式的值。",
      "optionsZhHans": [],
      "answer": "(1) x ≠ 3 且 x ≠ -2；(2) \\(\\frac{2(x-2)}{x-3}\\)；(3) 4",
      "acceptedAnswers": [
        "(1) x ≠ 3 且 x ≠ -2；(2) \\(\\frac{2(x-2)}{x-3}\\)；(3) 4",
        "(1) x≠3且x≠-2；(2) 2(x-2)/(x-3)；(3) 4"
      ],
      "explanationZhHans": "(1) 分母 x²-x-6=(x-3)(x+2)≠0，得 x≠3 且 x≠-2。(2) 分子 2(x²-4)=2(x+2)(x-2)，约去公因式 (x+2) 得 2(x-2)/(x-3)。(3) 代入 x=4，得 2(4-2)/(4-3)=4，符合限制。"
    },
