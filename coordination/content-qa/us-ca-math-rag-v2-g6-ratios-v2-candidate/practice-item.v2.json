  "prompt": {
    "en": "A recipe uses 3 cups of oats for every 5 cups of fruit. If a batch uses 20 cups of fruit, how many cups of oats are needed?"
  },
  "answer": "12 cups",
  "acceptedAnswers": [
    "12",
    "12 cups"
  ],
  "acceptedAnswerPolicy": "exact-trimmed-forms-v2",
  "solutionSteps": [
    "Keep the ratio order as 3 cups of oats for 5 cups of fruit.",
    "Compute the scale factor: 20 ÷ 5 = 4.",
    "Scale the oats by the same factor: 3 × 4 = 12.",
    "Therefore, 12 cups of oats are needed."
  ],
  "misconceptionFeedback": {
    "ratio order reversed": {
      "en": "Label both quantities before scaling: 3 is the oats amount and 5 is the fruit amount."
    },
    "unit rate not normalized": {
      "en": "Find how many groups of 5 fruit cups fit into 20, then apply that same factor to the oats."
    }
  },
