});

test("retained source manifests are physically hashed, byte-identical, current, and independently pinned", async (t) => {
  const {
    captureSourceManifest,
    validateRetainedSourceManifests
  } = await import(runnerPath);
  const workspaceRoot = process.cwd();
  const runRoot = join(
    workspaceRoot,
    ".tmp",
    `hk-question-bank-source-manifest-receipt-test-${process.pid}`
  );
  const sourcePrePath = join(runRoot, "source-pre.json");
  const sourcePostPath = join(runRoot, "source-post.json");
  t.after(() => rm(runRoot, { recursive: true, force: true }));
  await rm(runRoot, { recursive: true, force: true });
  await mkdir(runRoot, { recursive: true });
  const sourceManifest = await captureSourceManifest(workspaceRoot);
  const sourceBytes = fixtureJsonBytes(sourceManifest);
  await Promise.all([
    writeFile(sourcePrePath, sourceBytes),
    writeFile(sourcePostPath, sourceBytes)
  ]);
  const sourceReceipt = {
    preAggregateSha256: sourceManifest.aggregateSha256,
    postAggregateSha256: sourceManifest.aggregateSha256,
    preManifestFileSha256: fixtureSha256(sourceBytes),
    postManifestFileSha256: fixtureSha256(sourceBytes),
    unchanged: true
  };
  const validated = await validateRetainedSourceManifests({
    workspaceRoot,
    sourcePrePath,
    sourcePostPath,
    sourceReceipt
  });
  assert.deepEqual(validated.sourcePre, sourceManifest);
  assert.deepEqual(validated.sourcePost, sourceManifest);
  assert.deepEqual(validated.currentSource, sourceManifest);
  assert.equal(validated.reviewedSourceBindings.length > 20, true);

  await rm(sourcePrePath);
  await assert.rejects(
    () =>
      validateRetainedSourceManifests({
        workspaceRoot,
        sourcePrePath,
        sourcePostPath,
        sourceReceipt
      }),
    /retained source manifest physical read failed/
  );
  await writeFile(sourcePrePath, sourceBytes);

  const reformattedPostBytes = Buffer.concat([sourceBytes, Buffer.from("\n")]);
  await writeFile(sourcePostPath, reformattedPostBytes);
  await assert.rejects(
    () =>
      validateRetainedSourceManifests({
        workspaceRoot,
        sourcePrePath,
        sourcePostPath,
        sourceReceipt: {
          ...sourceReceipt,
          postManifestFileSha256: fixtureSha256(reformattedPostBytes)
        }
      }),
    /retained source manifest bytes differ/
  );

  const mutatedManifest = structuredClone(sourceManifest);
  const reviewedTestEntry = mutatedManifest.entries.find(
    (entry) => entry.path === "lib/practiceFigureAudit.test.ts"
  );
  assert.ok(reviewedTestEntry);
  reviewedTestEntry.sha256 = "f".repeat(64);
  mutatedManifest.aggregateSha256 = fixtureSourceManifestAggregate(mutatedManifest.entries);
  const mutatedBytes = fixtureJsonBytes(mutatedManifest);
  await Promise.all([
    writeFile(sourcePrePath, mutatedBytes),
    writeFile(sourcePostPath, mutatedBytes)
  ]);
  await assert.rejects(
    () =>
      validateRetainedSourceManifests({
        workspaceRoot,
        sourcePrePath,
        sourcePostPath,
        sourceReceipt: {
          preAggregateSha256: mutatedManifest.aggregateSha256,
          postAggregateSha256: mutatedManifest.aggregateSha256,
          preManifestFileSha256: fixtureSha256(mutatedBytes),
          postManifestFileSha256: fixtureSha256(mutatedBytes),
          unchanged: true
        }
      }),
    /independent reviewed source|current source manifest differs/
  );
});

test("terminal PASS can only be minted after lock release from a durably sealed VALIDATED receipt", async (t) => {
  const { writePostReleaseTerminalReceipt } = await import(runnerPath);
  const workspaceRoot = process.cwd();
  const runId = `terminal-receipt-fixture-${process.pid}`;
  const runRoot = join(workspaceRoot, ".tmp", "hk-question-bank-evidence-runs", runId);
  const lockPath = join(workspaceRoot, ".tmp", `terminal-receipt-lock-fixture-${process.pid}`);
  const outerReceiptPath = join(runRoot, "outer-exit-receipt.json");
  const outerReceiptShaPath = join(runRoot, "outer-exit-receipt.sha256");
  const terminalReceiptPath = join(runRoot, "terminal-receipt.json");
  const terminalReceiptShaPath = join(runRoot, "terminal-receipt.sha256");
  t.after(() => rm(runRoot, { recursive: true, force: true }));
  t.after(() => rm(lockPath, { recursive: true, force: true }));
  await rm(runRoot, { recursive: true, force: true });
  await rm(lockPath, { recursive: true, force: true });
  await mkdir(runRoot, { recursive: true });
  const sealedReceipt = {
    schemaVersion: "hk-question-bank-outer-exit-receipt-v3",
    status: "VALIDATED",
    exitCode: null,
    workspaceRoot,
    runId,
    runRoot,
    validation: {
      schemaVersion: "hk-question-bank-outer-validation-v1",
      completed: true,
      completedAt: "2026-08-14T00:00:00.000Z"
    },
    lock: {
      path: lockPath,
      acquired: true,
      released: false
    },
    paths: {
      outerReceiptPath,
      outerReceiptShaPath,
      terminalReceiptPath,
      terminalReceiptShaPath
    }
  };
  const writeSeal = async (receipt) => {
    const bytes = fixtureJsonBytes(receipt);
    await writeFile(outerReceiptPath, bytes);
    await writeFile(
      outerReceiptShaPath,
      `${fixtureSha256(bytes)}  outer-exit-receipt.json\n`
    );
    return bytes;
  };

  await writeSeal({
    ...sealedReceipt,
    status: "VALIDATION_PENDING",
    validation: { ...sealedReceipt.validation, completed: false }
  });
  await assert.rejects(
    () =>
      writePostReleaseTerminalReceipt({
        sealedOuterReceiptPath: outerReceiptPath,
        sealedOuterReceiptShaPath: outerReceiptShaPath,
        terminalReceiptPath,
        terminalReceiptShaPath,
        lockPath
      }),
    /sealed outer receipt is not independently validated/
  );

  await writeSeal(sealedReceipt);
  await mkdir(lockPath);
  await assert.rejects(
    () =>
      writePostReleaseTerminalReceipt({
        sealedOuterReceiptPath: outerReceiptPath,
        sealedOuterReceiptShaPath: outerReceiptShaPath,
        terminalReceiptPath,
        terminalReceiptShaPath,
        lockPath
      }),
    /canonical lock still exists/
  );
  await rm(lockPath, { recursive: true, force: false });

  const terminal = await writePostReleaseTerminalReceipt({
    sealedOuterReceiptPath: outerReceiptPath,
    sealedOuterReceiptShaPath: outerReceiptShaPath,
    terminalReceiptPath,
    terminalReceiptShaPath,
    lockPath
  });
  assert.equal(terminal.status, "PASS");
  assert.equal(terminal.exitCode, 0);
  assert.equal(terminal.validationCompleted, true);
  assert.equal(terminal.lockReleased, true);
  assert.equal(terminal.sealedOuterReceipt.status, "VALIDATED");
  const terminalBytes = await readFile(terminalReceiptPath);
  assert.deepEqual(JSON.parse(terminalBytes.toString("utf8")), terminal);
  assert.equal(
    await readFile(terminalReceiptShaPath, "utf8"),
    `${fixtureSha256(terminalBytes)}  terminal-receipt.json\n`
  );
});

test("outer validation candidate physically rehashes source, process, TAP, and complete verification receipts", async (t) => {
  const {
    EXECUTING_RUNNER_BINDING,
    bindIndependentReviewedSourceArtifacts,
    buildCanonicalMutableEnvironment,
    captureSourceManifest,
    capturePhysicalToolchainBinding,
    childEnvironmentWithCanonicalMutablePaths,
    loadCanonicalDirectTestBinding,
    loadCanonicalFocusedLedgerBindings,
    verifyCompleteTapLedgerAndArtifacts,
    validateCompletedOuterReceipt
  } = await import(runnerPath);
  const workspaceRoot = process.cwd();
  const runId = `receipt-fixture-${process.pid}`;
  const runRoot = join(workspaceRoot, ".tmp", "hk-question-bank-evidence-runs", runId);
  t.after(() => rm(runRoot, { recursive: true, force: true }));
  await rm(runRoot, { recursive: true, force: true });
  const paths = {
    compiledRoot: join(runRoot, "compiled"),
    tmpRoot: join(runRoot, "tmp"),
    dbRoot: join(runRoot, "db"),
    logsRoot: join(runRoot, "logs"),
    processReceiptPath: join(runRoot, "process-receipt.json"),
    sourcePrePath: join(runRoot, "source-pre.json"),
    sourcePostPath: join(runRoot, "source-post.json"),
    completeVerificationPath: join(runRoot, "complete-test-ledger-verification.json"),
    outerReceiptPath: join(runRoot, "outer-exit-receipt.json"),
    outerReceiptShaPath: join(runRoot, "outer-exit-receipt.sha256"),
    terminalReceiptPath: join(runRoot, "terminal-receipt.json"),
    terminalReceiptShaPath: join(runRoot, "terminal-receipt.sha256")
  };
  await mkdir(paths.logsRoot, { recursive: true });
  const mutableEnvironment = buildCanonicalMutableEnvironment({
    runRoot,
    tmpRoot: paths.tmpRoot,
    dbRoot: paths.dbRoot
  });
  const childEnvironment = childEnvironmentWithCanonicalMutablePaths(
    {
      NODE_OPTIONS: "--require=/tmp/must-not-survive.cjs",
      NODE_PATH: "/tmp/must-not-survive"
    },
    mutableEnvironment
  );
  const physicalToolchain = await capturePhysicalToolchainBinding(workspaceRoot);
  const sourceManifest = await captureSourceManifest(workspaceRoot);
  const sourceManifestBytes = fixtureJsonBytes(sourceManifest);
  const reviewedSourceBindings = await bindIndependentReviewedSourceArtifacts({
    workspaceRoot,
    sourcePre: sourceManifest,
    sourcePost: sourceManifest,
    currentSource: sourceManifest
  });
  const focusedLedgerBindings = await loadCanonicalFocusedLedgerBindings(workspaceRoot);
  const directTestBinding = await loadCanonicalDirectTestBinding(workspaceRoot);
  const expectedNames = [
    ...directTestBinding.expectedNames,
    ...focusedLedgerBindings.flatMap((binding) => binding.expectedNames)
  ];
  const tap = [
    "TAP version 13",
    ...expectedNames.map((name, index) => `ok ${index + 1} - ${name}`),
    `1..${expectedNames.length}`,
    `# tests ${expectedNames.length}`,
    `# pass ${expectedNames.length}`,
    "# fail 0",
    "# cancelled 0",
    "# skipped 0",
    "# todo 0"
  ].join("\n");
  const completeVerification = verifyCompleteTapLedgerAndArtifacts({
    tap,
    focusedLedgerBindings,
    directTestBinding,
    artifactBasenames: ["compile.log", "test-question-bank.tap"]
  });
  const compileArgs = [
    "-p",
    "tsconfig.json",
    "--outDir",
    paths.compiledRoot,
    "--noEmit",
    "false",
    "--incremental",
    "false",
    "--module",
    "commonjs",
    "--moduleResolution",
    "node"
  ];
  const processReceipt = {
    schemaVersion: "hk-question-bank-process-receipt-v3",
    wrapper: {
      pid: 4242,
      ppid: 1,
      execPath: process.execPath,
      argv: [process.execPath, new URL(runnerPath).pathname],
      cwd: workspaceRoot,
      nodeVersion: process.version
    },
    processes: [
      {
        label: "typescript-compile",
        pid: 4243,
        ppid: 4242,
        executable: join(workspaceRoot, "node_modules", ".bin", "tsc"),
        args: compileArgs,
        cwd: workspaceRoot,
        startedAt: "2026-08-13T00:00:00.000Z",
        exitedAt: "2026-08-13T00:01:00.000Z",
        deadlineAt: "2026-08-13T00:15:00.000Z",
        exitCode: 0,
        signal: null,
        logPath: join(paths.logsRoot, "compile.log"),
        processGroupId: 4243,
        processGroupAbsent: true,
        processGroupAbsenceCheckedAt: "2026-08-13T00:01:00.000Z",
        unexpectedGroupSurvivor: false,
        timeoutMs: 900000,
        terminationGraceMs: 5000,
        timedOut: false,
        aborted: false,
        abortReason: null,
        terminationSignals: [],
        environment: childEnvironment
      },
      {
        label: "canonical-question-bank-tests",
        pid: 4244,
        ppid: 4242,
        executable: process.execPath,
        args: [
          "--test",
          "--test-reporter=tap",
          ...directTestBinding.compiledEntries.map((entry) => join(paths.compiledRoot, entry))
        ],
        cwd: workspaceRoot,
        startedAt: "2026-08-13T00:01:00.000Z",
        exitedAt: "2026-08-13T00:02:00.000Z",
        deadlineAt: "2026-08-13T00:16:00.000Z",
        exitCode: 0,
        signal: null,
        logPath: join(paths.logsRoot, "test-question-bank.tap"),
        processGroupId: 4244,
        processGroupAbsent: true,
        processGroupAbsenceCheckedAt: "2026-08-13T00:02:00.000Z",
        unexpectedGroupSurvivor: false,
        timeoutMs: 900000,
        terminationGraceMs: 5000,
        timedOut: false,
        aborted: false,
        abortReason: null,
        terminationSignals: [],
        environment: childEnvironment
      }
    ]
  };
  const processReceiptBytes = fixtureJsonBytes(processReceipt);
  const completeVerificationBytes = fixtureJsonBytes(completeVerification);
  const tapBytes = Buffer.from(tap, "utf8");
  await Promise.all([
    writeFile(join(paths.logsRoot, "compile.log"), ""),
    writeFile(join(paths.logsRoot, "test-question-bank.tap"), tapBytes),
    writeFile(paths.processReceiptPath, processReceiptBytes),
    writeFile(paths.completeVerificationPath, completeVerificationBytes),
    writeFile(paths.sourcePrePath, sourceManifestBytes),
    writeFile(paths.sourcePostPath, sourceManifestBytes)
  ]);
  const valid = {
    schemaVersion: "hk-question-bank-outer-exit-receipt-v3",
    status: "VALIDATION_PENDING",
    exitCode: null,
    completedAt: "2026-08-13T00:00:00.000Z",
    workspaceRoot,
    runId,
    runRoot,
    uniqueRunRoot: true,
    paths,
    mutableEnvironment,
    childEnvironment,
    executingRunnerBinding: EXECUTING_RUNNER_BINDING,
    physicalToolchain: {
      pre: physicalToolchain,
      postAggregateSha256: physicalToolchain.aggregateSha256,
      unchanged: true
    },
    reviewedSourceBindings,
    lock: {
      path: join(workspaceRoot, ".tmp", "hk-question-bank-evidence.lock"),
      ownerPid: 4242,
      acquired: true,
      released: false
    },
    cleanup: {
      ephemeralPaths: [paths.compiledRoot, paths.dbRoot, paths.tmpRoot],
      completed: true,
      errors: []
    },
    source: {
      preAggregateSha256: sourceManifest.aggregateSha256,
      postAggregateSha256: sourceManifest.aggregateSha256,
      preManifestFileSha256: fixtureSha256(sourceManifestBytes),
      postManifestFileSha256: fixtureSha256(sourceManifestBytes),
      unchanged: true
    },
    focusedLedgers: [
      {
        ledgerId: "displayed74-exact57",
        relativePath:
          "coordination/content-qa/authoritative/2026-08-13-hk-displayed74-focused-test-ledger.json",
        fileSha256: "c676acf3931e4a59761cfc4f7249ebd7546fa144854c8ae89fdb59c4562e12fc",
        testNameSha256: "3f0ec176d5c3ecdd216a1eaeb9d7fd3bda9a716796b9f28bf6b8f99529a386fd",
        expectedFocusedTestCount: 57
      },
      {
        ledgerId: "residual47-exact10",
        relativePath:
          "coordination/content-qa/authoritative/2026-08-13-hk-residual47-focused-test-ledger.json",
        fileSha256: "8ecfc6570714daa6d35e1c9d1a1f5bee92a0b0b60b3230408e3f9acaaebb12c0",
        testNameSha256: "d89c4aee3a620ecf6c5ff150b4b29def12b5f53107b41a1478c2cfa2a6437bfd",
        expectedFocusedTestCount: 10
      },
      {
        ledgerId: "ease-response-exact7",
        relativePath:
          "coordination/content-qa/authoritative/2026-08-13-hk-ease-response-focused-test-ledger.json",
        fileSha256: "ca64cfd9403206ec5094d170c97f31a2556351e17b6beed7cbdcd11f64dcbe91",
        testNameSha256: "38d338428107012f5813a051e84afec2c04e8b0a048e54186b419a7475db8b1a",
        expectedFocusedTestCount: 7
      }
    ],
    canonicalDirectTests: {
      expectedDirectTestCount: 142,
      testNameSha256: "8bdc6c236279a80a07b4699ae284ef9d954af06d64560410629a3d91035b58f5",
      sourceFiles: directTestBinding.sourceFiles.map((sourceFile) => ({
        sourcePath: sourceFile.sourcePath,
        bytes: sourceFile.bytes,
        sha256: sourceFile.sha256,
        expectedTestCount: sourceFile.expectedTestCount
      }))
    },
    processReceipt: {
      path: paths.processReceiptPath,
      sha256: fixtureSha256(processReceiptBytes)
    },
    tap: {
      expectedTotalTestCount: 216,
      tests: 216,
      pass: 216,
      fail: 0,
      cancelled: 0,
      skipped: 0,
      todo: 0,
      completeVerificationFileSha256: fixtureSha256(completeVerificationBytes),
      tapLogSha256: fixtureSha256(tapBytes)
    },
    artifactPolicy: {
      allowedLogBasenames: ["compile.log", "test-question-bank.tap"],
      forbiddenStaleBasename: "test-question-bank.log",
      staleArtifactConsumed: false,
      authoritativeRunRoot: runRoot,
      supersessionRule:
        "Only authoritativeRunRoot may support this receipt; every other HK question-bank or residual28 evidence root is diagnostic and superseded."
    },
    validation: {
      schemaVersion: "hk-question-bank-outer-validation-v1",
      completed: false,
      completedAt: null
    }
  };
  const validation = await validateCompletedOuterReceipt(valid);
  assert.equal(validation.completed, true);
  assert.equal(validation.reviewedSourceAuthorityCount, reviewedSourceBindings.length);
  for (const invalid of [
    { ...valid, exitCode: 1 },
    { ...valid, lock: { ...valid.lock, released: true } },
    { ...valid, cleanup: { completed: false, errors: ["x"] } },
    { ...valid, source: { ...valid.source, unchanged: false } },
    { ...valid, source: { ...valid.source, preAggregateSha256: undefined } },
    { ...valid, source: { ...valid.source, postManifestFileSha256: undefined } },
    { ...valid, source: { ...valid.source, postManifestFileSha256: "c".repeat(64) } },
    {
      ...valid,
      executingRunnerBinding: {
        ...valid.executingRunnerBinding,
        sha256: "f".repeat(64)
      }
    },
    {
      ...valid,
      physicalToolchain: {
        ...valid.physicalToolchain,
        postAggregateSha256: "f".repeat(64)
      }
    },
    { ...valid, reviewedSourceBindings: valid.reviewedSourceBindings.slice(1) },
    {
      ...valid,
      mutableEnvironment: {
        ...valid.mutableEnvironment,
        values: { ...valid.mutableEnvironment.values, TMP: "/tmp" }
      }
    },
    {
      ...valid,
      focusedLedgers: valid.focusedLedgers.map((ledger, index) =>
        index === 1 ? { ...ledger, fileSha256: "d".repeat(64) } : ledger
      )
    },
    { ...valid, processReceipt: { sha256: null } },
    {
      ...valid,
      canonicalDirectTests: { ...valid.canonicalDirectTests, expectedDirectTestCount: 105 }
    },
    {
      ...valid,
      canonicalDirectTests: { ...valid.canonicalDirectTests, testNameSha256: "f".repeat(64) }
    },
    { ...valid, tap: { ...valid.tap, pass: 179 } },
    { ...valid, artifactPolicy: { ...valid.artifactPolicy, staleArtifactConsumed: true } },
    {
      ...valid,
      artifactPolicy: { ...valid.artifactPolicy, authoritativeRunRoot: `${runRoot}-other` }
    }
  ]) {
    await assert.rejects(
      () => validateCompletedOuterReceipt(invalid),
      /outer validation candidate invariant failed/
    );
  }

  await assert.rejects(
    () =>
      validateCompletedOuterReceipt({
        ...valid,
        processReceipt: { ...valid.processReceipt, sha256: "e".repeat(64) }
      }),
    /process receipt SHA-256 mismatch/
  );
  const forgedProcessReceipt = structuredClone(processReceipt);
  forgedProcessReceipt.processes[0].exitCode = 1;
  const forgedProcessReceiptBytes = fixtureJsonBytes(forgedProcessReceipt);
  await writeFile(paths.processReceiptPath, forgedProcessReceiptBytes);
  await assert.rejects(
    () =>
      validateCompletedOuterReceipt({
        ...valid,
        processReceipt: {
          ...valid.processReceipt,
          sha256: fixtureSha256(forgedProcessReceiptBytes)
        }
      }),
    /process receipt semantic mismatch/
  );
  await writeFile(paths.processReceiptPath, processReceiptBytes);

  const planlessTapBytes = Buffer.from(tap.replace(`\n1..${expectedNames.length}`, ""), "utf8");
  await writeFile(join(paths.logsRoot, "test-question-bank.tap"), planlessTapBytes);
  await assert.rejects(
    () =>
      validateCompletedOuterReceipt({
        ...valid,
        tap: { ...valid.tap, tapLogSha256: fixtureSha256(planlessTapBytes) }
      }),
    /canonical root TAP/
  );
  await writeFile(join(paths.logsRoot, "test-question-bank.tap"), tapBytes);

  const forgedCompleteVerification = {
    ...completeVerification,
    observedTotalTestCount: completeVerification.observedTotalTestCount - 1
  };
  const forgedCompleteVerificationBytes = fixtureJsonBytes(forgedCompleteVerification);
  await writeFile(paths.completeVerificationPath, forgedCompleteVerificationBytes);
  await assert.rejects(
    () =>
      validateCompletedOuterReceipt({
        ...valid,
        tap: {
          ...valid.tap,
          completeVerificationFileSha256: fixtureSha256(forgedCompleteVerificationBytes)
        }
      }),
    /complete verification semantic mismatch/
  );
  await rm(runRoot, { recursive: true, force: true });
});
