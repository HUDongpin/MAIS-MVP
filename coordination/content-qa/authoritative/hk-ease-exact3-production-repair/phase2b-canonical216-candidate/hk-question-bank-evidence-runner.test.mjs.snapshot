    mkdir(compiledRoot),
    mkdir(dbRoot),
    mkdir(tmpRoot)
  ]);
  const cleanup = await cleanupEphemeralRunPaths(runRoot, [compiledRoot, dbRoot, tmpRoot]);
  assert.deepEqual(cleanup.errors, []);
