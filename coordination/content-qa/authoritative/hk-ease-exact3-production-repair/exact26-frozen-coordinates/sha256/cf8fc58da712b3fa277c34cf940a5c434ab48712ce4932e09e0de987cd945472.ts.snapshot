test("v4 row389 HCF-only evidence stops at gcd one and omits unrelated LCM fields", () => {
  const generated = buildHongKongEaseV4DerivationSupplement(
    sanitizedInputJson as HongKongEaseV4SanitizedInput
  );
  const row = generated.rows[389];
  const evidence = shortDivisionProductEvidenceForTest(row);

  assert.equal(row.baseId, "hk-ease-1102");
  assert.ok(evidence);
  assert.equal(evidence.trace.every((entry) => entry.dividesEveryCurrentValue), true);
  assert.deepEqual(evidence.products.commonDivisors, ["2", "2", "7"]);
  assert.equal(evidence.products.hcfProduct.expression, "2 × 2 × 7");
  assert.equal(evidence.products.hcfProduct.value, "28");
  assert.deepEqual(Object.keys(evidence.products).sort(), ["commonDivisors", "hcfProduct"]);
  assert.equal(evidence.products.allDivisors, undefined);
  assert.equal(evidence.products.lcmProduct, undefined);
});

test("v4 exact 14 short-division product rows have correct HCF and only the 10 LCM-request rows carry correct LCM", () => {
  const sanitized = sanitizedInputJson as HongKongEaseV4SanitizedInput;
  const generated = buildHongKongEaseV4DerivationSupplement(sanitized);
  let productRowCount = 0;
  let hcfOnlyRowCount = 0;
  let lcmRequestRowCount = 0;

  for (const row of generated.rows) {
    const evidence = shortDivisionProductEvidenceForTest(row);
    if (!evidence) continue;
    productRowCount += 1;
    assert.ok(evidence.trace.length > 0, `${row.baseId}: missing short-division trace`);
    const initialValues = evidence.trace[0].before.map(BigInt);
    const expectedGcd = exactTestGcd(...initialValues).toString();
    const { products } = evidence;

    assert.equal(products.hcfProduct.expression, products.commonDivisors.join(" × "), `${row.baseId}: HCF expression/factors drift`);
    assert.equal(exactTestProduct(products.commonDivisors).toString(), products.hcfProduct.value, `${row.baseId}: HCF expression product drift`);
    assert.equal(products.hcfProduct.value, expectedGcd, `${row.baseId}: HCF product is not gcd(values)`);
    const lcmRequested = /L\.?C\.?M\.?/i.test(sanitized.rows[row.index].prompt.en);
    if (lcmRequested) {
      lcmRequestRowCount += 1;
      assert.deepEqual(Object.keys(products).sort(), ["allDivisors", "commonDivisors", "hcfProduct", "lcmProduct"]);
      assert.ok(products.allDivisors);
      assert.ok(products.lcmProduct);
      assert.equal(products.lcmProduct.expression, products.allDivisors.join(" × "), `${row.baseId}: LCM expression/factors drift`);
      assert.equal(exactTestProduct(products.allDivisors).toString(), products.lcmProduct.value, `${row.baseId}: LCM expression product drift`);
      assert.equal(products.lcmProduct.value, exactTestLcm(...initialValues).toString(), `${row.baseId}: LCM product is not lcm(values)`);
    } else {
      hcfOnlyRowCount += 1;
      assert.deepEqual(Object.keys(products).sort(), ["commonDivisors", "hcfProduct"], `${row.baseId}: HCF-only schema carries unrelated fields`);
      assert.equal(products.allDivisors, undefined);
      assert.equal(products.lcmProduct, undefined);
    }
    const stepSemantic = (evidence.step.output as { semanticValue?: { divisionProducts?: unknown } }).semanticValue;
    if (stepSemantic !== undefined) {
      assert.deepEqual(
        stepSemantic.divisionProducts,
        products,
        `${row.baseId}: step output does not bind the product evidence`
      );
    }
    assert.deepEqual(
      (row.computedResult.semanticValue as { divisionProducts?: unknown }).divisionProducts,
      products,
      `${row.baseId}: computed result does not bind the product evidence`
    );
  }

  assert.equal(productRowCount, 14);
  assert.equal(hcfOnlyRowCount, 4);
  assert.equal(lcmRequestRowCount, 10);
});

test("v4 exact 14 short-division traces and all semantic replicas bind their original typed operands", () => {
  const generated = buildHongKongEaseV4DerivationSupplement(
    sanitizedInputJson as HongKongEaseV4SanitizedInput
  );
  let productRowCount = 0;
  let composedRowCount = 0;
  let domainRowCount = 0;

  for (const row of generated.rows) {
    const evidence = shortDivisionProductEvidenceForTest(row);
    if (!evidence) continue;
    productRowCount += 1;
    if (evidence.step.operation === "compose-structured-response") composedRowCount += 1;
    if (evidence.step.operation === "apply-domain-rule") domainRowCount += 1;
    const expectedOperands = exactTestOperandsBoundToDivisionStep(row, evidence.step);
    assert.deepEqual(evidence.trace[0].before, expectedOperands, `${row.baseId}: trace initial operands drifted`);

    const semanticReplicas = [
      (evidence.step.output as { semanticValue?: Record<string, unknown> }).semanticValue,
      row.computedResult.semanticValue as Record<string, unknown>
    ].filter((semantic): semantic is Record<string, unknown> => semantic !== undefined);
    for (const semantic of semanticReplicas) {
      assert.deepEqual(semantic.shortDivisionTrace, evidence.trace, `${row.baseId}: semantic trace replica drifted`);
      assert.deepEqual(semantic.divisionProducts, evidence.products, `${row.baseId}: semantic products replica drifted`);
      const semanticOperands = semantic.operands ?? semantic.values;
      if (semanticOperands !== undefined) {
        assert.deepEqual(semanticOperands, expectedOperands, `${row.baseId}: semantic operand replica drifted`);
      }
    }
  }

  assert.equal(productRowCount, 14);
  assert.equal(composedRowCount, 6);
  assert.equal(domainRowCount, 8);
});

test("v4 validator rejects exact6 fully rehashed short-division operand transplants with unchanged HCF and LCM", () => {
  const sanitized = sanitizedInputJson as HongKongEaseV4SanitizedInput;
  const generated = buildHongKongEaseV4DerivationSupplement(sanitized);
  const combinedRows = generated.rows.filter((row) =>
    shortDivisionProductEvidenceForTest(row)?.step.operation === "compose-structured-response"
  );
  let rejectedMutationCount = 0;

  assert.equal(combinedRows.length, 6);
  for (const baseline of combinedRows) {
    const supplement = structuredClone(generated);
    const row = supplement.rows[baseline.index];
    const evidence = shortDivisionProductEvidenceForTest(row);
    assert.ok(evidence);
    const originalOperands = evidence.trace[0].before;
    const gcd = exactTestGcd(...originalOperands.map(BigInt)).toString();
    const lcm = exactTestLcm(...originalOperands.map(BigInt)).toString();
    const transplantedOperands = [gcd, lcm, lcm];
    assert.notDeepEqual(transplantedOperands, originalOperands);
    assert.equal(exactTestGcd(...transplantedOperands.map(BigInt)).toString(), gcd);
    assert.equal(exactTestLcm(...transplantedOperands.map(BigInt)).toString(), lcm);

    const transplantedTrace = exactTestCompleteShortDivisionTrace(transplantedOperands);
    const transplantedProducts = exactTestDivisionProducts(transplantedTrace);
    const parameters = evidence.step.parameters as Record<string, unknown>;
    parameters.shortDivisionTrace = transplantedTrace;
    parameters.divisionProducts = transplantedProducts;
    const requirements = parameters.promptRequirements as { components: string[] };
    let responseText = `${exactTestRenderShortDivisionTrace(transplantedTrace)}; H.C.F. = ${gcd}; L.C.M. = ${lcm}`;
    if (requirements.components.includes("common-divisor-product")) {
      responseText += `; H.C.F. product: ${transplantedProducts.hcfProduct.expression} = ${transplantedProducts.hcfProduct.value}`;
    }
    if (requirements.components.includes("all-divisor-product")) {
      responseText += `; L.C.M. product: ${transplantedProducts.lcmProduct!.expression} = ${transplantedProducts.lcmProduct!.value}`;
    }
    (evidence.step.output as { responseText: string }).responseText = responseText;
    row.computedResult.responseText = responseText;
    const semantic = row.computedResult.semanticValue as Record<string, unknown>;
    semantic.operands = transplantedOperands;
    semantic.gcd = gcd;
    semantic.lcm = lcm;
    semantic.factorizations = exactTestFactorizationRecords(transplantedOperands);
    semantic.shortDivisionTrace = transplantedTrace;
    semantic.divisionProducts = transplantedProducts;
    rehashV4Row(row);
    rehashV4Supplement(supplement);

    assert.throws(
      () => validateHongKongEaseV4DerivationSupplement(sanitized, supplement),
      /V4_(?:STEP_INPUT_BINDING_INVALID|STEP_EXECUTION_INVALID|STEP_OUTPUT_INVALID)/,
      `${row.baseId}: a self-consistent trace over unrelated operands must fail closed`
    );
    rejectedMutationCount += 1;
  }

  assert.equal(rejectedMutationCount, 6);
});

test("v4 validator rejects exact6 fully rehashed opaque factorization drift", () => {
  const sanitized = sanitizedInputJson as HongKongEaseV4SanitizedInput;
  const generated = buildHongKongEaseV4DerivationSupplement(sanitized);
  const combinedRows = generated.rows.filter((row) =>
    shortDivisionProductEvidenceForTest(row)?.step.operation === "compose-structured-response"
  );
  let rejectedMutationCount = 0;

  assert.equal(combinedRows.length, 6);
  for (const baseline of combinedRows) {
    const supplement = structuredClone(generated);
    const row = supplement.rows[baseline.index];
    const semantic = row.computedResult.semanticValue as {
      factorizations?: Array<{ value: string; factors: V4TestPrimeFactor[]; rendered: string }>;
    };
    assert.ok(semantic.factorizations?.length);
    semantic.factorizations[0] = exactTestFactorizationRecords(["999"])[0];
    rehashV4Row(row);
    rehashV4Supplement(supplement);

    assert.throws(
      () => validateHongKongEaseV4DerivationSupplement(sanitized, supplement),
      /V4_(?:STEP_INPUT_BINDING_INVALID|STEP_EXECUTION_INVALID|STEP_OUTPUT_INVALID)/,
      `${row.baseId}: an opaque self-consistent factorization of another operand must fail closed`
    );
    rejectedMutationCount += 1;
  }

  assert.equal(rejectedMutationCount, 6);
});

test("v4 validator rejects the four historical common-only products masquerading as LCM evidence", () => {
  const sanitized = sanitizedInputJson as HongKongEaseV4SanitizedInput;
  const generated = buildHongKongEaseV4DerivationSupplement(sanitized);
  const affectedBaseIds = ["hk-ease-1099", "hk-ease-1100", "hk-ease-1101", "hk-ease-1102"];
  let rejectedMutationCount = 0;

  for (const baseId of affectedBaseIds) {
    const baseline = generated.rows.find((row) => row.baseId === baseId);
    assert.ok(baseline);
    const row = structuredClone(baseline);
    const evidence = shortDivisionProductEvidenceForTest(row);
    assert.ok(evidence);
    const commonOnly = [...evidence.products.commonDivisors];
    const wrongLcmValue = exactTestProduct(commonOnly).toString();
    const wrongProducts: V4ShortDivisionProductEvidence = {
      ...structuredClone(evidence.products),
      allDivisors: commonOnly,
      lcmProduct: {
        expression: commonOnly.join(" × "),
        value: wrongLcmValue
      }
    };
    (evidence.step.parameters as Record<string, unknown>).divisionProducts = structuredClone(wrongProducts);
    (evidence.step.output as { semanticValue: Record<string, unknown> }).semanticValue.divisionProducts = structuredClone(wrongProducts);
    (row.computedResult.semanticValue as Record<string, unknown>).divisionProducts = structuredClone(wrongProducts);
    rehashV4Row(row);

    assert.throws(
      () => validateHongKongEaseV4DerivationRow(sanitized.rows[row.index], row),
      /V4_(?:STEP_INPUT_BINDING_INVALID|STEP_EXECUTION_INVALID|DOMAIN_RULE_OUTPUT_INVALID)/,
      `${baseId}: common-only factors must not be accepted as an LCM product`
    );
    rejectedMutationCount += 1;
  }

  assert.equal(rejectedMutationCount, 4);
});

