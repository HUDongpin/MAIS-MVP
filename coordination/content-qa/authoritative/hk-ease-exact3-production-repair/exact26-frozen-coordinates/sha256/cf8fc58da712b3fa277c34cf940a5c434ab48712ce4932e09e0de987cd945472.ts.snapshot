test("v4 exact26 independent review receipt is materialized before semantic repair", () => {
  assert.equal(
    existsSync(HK_EASE_V4_EXACT26_RECEIPT_PATH),
    true,
    `missing frozen exact26 authority receipt: ${HK_EASE_V4_EXACT26_RECEIPT_PATH}`
  );

  const sanitizedBytes = readFileSync(join(process.cwd(), HK_EASE_V4_EXACT26_SANITIZED_PATH));
  const canonical = buildHongKongEaseV4Exact26CanonicalOutcome(sanitizedBytes);
  const receipt = exact26ReceiptJson as HongKongEaseV4Exact26ReviewReceipt;

  assert.equal(sha256(sanitizedBytes), HK_EASE_V4_EXACT26_SANITIZED_SHA256);
  assert.equal(receipt.schemaVersion, "hk-ease-v4-independent-exact26-review-receipt-v1");
  assert.equal(receipt.status, "frozen-independent-review-authority-needs-semantic-repair");
  assert.deepEqual(receipt.sanitizedInput, {
    path: HK_EASE_V4_EXACT26_SANITIZED_PATH,
    sha256: HK_EASE_V4_EXACT26_SANITIZED_SHA256
  });
  assert.deepEqual(receipt.supplementPreimage, {
    path: HK_EASE_V4_EXACT26_SUPPLEMENT_PREIMAGE_PATH,
    sha256: HK_EASE_V4_EXACT26_SUPPLEMENT_PREIMAGE_SHA256
  });
  assert.equal(
    receipt.supplementPreimage.path,
    "coordination/content-qa/authoritative/hk-ease-701-independent-oracle/preimages/v4-row-specific-derivation-supplement-a855b861.json",
    "the frozen review receipt must resolve an immutable historical preimage, not the mutable current supplement"
  );
  const immutablePreimageBytes = readFileSync(join(process.cwd(), receipt.supplementPreimage.path));
  assert.equal(sha256(immutablePreimageBytes), HK_EASE_V4_EXACT26_SUPPLEMENT_PREIMAGE_SHA256);
  assert.deepEqual(
    buildHongKongEaseV4Exact26ReviewReceipt(sanitizedBytes, immutablePreimageBytes),
    receipt,
    "the receipt must replay from the exact bytes at its recorded immutable preimage path"
  );
  assert.equal(receipt.orderedBaseIdSha256, HK_EASE_V4_EXACT26_ORDERED_BASE_ID_SHA256);
  assert.equal(canonical.orderedBaseIdSha256, HK_EASE_V4_EXACT26_ORDERED_BASE_ID_SHA256);
  assert.equal(canonical.outcomeByteLength, HK_EASE_V4_EXACT26_OUTCOME_BYTE_LENGTH);
  assert.equal(Buffer.byteLength(canonical.outcomePayload, "utf8"), 56_916);
  assert.equal(canonical.outcomeSha256, HK_EASE_V4_EXACT26_OUTCOME_SHA256);
  assert.equal(sha256(canonical.outcomePayload), HK_EASE_V4_EXACT26_OUTCOME_SHA256);
  assert.deepEqual(receipt.summary, { total: 701, pass: 675, fail: 26 });
  assert.deepEqual(receipt.exact26Ledger, HK_EASE_V4_EXACT26_LEDGER);
  assert.equal(receipt.exact26Ledger.length, 26);
  assert.equal(receipt.exact26LedgerSha256, sha256(JSON.stringify(HK_EASE_V4_EXACT26_LEDGER)));
  assert.deepEqual(receipt.outcomes, canonical.outcomes);
  assert.equal(receipt.outcomeByteLength, canonical.outcomeByteLength);
  assert.equal(receipt.outcomeSha256, canonical.outcomeSha256);
  assert.equal(receipt.outcomes.filter(({ status }) => status === "pass").length, 675);
  assert.equal(receipt.outcomes.filter(({ status }) => status === "fail").length, 26);

  const mutatedSanitized = Buffer.concat([sanitizedBytes, Buffer.from(" ", "utf8")]);
  assert.throws(
    () => buildHongKongEaseV4Exact26CanonicalOutcome(mutatedSanitized),
    /V4_EXACT26_SANITIZED_PREIMAGE_DRIFT/
  );
});

test("v4 exact26 historical supplement preimage is durably and authentically recoverable", async () => {
  assert.equal(existsSync(HK_EASE_V4_EXACT26_RECOVERY_BUILDER_PATH), true, "missing exact26 preimage recovery builder");
  assert.equal(existsSync(HK_EASE_V4_EXACT26_DURABLE_CONTAINER_PATH), true, "missing durable verified tsx source container");
  assert.equal(existsSync(HK_EASE_V4_EXACT26_DURABLE_DSL_PATH), true, "missing durable exact DSL dependency");
  assert.equal(existsSync(HK_EASE_V4_EXACT26_DURABLE_INPUT_BUILDER_PATH), true, "missing durable exact input-builder dependency");
  assert.equal(existsSync(HK_EASE_V4_EXACT26_DURABLE_SANITIZED_INPUT_PATH), true, "missing durable exact sanitized input dependency");
  assert.equal(existsSync(HK_EASE_V4_EXACT26_IMMUTABLE_PREIMAGE_PATH), true, "missing immutable a855 supplement preimage");
  assert.equal(sha256(readFileSync(HK_EASE_V4_EXACT26_DURABLE_DSL_PATH)), "62522f86bdd86b3bb1636675ed33881acf744c0034c9a6beef36c6650c33882f");
  assert.equal(sha256(readFileSync(HK_EASE_V4_EXACT26_DURABLE_INPUT_BUILDER_PATH)), "67b2265380d8f8dad92eec621d7a838853ebc46c47ae583da82ebcb5a7a054ab");
  assert.equal(sha256(readFileSync(HK_EASE_V4_EXACT26_DURABLE_SANITIZED_INPUT_PATH)), HK_EASE_V4_EXACT26_SANITIZED_SHA256);
  const contentQaRoot = join(process.cwd(), "coordination/content-qa");
  const sourceTreeRecoveryTempsBefore = readdirSync(contentQaRoot)
    .filter((name) => name.startsWith(".recover-v4-exact26-"));

  const recoveryModule = await import(
    `${pathToFileURL(HK_EASE_V4_EXACT26_RECOVERY_BUILDER_PATH).href}?test=${Date.now()}`
  ) as {
    recoverHongKongEaseV4Exact26SupplementPreimage: () => Promise<{
      containerSha256: string;
      recoveredBuilderSourceSha256: string;
      supplementBytes: Buffer;
      supplementSha256: string;
      supplementByteLength: number;
      rowCount: number;
      rowsPayloadSha256: string;
    }>;
  };
  const recovered = await recoveryModule.recoverHongKongEaseV4Exact26SupplementPreimage();
  const immutableBytes = readFileSync(HK_EASE_V4_EXACT26_IMMUTABLE_PREIMAGE_PATH);
  const sourceTreeRecoveryTempsAfter = readdirSync(contentQaRoot)
    .filter((name) => name.startsWith(".recover-v4-exact26-"));

  assert.equal(recovered.containerSha256, "79ea30eec567b7ae2383921d27c8a065e337bebf53249eafaa5a4ce02ea32cb0");
  assert.equal(recovered.recoveredBuilderSourceSha256, "33c75059dc657b5d252bb3f734763669d9491f47a4e1207ec86bae56f45f4b3d");
  assert.equal(recovered.supplementSha256, HK_EASE_V4_EXACT26_SUPPLEMENT_PREIMAGE_SHA256);
  assert.equal(recovered.supplementByteLength, 4_319_562);
  assert.equal(recovered.rowCount, 701);
  assert.equal(recovered.rowsPayloadSha256, "70a5ab7f3ee807d34c0647f311aa8ae0c9577220f009c6aac4b3b1c6ede35de5");
  assert.equal(sha256(immutableBytes), recovered.supplementSha256);
  assert.deepEqual(immutableBytes, recovered.supplementBytes);
  assert.deepEqual(sourceTreeRecoveryTempsAfter, sourceTreeRecoveryTempsBefore, "recovery must not write transient source files into coordination/content-qa");

  const originalTmpDir = process.env.TMPDIR;
  assert.ok(originalTmpDir);
  const tmpDirEscapeLink = join(originalTmpDir, `v4-exact26-tmpdir-escape-${process.pid}`);
  symlinkSync("/private/tmp", tmpDirEscapeLink);
  try {
    process.env.TMPDIR = tmpDirEscapeLink;
    await assert.rejects(
      () => recoveryModule.recoverHongKongEaseV4Exact26SupplementPreimage(),
      /V4_EXACT26_RECOVERY_TMPDIR_OUTSIDE_STARSHIP/,
      "a Starship-looking TMPDIR symlink must not escape to an external physical path"
    );
  } finally {
    process.env.TMPDIR = originalTmpDir;
    unlinkSync(tmpDirEscapeLink);
  }
});

