const quotedFormatFromPrompt = (prompt: string): string | null =>
  prompt.match(/(?:use|using|answer in|in) the format\s+[“"'](.+?)[”"']/i)?.[1] ?? null;

const responseContainsFormatSkeleton = (response: string, format: string): boolean => {
  const literalSegments = format
    .split(/(?:…|\.{3}|factorization|value)/gi)
    .filter((segment) => segment.length > 0);
  let cursor = 0;
  for (const segment of literalSegments) {
    const located = response.indexOf(segment, cursor);
    if (located < 0) return false;
    cursor = located + segment.length;
  }
  return true;
};

const independentRequiredUnitsFromPrompt = (rawPrompt: string): string[] => {
  const prompt = rawPrompt.replace(/L\.?C\.?M\.?/gi, "LCM");
  const units = new Set<string>();
  for (const match of prompt.matchAll(/_{2,}\s*(cm|mm|km|mL|kg|g|m|L)(?=\s|[.,;)]|$)/g)) {
    units.add(match[1]);
  }
  for (const match of prompt.matchAll(/(?:in|answer in|nearest)\s+(centimetres?|metres?|kilometres?|millimetres?|litres?|millilitres?|kilograms?|grams?|seconds?|minutes?|hours?)/gi)) {
    units.add(match[1].toLowerCase());
  }
  for (const match of prompt.matchAll(/(?:\d|\)|²|³)\s*(cm|mm|km|mL|kg|g|m|L)(?=\s|[,;)]|$)/g)) {
    const prefix = prompt.slice(Math.max(0, match.index! - 24), match.index! + 1);
    if (match[1] === "m" && /power of\s*$/i.test(prefix)) continue;
    units.add(match[1]);
  }
  if (/HK\$/.test(prompt)) units.add("HK$");
  if (/\bdegrees?\b|°/.test(prompt)) units.add("degrees");
  return [...units].sort();
};

const pass1SemanticIssuesFor = (
  categories: Pass1SemanticCategory[],
  prompt: string,
  row: HongKongEaseV4DerivationRow
): Pass1SemanticCategory[] => {
  const issues: Pass1SemanticCategory[] = [];
  const quotedFormat = quotedFormatFromPrompt(prompt);
  if (
    categories.includes("FORMAT_REQUIREMENT_METADATA_MISSING") &&
    row.promptRequirements.explicitFormat !== quotedFormat
  ) {
    issues.push("FORMAT_REQUIREMENT_METADATA_MISSING");
  }
  if (
    categories.includes("FORMAT_RESPONSE_MISMATCH") &&
    (!quotedFormat || !responseContainsFormatSkeleton(row.computedResult.responseText, quotedFormat))
  ) {
    issues.push("FORMAT_RESPONSE_MISMATCH");
  }
  const requiredUnits = independentRequiredUnitsFromPrompt(prompt);
  if (
    categories.includes("UNIT_REQUIREMENT_METADATA_MISSING") &&
    !requiredUnits.every((unit) => row.promptRequirements.units.includes(unit))
  ) {
    issues.push("UNIT_REQUIREMENT_METADATA_MISSING");
  }
  if (
    categories.includes("UNIT_REQUIREMENT_FALSE_POSITIVE") &&
    !row.promptRequirements.units.every((unit) => requiredUnits.includes(unit))
  ) {
    issues.push("UNIT_REQUIREMENT_FALSE_POSITIVE");
  }
  if (categories.includes("METHOD_OUTPUT_INCOMPLETE")) {
    const needsBothProducts = /product and value for both results/i.test(prompt);
    const needsHcfProduct = needsBothProducts || /H\.?C\.?F\.? (?:prime-factor )?product/i.test(prompt);
    const needsLcmProduct = needsBothProducts || /L\.?C\.?M\.? (?:prime-factor )?product/i.test(prompt);
    const response = row.computedResult.responseText;
    if (
      (needsHcfProduct && !/H\.C\.F\. product:\s*[^;]+\s=\s*\d+/i.test(response)) ||
      (needsLcmProduct && !/L\.C\.M\. product:\s*[^;]+\s=\s*\d+/i.test(response))
    ) {
      issues.push("METHOD_OUTPUT_INCOMPLETE");
    }
  }
  if (
    categories.includes("METHOD_PRESENTATION_MISMATCH") &&
    /short division/i.test(prompt) &&
    !/÷\d+→/.test(row.computedResult.responseText)
  ) {
    issues.push("METHOD_PRESENTATION_MISMATCH");
  }
  if (
    categories.includes("SYMBOLIC_SERIALIZATION_AMBIGUOUS") &&
    /power of\s+\d+[a-z]/i.test(prompt) &&
    !/\^\([^)]*\)|\^\{[^}]*\}/.test(row.computedResult.responseText)
  ) {
    issues.push("SYMBOLIC_SERIALIZATION_AMBIGUOUS");
  }
  return issues;
};

const v3 = v3OracleJson as {
  schemaVersion: string;
  questions: V3Row[];
};
const semanticRows = [
  ...(shardAJson as { rows: SemanticRow[] }).rows,
  ...(shardBJson as { rows: SemanticRow[] }).rows,
  ...(shardCJson as { rows: SemanticRow[] }).rows
];
const semanticRowById = new Map(semanticRows.map((row) => [row.id, row]));

const rehashV4Row = (row: HongKongEaseV4DerivationRow): void => {
  const { derivationPayloadSha256: _oldHash, ...payload } = row;
  row.derivationPayloadSha256 = sha256(JSON.stringify(payload));
};

const rehashV4Supplement = (supplement: HongKongEaseV4DerivationSupplement): void => {
  supplement.rowsPayloadSha256 = sha256(JSON.stringify(supplement.rows));
};

type V4ShortDivisionProductEvidence = {
  commonDivisors: string[];
  hcfProduct: { expression: string; value: string };
  allDivisors?: string[];
  lcmProduct?: { expression: string; value: string };
};

type V4ShortDivisionTraceEntry = {
  divisor: string;
  before: string[];
  after: string[];
  dividesEveryCurrentValue: boolean;
};

const shortDivisionProductEvidenceForTest = (row: HongKongEaseV4DerivationRow): {
  step: HongKongEaseV4DerivationRow["steps"][number];
  trace: V4ShortDivisionTraceEntry[];
  products: V4ShortDivisionProductEvidence;
} | null => {
  const step = row.steps.find((candidate) =>
    (candidate.parameters as Record<string, unknown>).divisionProducts !== undefined
  );
  if (!step) return null;
  const parameters = step.parameters as Record<string, unknown>;
  return {
    step,
    trace: parameters.shortDivisionTrace as V4ShortDivisionTraceEntry[],
    products: parameters.divisionProducts as V4ShortDivisionProductEvidence
  };
};

const exactTestGcd = (...values: bigint[]): bigint => values.reduce((left, right) => {
  let a = left < BigInt("0") ? -left : left;
  let b = right < BigInt("0") ? -right : right;
  while (b !== BigInt("0")) [a, b] = [b, a % b];
  return a;
});

const exactTestLcm = (...values: bigint[]): bigint => values.reduce(
  (left, right) => left / exactTestGcd(left, right) * right,
  BigInt("1")
);

const exactTestProduct = (values: string[]): bigint => values.reduce(
  (value, factor) => value * BigInt(factor),
  BigInt("1")
);

type V4TestPrimeFactor = { prime: string; exponent: number };

const exactTestPrimeFactorization = (value: bigint): V4TestPrimeFactor[] => {
  assert.ok(value > BigInt("0"));
  let remainder = value;
  const factors: V4TestPrimeFactor[] = [];
  for (let candidate = BigInt("2"); candidate * candidate <= remainder; candidate += BigInt("1")) {
    let exponent = 0;
    while (remainder % candidate === BigInt("0")) {
      remainder /= candidate;
      exponent += 1;
    }
    if (exponent > 0) factors.push({ prime: candidate.toString(), exponent });
  }
  if (remainder > BigInt("1")) factors.push({ prime: remainder.toString(), exponent: 1 });
  return factors;
};

const exactTestRenderPrimeFactorization = (factors: V4TestPrimeFactor[]): string => factors
  .map(({ prime, exponent }) => exponent === 1 ? prime : `${prime}^${exponent}`)
  .join(" × ");

const exactTestFactorizationRecords = (values: string[]) => values.map((value) => {
  const factors = exactTestPrimeFactorization(BigInt(value));
  return { value, factors, rendered: exactTestRenderPrimeFactorization(factors) };
});

const exactTestSmallestPrimeFactor = (value: bigint): bigint => {
  assert.ok(value > BigInt("1"));
  for (let candidate = BigInt("2"); candidate * candidate <= value; candidate += BigInt("1")) {
    if (value % candidate === BigInt("0")) return candidate;
  }
  return value;
};

const exactTestCompleteShortDivisionTrace = (values: string[]): V4ShortDivisionTraceEntry[] => {
  let current = values.map(BigInt);
  const trace: V4ShortDivisionTraceEntry[] = [];
  const divideBy = (divisor: bigint): void => {
    const before = current.map(String);
    const divisibility = current.map((value) => value % divisor === BigInt("0"));
    current = current.map((value, index) => divisibility[index] ? value / divisor : value);
    trace.push({
      divisor: divisor.toString(),
      before,
      after: current.map(String),
      dividesEveryCurrentValue: divisibility.every(Boolean)
    });
  };
  while (exactTestGcd(...current) > BigInt("1")) {
    divideBy(exactTestSmallestPrimeFactor(exactTestGcd(...current)));
  }
  while (current.some((value) => value > BigInt("1"))) {
    divideBy(exactTestSmallestPrimeFactor(current.find((value) => value > BigInt("1"))!));
  }
  return trace;
};

const exactTestDivisionProducts = (trace: V4ShortDivisionTraceEntry[]): V4ShortDivisionProductEvidence => {
  const commonDivisors = trace
    .filter(({ dividesEveryCurrentValue }) => dividesEveryCurrentValue)
    .map(({ divisor }) => divisor);
  const allDivisors = trace.map(({ divisor }) => divisor);
  return {
    commonDivisors,
    allDivisors,
    hcfProduct: {
      expression: commonDivisors.length > 0 ? commonDivisors.join(" × ") : "1",
      value: exactTestProduct(commonDivisors).toString()
    },
    lcmProduct: {
      expression: allDivisors.length > 0 ? allDivisors.join(" × ") : "1",
      value: exactTestProduct(allDivisors).toString()
    }
  };
};

const exactTestOperandsBoundToDivisionStep = (
  row: HongKongEaseV4DerivationRow,
  step: HongKongEaseV4DerivationRow["steps"][number]
): string[] => {
  const parameters = step.parameters as Record<string, unknown>;
  if (step.operation === "compose-structured-response") {
    const inputs = step.inputStepIds.map((stepId) => row.steps.find((candidate) => candidate.stepId === stepId));
    assert.equal(inputs.every(Boolean), true, `${row.baseId}: missing composed number-theory input`);
    const valueArrays = inputs.map((input) => (input!.parameters as { values?: unknown }).values);
    assert.equal(
      valueArrays.every((values) => Array.isArray(values) && values.every((value) => typeof value === "string")),
      true,
      `${row.baseId}: composed number-theory input has no exact values`
    );
    for (const values of valueArrays.slice(1)) assert.deepEqual(values, valueArrays[0]);
    return valueArrays[0] as string[];
  }
  if (Array.isArray(parameters.values) && parameters.values.every((value) => typeof value === "string")) {
    return parameters.values as string[];
  }
  assert.ok(Array.isArray(parameters.operands), `${row.baseId}: division step has no source operands`);
  return parameters.operands.map((operand) => {
    const value = (operand as { value?: { numerator?: unknown; denominator?: unknown } }).value;
    assert.ok(value, `${row.baseId}: division operand has no exact value`);
    assert.equal(value?.denominator, "1", `${row.baseId}: division operand is not an integer`);
    assert.equal(typeof value.numerator, "string", `${row.baseId}: division operand has no numerator`);
    return value.numerator as string;
  });
};

const exactTestRenderShortDivisionTrace = (trace: V4ShortDivisionTraceEntry[]): string => trace
  .map((entry) => `${entry.before.join(",")} ÷${entry.divisor}→${entry.after.join(",")}`)
  .join(" ");

test("v4 design freezes the exact immutable v3 467/234 predecessor partition and old evidence tuples", () => {
  const design = designJson as typeof designJson;
  const weakRows = v3.questions.filter((row) => !row.rowSpecificDerivation);
  const strongRows = v3.questions.filter((row) => row.rowSpecificDerivation);
  const weakIds = weakRows.map((row) => row.baseId);
  const strongIds = strongRows.map((row) => row.baseId);
  const weakIdSet = new Set(weakIds);
  const tuples: ClassificationTuple[] = weakRows.map((row) => {
    const oldBasis = semanticRowById.get(row.baseId)?.reviewBasis;
    assert.equal(typeof oldBasis, "string", `${row.baseId}: old review basis must resolve from immutable shards`);
    assert.equal(
      row.reviewMethodClassification,
      oldBasis,
      `${row.baseId}: v3 classification must be the exact old shard review basis`
    );
    return {
      id: row.baseId,
      oldClassification: row.reviewMethodClassification,
      oldSolutionBasisSha256: sha256(JSON.stringify(oldBasis))
    };
  });
  const expectedDistribution = Object.fromEntries(
    [...new Set(tuples.map((tuple) => tuple.oldClassification))]
      .sort()
      .map((classification) => [
        classification,
        tuples.filter((tuple) => tuple.oldClassification === classification).length
      ])
  );

  assert.equal(design.schemaVersion, "hk-ease-independent-oracle-v4-derivation-design-v2");
  assert.equal(v3.schemaVersion, "hk-ease-independent-answer-oracle-v3");
  assert.equal(
    design.immutablePredecessor.sha256,
    sha256(readFileSync(design.immutablePredecessor.path)),
    "the immutable v3 bytes must remain exactly bound"
  );
  assert.equal(weakRows.length, 467);
  assert.equal(strongRows.length, 234);
  assert.equal(design.predecessorPartition.classificationOnlySet.count, 467);
  assert.equal(design.predecessorPartition.rowSpecificSet.count, 234);
  assert.equal(design.predecessorPartition.unionCount, new Set([...weakIds, ...strongIds]).size);
  assert.equal(design.predecessorPartition.unionCount, 701);
  assert.equal(design.predecessorPartition.intersectionCount, strongIds.filter((id) => weakIdSet.has(id)).length);
  assert.equal(design.predecessorPartition.intersectionCount, 0);
  assert.equal(design.predecessorPartition.classificationOnlySet.firstId, weakIds[0]);
  assert.equal(design.predecessorPartition.classificationOnlySet.lastId, weakIds.at(-1));
  assert.equal(
    design.predecessorPartition.classificationOnlySet.orderedIdListSha256,
    sha256(`${weakIds.join("\n")}\n`)
  );
  assert.equal(
    design.predecessorPartition.classificationOnlySet.sortedIdListSha256,
    sha256(`${[...weakIds].sort().join("\n")}\n`)
  );
  assert.equal(
    design.predecessorPartition.classificationOnlySet.orderedTupleSha256,
    sha256(JSON.stringify(tuples))
  );
  assert.equal(
    design.predecessorPartition.classificationOnlySet.sortedTupleSha256,
    sha256(JSON.stringify([...tuples].sort((left, right) => left.id.localeCompare(right.id))))
  );
  assert.deepEqual(
    design.predecessorPartition.classificationOnlySet.oldClassificationDistribution,
    expectedDistribution
  );
  assert.equal(
    design.predecessorPartition.rowSpecificSet.orderedIdListSha256,
    sha256(`${strongIds.join("\n")}\n`)
  );
  assert.equal(
    design.predecessorPartition.rowSpecificSet.sortedIdListSha256,
    sha256(`${[...strongIds].sort().join("\n")}\n`)
  );
});

test("v4 design enforces a sanitized input, answer-blind executable derivation, then comparison-only join", () => {
  const design = designJson as typeof designJson;
  const layer1 = design.layer1SanitizedProblemInput;
  const layer2 = design.layer2AnswerBlindDerivation;
  const layer3 = design.layer3PostDerivationComparison;
  const inputSerialization = layer1.problemPayloadCanonicalSerialization;
  const forbiddenTokens = [
    "question.answer",
    "question.acceptedAnswers",
    "question.explanationEn",
    "question.explanationZh",
    "responseContract",
    "responsePolicy"
  ];

  assert.equal(layer1.requiredQuestionCount, 701);
  assert.deepEqual(layer1.requiredPerRowFields, [
    "index",
    "baseId",
    "type",
    "prompt",
    "options",
    "diagram",
    "problemPayloadSha256"
  ]);
  for (const token of forbiddenTokens) {
    assert.equal(inputSerialization.includes(token), false, `sanitized serialization must exclude ${token}`);
  }
  assert.deepEqual(layer1.forbiddenKeysAtAnyDepth, [
    "answer",
    "acceptedAnswers",
    "explanation",
    "explanationEn",
    "explanationZh",
    "responseContract",
    "responsePolicy",
    "productionResponse"
  ]);
  assert.deepEqual(layer2.allowedDataInputPaths, [layer1.artifactPath]);
  assert.equal(layer2.forbiddenDataInputPaths.includes(layer1.sourcePath), true);
  assert.equal(layer2.generationProhibition.includes("must not import, read, receive, or derive"), true);
  assert.equal(layer2.answerIndependenceInvariant.includes("byte-identical supplement output"), true);
  assert.equal(layer2.factContract.includes("row-local locator"), true);
  assert.equal(layer2.stepContract.includes("executable typed operation"), true);
  assert.equal(layer2.multipleChoiceContract.includes("every option index exactly once"), true);
  assert.equal(layer2.multipleChoiceContract.includes("exactly one option is true"), true);
  assert.equal(layer3.comparisonBoundary.includes("Only this layer"), true);
  assert.equal(layer3.comparisonBoundary.includes("cannot rewrite or regenerate"), true);
  assert.equal(layer3.joinInputs.includes(layer1.artifactPath), true);
  assert.equal(layer3.joinInputs.includes(layer2.supplementPath), true);
  assert.equal(layer3.comparisonOnlyPerRowFields.includes("answerPayloadSha256"), true);
  assert.equal(layer3.comparisonOnlyPerRowFields.includes("responsePolicyPayloadSha256"), true);
  assert.equal(layer2.requiredPerRowFields.includes("answerPayloadSha256"), false);
  assert.equal(layer2.requiredPerRowFields.includes("responsePolicyPayloadSha256"), false);
  assert.equal(design.requiredMutationMatrix.productionAnswerWrongComparisonOnly, 701);
  assert.equal(design.requiredMutationMatrix.productionAnswerBlankDerivationByteIdentity, 701);
  assert.equal(design.requiredMutationMatrix.promptMutation, 701);
  assert.equal(design.requiredMutationMatrix.multipleChoiceOptionPayloadAndOrderMutation, 90);
  assert.equal(design.requiredMutationMatrix.answerOnlyReplay, 701);
  assert.equal(design.requiredMutationMatrix.genericCategoryProse, 701);
});

