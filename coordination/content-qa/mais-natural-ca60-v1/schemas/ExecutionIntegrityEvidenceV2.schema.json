{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/ExecutionIntegrityEvidenceV2.schema.json",
  "title":"ExecutionIntegrityEvidenceV2",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","expectedCallGraphHash","completedAttemptGraphHash","expectedSuccessfulCallCount","observedSuccessfulCallCount","completedAttemptCount","extraCompletedCalls","missingSuccessfulCalls","duplicateSuccessfulCallKeys","nonStateBoundCallCount","activeAttemptCount","receiptChainValid","providerTupleValid","capsValid","terminalProviderFailure","materialDeviation","postResultDesignDrift","labelLeakage","unauthorizedProviderCall","thresholdFrozenAfterLabelOrResult","receiptChainErrors","providerTupleErrors","capErrors","overallIntegrityDisposition","derivedAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"ExecutionIntegrityEvidenceV2"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "expectedCallGraphHash":{"$ref":"#/$defs/hash"},
    "completedAttemptGraphHash":{"$ref":"#/$defs/hash"},
    "expectedSuccessfulCallCount":{"type":"integer","minimum":0,"maximum":420},
    "observedSuccessfulCallCount":{"type":"integer","minimum":0,"maximum":420},
    "completedAttemptCount":{"type":"integer","minimum":0,"maximum":850},
    "extraCompletedCalls":{"type":"array","items":{"$ref":"#/$defs/completedCall"}},
    "missingSuccessfulCalls":{"type":"array","items":{"$ref":"#/$defs/expectedCall"}},
    "duplicateSuccessfulCallKeys":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "nonStateBoundCallCount":{"type":"integer","minimum":0,"maximum":850},
    "activeAttemptCount":{"type":"integer","minimum":0,"maximum":850},
    "receiptChainValid":{"type":"boolean"},
    "providerTupleValid":{"type":"boolean"},
    "capsValid":{"type":"boolean"},
    "terminalProviderFailure":{"type":"boolean"},
    "materialDeviation":{"type":"boolean"},
    "postResultDesignDrift":{"type":"boolean"},
    "labelLeakage":{"type":"boolean"},
    "unauthorizedProviderCall":{"type":"boolean"},
    "thresholdFrozenAfterLabelOrResult":{"type":"boolean"},
    "receiptChainErrors":{"$ref":"#/$defs/errors"},
    "providerTupleErrors":{"$ref":"#/$defs/errors"},
    "capErrors":{"$ref":"#/$defs/errors"},
    "overallIntegrityDisposition":{"enum":["INTACT_PENDING_FROZEN_METRIC_DECISION","INVALID_FOR_GENERALIZATION","EXECUTION_INTEGRITY_FAILED"]},
    "derivedAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "errors":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "expectedCall":{"type":"object","additionalProperties":false,"required":["itemHash","role"],"properties":{"itemHash":{"$ref":"#/$defs/hash"},"role":{"type":"string","minLength":1}}},
    "completedCall":{"type":"object","additionalProperties":false,"required":["itemHash","role","attemptOrdinal","attemptStatus","stateBound","planHash","terminalProviderFailure","canaryOrOrderViolation"],"properties":{"itemHash":{"$ref":"#/$defs/hash"},"role":{"type":"string","minLength":1},"attemptOrdinal":{"type":"integer","minimum":1,"maximum":2},"attemptStatus":{"type":"string","minLength":1},"stateBound":{"type":"boolean"},"planHash":{"$ref":"#/$defs/hash"},"terminalProviderFailure":{"type":"boolean"},"canaryOrOrderViolation":{"type":"boolean"}}}
  }
}
