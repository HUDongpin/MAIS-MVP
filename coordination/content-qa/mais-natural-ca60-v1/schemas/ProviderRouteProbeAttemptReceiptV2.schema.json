{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/ProviderRouteProbeAttemptReceiptV2.schema.json",
  "title":"ProviderRouteProbeAttemptReceiptV2",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","authorizationHash","provider","requestedModel","observedModel","requestedEndpoint","observedEndpoint","projectResidency","dataRegion","requestBodyClass","requestBodyHash","responseBodyHash","rawResponseArtifactHash","rawResponseBindingReceiptHash","providerRequestId","containsNaturalQuestionText","providerEventCount","httpRequestCount","credentialReadCount","startedAt","finishedAt","httpStatus","attemptStatus","selfHash"],
  "properties":{
    "schemaVersion":{"const":"ProviderRouteProbeAttemptReceiptV2"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "authorizationHash":{"$ref":"#/$defs/hash"},
    "provider":{"enum":["OPENAI_DIRECT","DEEPSEEK_DIRECT"]},
    "requestedModel":{"enum":["gpt-5.6-luna","deepseek-v4-pro"]},
    "observedModel":{"enum":["gpt-5.6-luna","deepseek-v4-pro"]},
    "requestedEndpoint":{"enum":["https://us.api.openai.com/v1/responses","https://api.deepseek.com/chat/completions"]},
    "observedEndpoint":{"enum":["https://us.api.openai.com/v1/responses","https://api.deepseek.com/chat/completions"]},
    "projectResidency":{"type":"string","minLength":1},
    "dataRegion":{"type":"string","minLength":1},
    "requestBodyClass":{"const":"ROUTE_PROBE_NO_NATURAL_CONTENT_V2"},
    "requestBodyHash":{"$ref":"#/$defs/hash"},
    "responseBodyHash":{"$ref":"#/$defs/hash"},
    "rawResponseArtifactHash":{"$ref":"#/$defs/hash"},
    "rawResponseBindingReceiptHash":{"$ref":"#/$defs/hash"},
    "providerRequestId":{"type":"string","minLength":1},
    "containsNaturalQuestionText":{"const":false},
    "providerEventCount":{"const":1},
    "httpRequestCount":{"const":1},
    "credentialReadCount":{"const":1},
    "startedAt":{"type":"string","format":"date-time"},
    "finishedAt":{"type":"string","format":"date-time"},
    "httpStatus":{"type":"integer","minimum":200,"maximum":299},
    "attemptStatus":{"const":"SUCCEEDED"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
