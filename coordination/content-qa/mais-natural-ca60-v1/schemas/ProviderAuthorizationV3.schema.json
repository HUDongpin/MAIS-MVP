{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.local/schemas/ProviderAuthorizationV3.schema.json",
  "title": "ProviderAuthorizationV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authorizationKind", "designId", "runnerRegistrationHash", "runnerSourceCommit", "productionSourceRootHash", "testSourceRootHash", "freshRunnerReviewHash", "frameRegistrationHash", "sampleManifestHash", "samplePayloadSetHash", "privacyScreenHash", "rightsScreenHash", "providerContractErratumHash", "issuedAt", "expiresAt", "provider", "model", "endpoint", "projectResidency", "projectIdentityHash", "roleSet", "routeReceiptHash", "priceSnapshotHash", "ownerGrantHash", "credentialReadinessReceiptHash", "authorizationEvidenceHash", "sampleExecutionInventoryHash", "egressAllowlist", "egressDenylist", "egressPolicyHash", "roleReservationPolicyHash", "authorizedBy", "currency", "nonAuthorizations", "credentialReadAuthorized", "providerExecutionAuthorized", "naturalQuestionEgressAuthorized", "tokenAuthorizationCreated", "attemptAuthorizationCreated", "usdAuthorizationCreated", "maximumAttempts", "maximumSuccessfulCalls", "maximumInputTokens", "maximumOutputTokens", "maximumTokens", "maximumEstimatedUsd", "concurrencyCap", "maximumAttemptsPerRole", "roleReservationPolicy", "selfHash"],
  "properties": {
    "schemaVersion": { "const": "ProviderAuthorizationV3" },
    "authorizationKind": { "enum": ["OPENAI_REFERENCE_LABELING", "DEEPSEEK_EVALUATION"] },
    "designId": { "const": "MAIS-NATURAL-CA60-V5" },
    "runnerRegistrationHash": { "$ref": "#/$defs/hash" },
    "runnerSourceCommit": { "$ref": "#/$defs/commit" },
    "productionSourceRootHash": { "$ref": "#/$defs/hash" },
    "testSourceRootHash": { "$ref": "#/$defs/hash" },
    "freshRunnerReviewHash": { "$ref": "#/$defs/hash" },
    "frameRegistrationHash": { "$ref": "#/$defs/hash" },
    "sampleManifestHash": { "$ref": "#/$defs/hash" },
    "samplePayloadSetHash": { "$ref": "#/$defs/hash" },
    "privacyScreenHash": { "$ref": "#/$defs/hash" },
    "rightsScreenHash": { "$ref": "#/$defs/hash" },
    "providerContractErratumHash": { "$ref": "#/$defs/hash" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "provider": { "enum": ["OPENAI_DIRECT", "DEEPSEEK_DIRECT"] },
    "model": { "enum": ["gpt-5.6-luna", "deepseek-v4-pro"] },
    "endpoint": { "enum": ["https://us.api.openai.com/v1/responses", "https://api.deepseek.com/chat/completions"] },
    "projectResidency": { "enum": ["US_STORAGE_PROCESSING", "UNKNOWN_PENDING_ROUTE_PROBE_EVIDENCE"] },
    "projectIdentityHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "roleSet": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "routeReceiptHash": { "$ref": "#/$defs/hash" },
    "priceSnapshotHash": { "$ref": "#/$defs/hash" },
    "ownerGrantHash": { "$ref": "#/$defs/hash" },
    "credentialReadinessReceiptHash": { "$ref": "#/$defs/hash" },
    "authorizationEvidenceHash": { "$ref": "#/$defs/hash" },
    "sampleExecutionInventoryHash": { "$ref": "#/$defs/hash" },
    "egressAllowlist": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "egressDenylist": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "egressPolicyHash": { "$ref": "#/$defs/hash" },
    "roleReservationPolicyHash": { "$ref": "#/$defs/hash" },
    "authorizedBy": { "type": "string", "minLength": 1 },
    "currency": { "const": "USD" },
    "nonAuthorizations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "credentialReadAuthorized": { "const": true },
    "providerExecutionAuthorized": { "const": true },
    "naturalQuestionEgressAuthorized": { "const": true },
    "tokenAuthorizationCreated": { "const": true },
    "attemptAuthorizationCreated": { "const": true },
    "usdAuthorizationCreated": { "const": true },
    "maximumAttempts": { "type": "integer", "minimum": 1 },
    "maximumSuccessfulCalls": { "type": "integer", "minimum": 1 },
    "maximumInputTokens": { "type": "integer", "minimum": 0 },
    "maximumOutputTokens": { "type": "integer", "minimum": 0 },
    "maximumTokens": { "type": "integer", "minimum": 1 },
    "maximumEstimatedUsd": { "type": "number", "exclusiveMinimum": 0 },
    "concurrencyCap": { "type": "integer", "minimum": 1, "maximum": 4 },
    "maximumAttemptsPerRole": { "const": 2 },
    "roleReservationPolicy": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "enum": ["A_SOLVE", "A_LABEL", "B_SOLVE", "B_LABEL", "ADJUDICATOR", "B_PRIME_CRITIQUE", "B_PRIME_REVISION", "C0_PRIME_ROLE_1", "C0_PRIME_ROLE_2", "C0_PRIME_ROLE_3", "C0_PRIME_ROLE_4", "C0_PRIME_ROLE_5"] },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inputTokens", "outputTokens"],
        "properties": {
          "inputTokens": { "type": "integer", "minimum": 0 },
          "outputTokens": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "selfHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
