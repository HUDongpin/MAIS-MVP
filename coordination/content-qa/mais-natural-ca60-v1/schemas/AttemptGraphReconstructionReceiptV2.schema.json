{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/AttemptGraphReconstructionReceiptV2.schema.json",
  "title":"AttemptGraphReconstructionReceiptV2",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","authorizationHash","sampleExecutionInventoryHash","provider","ledgerEntryRootHash","ledgerTerminalHash","requestArtifactRootHash","dispatchAuditRootHash","semanticDispatchAuthorityRootHash","dispatchPermitRootHash","compatibilityDispatchPermitRootHash","rawResponseArtifactRootHash","rawResponseBindingRootHash","attemptCommitIntentRootHash","resolvedAttemptReceiptRootHash","roleAttemptEvidenceRootHash","roleAttemptEvidenceReceipts","evidenceCollectionCardinalities","bidirectionalSetEqualityVerified","reservationCount","completionCount","resolvedAttemptCount","successfulAttemptCount","failedAttemptCount","activeReservationCount","rawReparseFailureCount","danglingEvidenceCount","lineageErrorCount","lineageErrors","graphStatus","derivedAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"AttemptGraphReconstructionReceiptV2"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "authorizationHash":{"$ref":"#/$defs/hash"},
    "sampleExecutionInventoryHash":{"$ref":"#/$defs/hash"},
    "provider":{"enum":["OPENAI_DIRECT","DEEPSEEK_DIRECT"]},
    "ledgerEntryRootHash":{"$ref":"#/$defs/hash"},
    "ledgerTerminalHash":{"$ref":"#/$defs/nullableHash"},
    "requestArtifactRootHash":{"$ref":"#/$defs/hash"},
    "dispatchAuditRootHash":{"$ref":"#/$defs/hash"},
    "semanticDispatchAuthorityRootHash":{"$ref":"#/$defs/hash"},
    "dispatchPermitRootHash":{"$ref":"#/$defs/hash"},
    "compatibilityDispatchPermitRootHash":{"$ref":"#/$defs/hash"},
    "rawResponseArtifactRootHash":{"$ref":"#/$defs/hash"},
    "rawResponseBindingRootHash":{"$ref":"#/$defs/hash"},
    "attemptCommitIntentRootHash":{"$ref":"#/$defs/hash"},
    "resolvedAttemptReceiptRootHash":{"$ref":"#/$defs/hash"},
    "roleAttemptEvidenceRootHash":{"$ref":"#/$defs/hash"},
    "roleAttemptEvidenceReceipts":{"type":"array","maxItems":850,"items":{"type":"object"}},
    "evidenceCollectionCardinalities":{"type":"object","additionalProperties":false,"required":["requestArtifacts","dispatchAudits","semanticDispatchAuthorities","dispatchPermits","compatibilityDispatchPermits","rawResponseArtifacts","rawResponseBindingReceipts","attemptCommitIntents","resolvedAttemptReceipts"],"properties":{"requestArtifacts":{"$ref":"#/$defs/cardinality"},"dispatchAudits":{"$ref":"#/$defs/cardinality"},"semanticDispatchAuthorities":{"$ref":"#/$defs/cardinality"},"dispatchPermits":{"$ref":"#/$defs/cardinality"},"compatibilityDispatchPermits":{"$ref":"#/$defs/cardinality"},"rawResponseArtifacts":{"$ref":"#/$defs/cardinality"},"rawResponseBindingReceipts":{"$ref":"#/$defs/cardinality"},"attemptCommitIntents":{"$ref":"#/$defs/cardinality"},"resolvedAttemptReceipts":{"$ref":"#/$defs/cardinality"}}},
    "bidirectionalSetEqualityVerified":{"type":"boolean"},
    "reservationCount":{"$ref":"#/$defs/count"},
    "completionCount":{"$ref":"#/$defs/count"},
    "resolvedAttemptCount":{"$ref":"#/$defs/count"},
    "successfulAttemptCount":{"$ref":"#/$defs/count"},
    "failedAttemptCount":{"$ref":"#/$defs/count"},
    "activeReservationCount":{"$ref":"#/$defs/count"},
    "rawReparseFailureCount":{"$ref":"#/$defs/count"},
    "danglingEvidenceCount":{"$ref":"#/$defs/count"},
    "lineageErrorCount":{"$ref":"#/$defs/count"},
    "lineageErrors":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "graphStatus":{"enum":["COMPLETE_VALID","INCOMPLETE_INVALID"]},
    "derivedAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "allOf":[
    {"if":{"properties":{"graphStatus":{"const":"COMPLETE_VALID"}},"required":["graphStatus"]},"then":{"properties":{"bidirectionalSetEqualityVerified":{"const":true},"danglingEvidenceCount":{"const":0},"lineageErrorCount":{"const":0},"lineageErrors":{"maxItems":0}}}},
    {"if":{"properties":{"graphStatus":{"const":"INCOMPLETE_INVALID"}},"required":["graphStatus"]},"then":{"properties":{"bidirectionalSetEqualityVerified":{"const":false}}}}
  ],
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "nullableHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "count":{"type":"integer","minimum":0,"maximum":850},
    "cardinality":{"type":"object","additionalProperties":false,"required":["supplied","expectedReferenced"],"properties":{"supplied":{"$ref":"#/$defs/count"},"expectedReferenced":{"$ref":"#/$defs/count"}}}
  }
}
