{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/DeepSeekC0ExecutionSetV4.schema.json",
  "title":"DeepSeekC0ExecutionSetV4",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","executionRegistrationHash","sampleExecutionInventoryHash","predicateReceiptHashes","decisions","selectedItemHashes","selectedItemCount","expectedSuccessfulCallCount","selectionFormula","unknownOrMalformedDisposition","terminalMissingEvidenceDisposition","openAIReferenceInputCount","selfHash"],
  "properties":{
    "schemaVersion":{"const":"DeepSeekC0ExecutionSetV4"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "executionRegistrationHash":{"$ref":"#/$defs/hash"},
    "sampleExecutionInventoryHash":{"$ref":"#/$defs/hash"},
    "predicateReceiptHashes":{"type":"array","minItems":60,"maxItems":60,"uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
    "decisions":{"type":"array","minItems":60,"maxItems":60,"items":{"type":"object"}},
    "selectedItemHashes":{"type":"array","minItems":12,"maxItems":60,"uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
    "selectedItemCount":{"type":"integer","minimum":12,"maximum":60},
    "expectedSuccessfulCallCount":{"type":"integer","minimum":180,"maximum":420},
    "selectionFormula":{"const":"UNION(MANDATORY_TRIGGER_SET,RANDOM_AUDIT_12_SET)"},
    "unknownOrMalformedDisposition":{"const":"TRIGGER"},
    "terminalMissingEvidenceDisposition":{"const":"TRIGGER_WITHOUT_IMPUTATION"},
    "openAIReferenceInputCount":{"const":0},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
