{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.local/schemas/ProviderEventReceiptV3.schema.json",
  "title": "ProviderEventReceiptV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reservationHash", "authorizationHash", "attemptId", "role", "itemHash", "itemIdPseudonym", "clusterId", "sampleExecutionInventoryHash", "provider", "requestedModel", "observedModel", "requestedEndpoint", "observedEndpoint", "transportStatus", "bodyReadStatus", "httpStatus", "providerEventCount", "httpRequestCount", "responseBodyHash", "usageSource", "inputTokens", "outputTokens", "reasoningTokens", "totalTokens", "priceSnapshotHash", "estimatedCostUsd", "reservedCostUsd", "providerInvoiceAuthoritative", "parseStatus", "schemaStatus", "finishReason", "attemptStatus", "completedAt", "selfHash"],
  "properties": {
    "schemaVersion": { "const": "ProviderEventReceiptV3" },
    "reservationHash": { "$ref": "#/$defs/hash" },
    "authorizationHash": { "$ref": "#/$defs/hash" },
    "attemptId": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "itemHash": { "$ref": "#/$defs/hash" },
    "itemIdPseudonym": { "type": "string", "minLength": 1 },
    "clusterId": { "type": "string", "minLength": 1 },
    "sampleExecutionInventoryHash": { "$ref": "#/$defs/hash" },
    "provider": { "enum": ["OPENAI_DIRECT", "DEEPSEEK_DIRECT"] },
    "requestedModel": { "type": "string", "minLength": 1 },
    "observedModel": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "requestedEndpoint": { "type": "string", "format": "uri" },
    "observedEndpoint": { "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }] },
    "transportStatus": { "type": "string", "minLength": 1 },
    "bodyReadStatus": { "type": "string", "minLength": 1 },
    "httpStatus": { "anyOf": [{ "type": "integer", "minimum": 100, "maximum": 599 }, { "type": "null" }] },
    "providerEventCount": { "type": "integer", "minimum": 0, "maximum": 1 },
    "httpRequestCount": { "type": "integer", "minimum": 0, "maximum": 1 },
    "responseBodyHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "usageSource": { "enum": ["PROVIDER_ENVELOPE", "UNAVAILABLE_RESERVED_WORST_CASE"] },
    "inputTokens": { "$ref": "#/$defs/nullableCount" },
    "outputTokens": { "$ref": "#/$defs/nullableCount" },
    "reasoningTokens": { "$ref": "#/$defs/nullableCount" },
    "totalTokens": { "$ref": "#/$defs/nullableCount" },
    "priceSnapshotHash": { "$ref": "#/$defs/hash" },
    "estimatedCostUsd": { "type": "number", "minimum": 0 },
    "reservedCostUsd": { "type": "number", "minimum": 0 },
    "providerInvoiceAuthoritative": { "const": true },
    "parseStatus": { "enum": ["NOT_PARSED", "MALFORMED", "PARSED"] },
    "schemaStatus": { "enum": ["NOT_EVALUATED", "INVALID", "VALID"] },
    "finishReason": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "attemptStatus": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "format": "date-time" },
    "selfHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableCount": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
  }
}
