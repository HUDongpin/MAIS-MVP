    "compatibilityBaseTestSourceRootHash","closureKernels","providerEntrypoints","authorizationState",
    "status","claimCeiling","selfHash"
  ],
  "properties":{
    "schemaVersion":{"const":"NaturalCaExecutionRunnerSupersedingRegistrationV1"},
    "runnerVersion":{"const":"V5-R5"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "registeredAt":{"type":"string","format":"date-time"},
    "supersedesRunnerRegistrationHash":{"const":"2dd4b0e17d577f085aee33f9ada3a2de0f7db79b02b32524e9d6a05858a61dc6"},
    "supersededRunnerRegistrationCommit":{"const":"6ded6504318c044ddec4b262bb053143a2aec802"},
    "compatibilityBaseSourceCommit":{"const":"63fc224c0b67d6b26e5713938f33ccda6fe998b1"},
    "discrepancyReviewHash":{"const":"32a59ad2dd12a80cf772acb1be1110683f5b56d718c66681426eef0c739e6abc"},
    "discrepancyReviewCommit":{"const":"2bfd5ba703ecf1509a3ac47430fe6f06b80077f7"},
    "previousReceiptHash":{"const":"32a59ad2dd12a80cf772acb1be1110683f5b56d718c66681426eef0c739e6abc"},
    "ownerRunnerImplementationAuthorizationTextHash":{"const":"8f9767f1bb087656d57ab7885f621ef449eff61ea89aaead8bd34bf27f30f74f"},
    "designRegistrationHash":{"$ref":"#/$defs/hash"},"frameRegistrationHash":{"$ref":"#/$defs/hash"},
    "samplingFrameHash":{"$ref":"#/$defs/hash"},"sampleManifestHash":{"$ref":"#/$defs/hash"},
    "samplePayloadSetHash":{"$ref":"#/$defs/hash"},"sampleSelectionContentRootHash":{"$ref":"#/$defs/hash"},
    "c0RandomAuditHash":{"$ref":"#/$defs/hash"},"privacyScreenHash":{"$ref":"#/$defs/hash"},
    "rightsScreenHash":{"$ref":"#/$defs/hash"},"ownerDecisionRequestHash":{"$ref":"#/$defs/hash"},
    "ownerDecisionReceiptHash":{"$ref":"#/$defs/hash"},"rightsPolicyHash":{"$ref":"#/$defs/hash"},
    "lineageRuleHash":{"$ref":"#/$defs/hash"},"taxonomyHash":{"$ref":"#/$defs/hash"},
    "labelingAndAdjudicationHash":{"$ref":"#/$defs/hash"},"thresholdsDecisionAndPowerHash":{"$ref":"#/$defs/hash"},
    "decisionCeiling":{"const":"INCONCLUSIVE_MACHINE_REFERENCE"},"providerContractErratumHash":{"$ref":"#/$defs/hash"},
    "runnerSourceCommit":{"$ref":"#/$defs/commit"},"productionSourceManifest":{"$ref":"#/$defs/manifest"},
    "productionSourceRootHash":{"$ref":"#/$defs/hash"},"testSourceManifest":{"$ref":"#/$defs/manifest"},
    "testSourceRootHash":{"$ref":"#/$defs/hash"},"compatibilityBaseProductionSourceRootHash":{"$ref":"#/$defs/hash"},
    "compatibilityBaseTestSourceRootHash":{"$ref":"#/$defs/hash"},
    "closureKernels":{"type":"object","additionalProperties":false,"required":[
      "stateBoundDispatchHash","authenticatedRouteEvidenceHash","inventoryReconstructionHash","costPreviewHash",
      "executionIntegrityHash","recoveryHash","workflowIndexHash","schemaValidatorHash","referenceAgreementHash",
      "c0TriggerHash","guardedTransportHash","atomicLedgerHash","nativeScoringAndVerificationHash","runtimeCliHash"
    ],"properties":{
      "stateBoundDispatchHash":{"$ref":"#/$defs/hash"},"authenticatedRouteEvidenceHash":{"$ref":"#/$defs/hash"},
      "inventoryReconstructionHash":{"$ref":"#/$defs/hash"},"costPreviewHash":{"$ref":"#/$defs/hash"},
      "executionIntegrityHash":{"$ref":"#/$defs/hash"},"recoveryHash":{"$ref":"#/$defs/hash"},
      "workflowIndexHash":{"$ref":"#/$defs/hash"},"schemaValidatorHash":{"$ref":"#/$defs/hash"},
      "referenceAgreementHash":{"$ref":"#/$defs/hash"},"c0TriggerHash":{"$ref":"#/$defs/hash"},
      "guardedTransportHash":{"$ref":"#/$defs/hash"},"atomicLedgerHash":{"$ref":"#/$defs/hash"},
      "nativeScoringAndVerificationHash":{"$ref":"#/$defs/hash"},"runtimeCliHash":{"$ref":"#/$defs/hash"}
    }},
    "providerEntrypoints":{"type":"object","additionalProperties":false,"required":["openAI","deepSeek"],"properties":{
      "openAI":{"$ref":"#/$defs/entrypoint"},"deepSeek":{"$ref":"#/$defs/entrypoint"}
    }},
    "authorizationState":{"type":"object","additionalProperties":false,"required":[
      "credentialReadAuthorized","providerExecutionAuthorized","naturalQuestionEgressAuthorized",
      "tokenAuthorizationCreated","attemptAuthorizationCreated","usdAuthorizationCreated","credentialReadCount",
      "providerEventCount","naturalQuestionEgressCount","tokenCount","attemptCount","usdSpent",
      "referenceLabelCount","naturalQuestionResultCount"
    ],"properties":{
      "credentialReadAuthorized":{"const":false},"providerExecutionAuthorized":{"const":false},
      "naturalQuestionEgressAuthorized":{"const":false},"tokenAuthorizationCreated":{"const":false},
      "attemptAuthorizationCreated":{"const":false},"usdAuthorizationCreated":{"const":false},
      "credentialReadCount":{"const":0},"providerEventCount":{"const":0},"naturalQuestionEgressCount":{"const":0},
      "tokenCount":{"const":0},"attemptCount":{"const":0},"usdSpent":{"const":0},
      "referenceLabelCount":{"const":0},"naturalQuestionResultCount":{"const":0}
    }},
    "status":{"const":"OFFLINE_IMPLEMENTED_PENDING_FRESH_A11_V5_R5_REVIEW_PROVIDER_EXECUTION_BLOCKED"},
    "claimCeiling":{"const":"FRAME_AND_SAMPLE_FROZEN_RUNNER_OFFLINE_IMPLEMENTED_NOT_EXECUTED"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "manifest":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,
      "required":["path","byteLength","sha256"],"properties":{"path":{"type":"string","minLength":1},
      "byteLength":{"type":"integer","minimum":1},"sha256":{"$ref":"#/$defs/hash"}}}},
    "entrypoint":{"type":"object","additionalProperties":false,"required":["provider","model","endpoint","projectResidency","registeredCli","coreGuardHash","providerCallsMade"],
      "properties":{"provider":{"enum":["OPENAI_DIRECT","DEEPSEEK_DIRECT"]},"model":{"enum":["gpt-5.6-luna","deepseek-v4-pro"]},
      "endpoint":{"enum":["https://us.api.openai.com/v1/responses","https://api.deepseek.com/chat/completions"]},
      "projectResidency":{"enum":["US_STORAGE_PROCESSING","UNRESOLVED"]},
      "registeredCli":{"const":"runner-v5-r5-cli.mjs"},"coreGuardHash":{"$ref":"#/$defs/hash"},"providerCallsMade":{"const":0}},
      "allOf":[
        {"if":{"properties":{"provider":{"const":"OPENAI_DIRECT"}},"required":["provider"]},"then":{"properties":{"model":{"const":"gpt-5.6-luna"},"endpoint":{"const":"https://us.api.openai.com/v1/responses"},"projectResidency":{"const":"US_STORAGE_PROCESSING"}}}},
        {"if":{"properties":{"provider":{"const":"DEEPSEEK_DIRECT"}},"required":["provider"]},"then":{"properties":{"model":{"const":"deepseek-v4-pro"},"endpoint":{"const":"https://api.deepseek.com/chat/completions"},"projectResidency":{"const":"UNRESOLVED"}}}}
      ]}
  }
}
