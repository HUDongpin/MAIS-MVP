{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/NaturalCaExecutionRunnerSupersedingRegistrationV1.schema.json",
  "title":"NaturalCaExecutionRunnerSupersedingRegistrationV1",
  "type":"object",
  "additionalProperties":false,
  "required":[
