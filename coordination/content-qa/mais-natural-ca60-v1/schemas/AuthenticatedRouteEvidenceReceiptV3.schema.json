{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/AuthenticatedRouteEvidenceReceiptV3.schema.json",
  "title":"AuthenticatedRouteEvidenceReceiptV3",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","provider","model","endpoint","projectResidency","dataRegion","subjectIdentityHash","directBillingConfirmed","routeProbeConfirmed","routeProbeContainsNaturalQuestionText","priceCurrency","inputUsdPerMillionTokens","outputUsdPerMillionTokens","compatibilityRouteEvidenceReceiptHash","compatibilityRouteEvidenceReceipt","sourceSetHash","captureSetHash","captureReceipts","ownerEvidenceAttestationReceiptHash","ownerEvidenceAttestationReceipt","routeProbeAttemptReceiptHash","routeProbeAttemptReceipt","claimsDerivedFromProtectedRawBytes","referencedEvidenceRebuilt","evidenceDisposition","validatedAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"AuthenticatedRouteEvidenceReceiptV3"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "provider":{"enum":["OPENAI_DIRECT","DEEPSEEK_DIRECT"]},
    "model":{"enum":["gpt-5.6-luna","deepseek-v4-pro"]},
    "endpoint":{"enum":["https://us.api.openai.com/v1/responses","https://api.deepseek.com/chat/completions"]},
    "projectResidency":{"type":"string","minLength":1},
    "dataRegion":{"type":"string","minLength":1},
    "subjectIdentityHash":{"$ref":"#/$defs/hash"},
    "directBillingConfirmed":{"const":true},
    "routeProbeConfirmed":{"const":true},
    "routeProbeContainsNaturalQuestionText":{"const":false},
    "priceCurrency":{"const":"USD"},
    "inputUsdPerMillionTokens":{"type":"number","exclusiveMinimum":0},
    "outputUsdPerMillionTokens":{"type":"number","exclusiveMinimum":0},
    "compatibilityRouteEvidenceReceiptHash":{"$ref":"#/$defs/hash"},
    "compatibilityRouteEvidenceReceipt":{"type":"object"},
    "sourceSetHash":{"$ref":"#/$defs/hash"},
    "captureSetHash":{"$ref":"#/$defs/hash"},
    "captureReceipts":{"type":"array","minItems":5,"maxItems":5,"items":{"type":"object"}},
    "ownerEvidenceAttestationReceiptHash":{"$ref":"#/$defs/hash"},
    "ownerEvidenceAttestationReceipt":{"type":"object"},
    "routeProbeAttemptReceiptHash":{"$ref":"#/$defs/hash"},
    "routeProbeAttemptReceipt":{"type":"object"},
    "claimsDerivedFromProtectedRawBytes":{"const":true},
    "referencedEvidenceRebuilt":{"const":true},
    "evidenceDisposition":{"const":"OWNER_ATTESTED_PARSED_RAW_SOURCES_PLUS_GUARDED_ZERO_CONTENT_PROBE"},
    "validatedAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
