{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.local/schemas/StateBoundDispatchAuditReceiptV2.schema.json",
  "title": "StateBoundDispatchAuditReceiptV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "activeRunnerRegistrationHash", "compatibilityBaseRunnerRegistrationHash", "freshRunnerReviewHash", "ownerActivationGrantHash", "providerAuthorizationHash", "authenticatedRouteEvidenceHash", "costPreviewHash", "sampleExecutionInventoryHash", "executionRegistrationHash", "c0ExecutionSetHash", "canaryPredicateReceiptHash", "adjudicationTriggerHash", "canaryGateHash", "executionPlanHash", "executionPlan", "preReservationLedgerTerminalHash", "itemHash", "role", "attemptOrdinal", "attemptId", "issuedAt", "selfHash"],
  "properties": {
    "schemaVersion": { "const": "StateBoundDispatchAuditReceiptV2" },
    "designId": { "const": "MAIS-NATURAL-CA60-V5" },
    "activeRunnerRegistrationHash": { "$ref": "#/$defs/hash" },
    "compatibilityBaseRunnerRegistrationHash": { "$ref": "#/$defs/hash" },
    "freshRunnerReviewHash": { "$ref": "#/$defs/hash" },
    "ownerActivationGrantHash": { "$ref": "#/$defs/hash" },
    "providerAuthorizationHash": { "$ref": "#/$defs/hash" },
    "authenticatedRouteEvidenceHash": { "$ref": "#/$defs/hash" },
    "costPreviewHash": { "$ref": "#/$defs/hash" },
    "sampleExecutionInventoryHash": { "$ref": "#/$defs/hash" },
    "executionRegistrationHash": { "$ref": "#/$defs/maybeHash" },
    "c0ExecutionSetHash": { "$ref": "#/$defs/maybeHash" },
    "canaryPredicateReceiptHash": { "$ref": "#/$defs/maybeHash" },
    "adjudicationTriggerHash": { "$ref": "#/$defs/maybeHash" },
    "canaryGateHash": { "$ref": "#/$defs/maybeHash" },
    "executionPlanHash": { "$ref": "#/$defs/hash" },
    "executionPlan": { "type": "object" },
    "preReservationLedgerTerminalHash": { "$ref": "#/$defs/maybeHash" },
    "itemHash": { "$ref": "#/$defs/hash" },
    "role": { "type": "string", "minLength": 1 },
    "attemptOrdinal": { "type": "integer", "minimum": 1, "maximum": 2 },
    "attemptId": { "type": "string", "pattern": "^V5R6:[0-9a-f]{64}:[0-9a-f]{64}:[12]$" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "selfHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "maybeHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
  }
}
