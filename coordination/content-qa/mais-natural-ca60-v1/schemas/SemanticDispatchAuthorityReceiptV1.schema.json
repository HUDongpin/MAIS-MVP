{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/SemanticDispatchAuthorityReceiptV1.schema.json",
  "title":"SemanticDispatchAuthorityReceiptV1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","authorizationHash","compatibilityAuthorizationHash","executionRegistrationHash","sampleExecutionInventoryHash","mode","ledgerPrefixRootHash","ledgerPrefixTerminalHash","compatibilityPlanHash","canaryPredicateReceiptHash","canaryGateHash","c0ExecutionSetHash","itemHash","itemIdPseudonym","manifestOrdinal","role","failedAttemptsForItemRole","attemptOrdinal","attemptId","selectedC0MembershipVerified","canaryFirstVerified","roleOrderVerified","semanticStatus","issuedAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"SemanticDispatchAuthorityReceiptV1"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "authorizationHash":{"$ref":"#/$defs/hash"},
    "compatibilityAuthorizationHash":{"$ref":"#/$defs/hash"},
    "executionRegistrationHash":{"$ref":"#/$defs/hash"},
    "sampleExecutionInventoryHash":{"$ref":"#/$defs/hash"},
    "mode":{"enum":["DEEPSEEK_CANARY","DEEPSEEK_RESUME"]},
    "ledgerPrefixRootHash":{"$ref":"#/$defs/hash"},
    "ledgerPrefixTerminalHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "compatibilityPlanHash":{"$ref":"#/$defs/hash"},
    "canaryPredicateReceiptHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "canaryGateHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "c0ExecutionSetHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "itemHash":{"$ref":"#/$defs/hash"},
    "itemIdPseudonym":{"type":"string","minLength":1},
    "manifestOrdinal":{"type":"integer","minimum":1,"maximum":60},
    "role":{"enum":["B_PRIME_CRITIQUE","B_PRIME_REVISION","C0_PRIME_ROLE_1","C0_PRIME_ROLE_2","C0_PRIME_ROLE_3","C0_PRIME_ROLE_4","C0_PRIME_ROLE_5"]},
    "failedAttemptsForItemRole":{"type":"integer","minimum":0,"maximum":1},
    "attemptOrdinal":{"type":"integer","minimum":1,"maximum":2},
    "attemptId":{"type":"string","pattern":"^V5R7:[0-9a-f]{64}:[0-9a-f]{64}:[12]$"},
    "selectedC0MembershipVerified":{"type":"boolean"},
    "canaryFirstVerified":{"const":true},
    "roleOrderVerified":{"const":true},
    "semanticStatus":{"const":"EXACT_FROZEN_PLANNER_INPUTS_REBUILT_BEFORE_RESERVATION"},
    "issuedAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
