{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/ResolvedProviderAttemptReceiptV2.schema.json",
  "title":"ResolvedProviderAttemptReceiptV2",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","authorizationHash","authenticatedRouteEvidenceHash","requestArtifactHash","dispatchAuditHash","reservationHash","dispatchPermitHash","compatibilityDispatchPermitHash","rawResponseArtifactHash","rawResponseBindingReceiptHash","providerEventReceiptHash","roleOutputHash","attemptCommitIntentHash","compatibilityCompletionHash","attemptId","provider","requestedModel","observedModel","requestedEndpoint","observedEndpoint","projectResidency","dataRegion","role","itemHash","itemIdPseudonym","attemptStatus","transportStatus","bodyReadStatus","parseStatus","schemaStatus","providerEventCount","httpRequestCount","credentialReadCount","inputTokens","outputTokens","reasoningTokens","totalTokens","estimatedCostUsd","rawResponseRetainedInProtectedStorage","rawResponseIndependentlyReparsed","commitIntentPersistedBeforeCompletion","completionMatchesPreparedHash","completedAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"ResolvedProviderAttemptReceiptV2"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "authorizationHash":{"$ref":"#/$defs/hash"},
    "authenticatedRouteEvidenceHash":{"$ref":"#/$defs/hash"},
    "requestArtifactHash":{"$ref":"#/$defs/hash"},
    "dispatchAuditHash":{"$ref":"#/$defs/hash"},
    "reservationHash":{"$ref":"#/$defs/hash"},
    "dispatchPermitHash":{"$ref":"#/$defs/hash"},
    "compatibilityDispatchPermitHash":{"$ref":"#/$defs/hash"},
    "rawResponseArtifactHash":{"$ref":"#/$defs/hash"},
    "rawResponseBindingReceiptHash":{"$ref":"#/$defs/hash"},
    "providerEventReceiptHash":{"$ref":"#/$defs/hash"},
    "roleOutputHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "attemptCommitIntentHash":{"$ref":"#/$defs/hash"},
    "compatibilityCompletionHash":{"$ref":"#/$defs/hash"},
    "attemptId":{"type":"string","minLength":1},
    "provider":{"enum":["OPENAI_DIRECT","DEEPSEEK_DIRECT"]},
    "requestedModel":{"enum":["gpt-5.6-luna","deepseek-v4-pro"]},
    "observedModel":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
    "requestedEndpoint":{"enum":["https://us.api.openai.com/v1/responses","https://api.deepseek.com/chat/completions"]},
    "observedEndpoint":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
    "projectResidency":{"type":"string","minLength":1},
    "dataRegion":{"type":"string","minLength":1},
    "role":{"type":"string","minLength":1},
    "itemHash":{"$ref":"#/$defs/hash"},
    "itemIdPseudonym":{"type":"string","minLength":1},
    "attemptStatus":{"type":"string","minLength":1},
    "transportStatus":{"type":"string","minLength":1},
    "bodyReadStatus":{"enum":["COMPLETE","NOT_AVAILABLE"]},
    "parseStatus":{"type":"string","minLength":1},
    "schemaStatus":{"type":"string","minLength":1},
    "providerEventCount":{"enum":[0,1]},
    "httpRequestCount":{"enum":[0,1]},
    "credentialReadCount":{"enum":[0,1]},
    "inputTokens":{"$ref":"#/$defs/maybeInteger"},
    "outputTokens":{"$ref":"#/$defs/maybeInteger"},
    "reasoningTokens":{"$ref":"#/$defs/maybeInteger"},
    "totalTokens":{"$ref":"#/$defs/maybeInteger"},
    "estimatedCostUsd":{"type":"number","minimum":0},
    "rawResponseRetainedInProtectedStorage":{"const":true},
    "rawResponseIndependentlyReparsed":{"type":"boolean"},
    "commitIntentPersistedBeforeCompletion":{"const":true},
    "completionMatchesPreparedHash":{"const":true},
    "completedAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"maybeInteger":{"anyOf":[{"type":"integer","minimum":0},{"type":"null"}]}}
}
