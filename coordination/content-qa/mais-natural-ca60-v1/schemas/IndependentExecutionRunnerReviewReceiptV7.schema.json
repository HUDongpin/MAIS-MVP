{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/IndependentExecutionRunnerReviewReceiptV7.schema.json",
  "title":"IndependentExecutionRunnerReviewReceiptV7",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","runnerVersion","reviewedAt","decision","reviewerLane","independentImplementation","findingCount","reviewedRunnerRegistrationHash","reviewedRunnerRegistrationCommit","reviewedRunnerSourceCommit","reviewedProductionSourceRootHash","reviewedTestSourceRootHash","reviewedImportClosureRootHash","reviewedRemediatedFindingIds","verifierSourceTreeRoot","dependencyLockRoot","staticImportGraphHash","forbiddenPrimaryScorerPathScanHash","commandRuntimeHash","baselineCommit","recomputedRuntimeSourceEnumerationRootHash","independentSourceEnumerationReceiptHash","processEvidenceRootHash","reviewerIdentityAnchorHash","reviewerKeyId","reviewSignaturePayload","reviewSignaturePayloadHash","reviewSignatureBase64","reviewSignatureVerified","reviewCustodyPolicy","credentialReadCount","naturalQuestionReadCount","providerCallCount","naturalQuestionEgressCount","tokenCount","attemptCount","usdSpent","selfHash"],
  "properties":{
    "schemaVersion":{"const":"IndependentExecutionRunnerReviewReceiptV7"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "runnerVersion":{"const":"V5-R9"},
    "reviewedAt":{"type":"string","format":"date-time"},
