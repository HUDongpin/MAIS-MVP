    "reviewedRunnerRegistrationCommit":{"$ref":"#/$defs/commit"},
    "reviewedRunnerSourceCommit":{"$ref":"#/$defs/commit"},
    "reviewedProductionSourceRootHash":{"$ref":"#/$defs/hash"},
    "reviewedTestSourceRootHash":{"$ref":"#/$defs/hash"},
    "reviewedImportClosureRootHash":{"$ref":"#/$defs/hash"},
    "reviewedRemediatedFindingIds":{"type":"array","minItems":8,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^A11-R8-00[1-8]$"}},
    "verifierSourceTreeRoot":{"$ref":"#/$defs/hash"},
    "dependencyLockRoot":{"$ref":"#/$defs/hash"},
    "staticImportGraphHash":{"$ref":"#/$defs/hash"},
    "forbiddenPrimaryScorerPathScanHash":{"$ref":"#/$defs/hash"},
    "commandRuntimeHash":{"$ref":"#/$defs/hash"},
    "baselineCommit":{"$ref":"#/$defs/commit"},
    "recomputedRuntimeSourceEnumerationRootHash":{"$ref":"#/$defs/hash"},
    "independentSourceEnumerationReceiptHash":{"$ref":"#/$defs/hash"},
    "processEvidenceRootHash":{"$ref":"#/$defs/hash"},
    "reviewerIdentityAnchorHash":{"$ref":"#/$defs/hash"},
    "reviewerKeyId":{"type":"string","pattern":"^a11-v5-r9-fresh-review-ed25519-[0-9a-f]{16}$"},
    "reviewSignaturePayload":{"$ref":"#/$defs/signaturePayload"},
    "reviewSignaturePayloadHash":{"$ref":"#/$defs/hash"},
    "reviewSignatureBase64":{"type":"string","minLength":80,"maxLength":128,"pattern":"^[A-Za-z0-9+/]+={0,2}$"},
    "reviewSignatureVerified":{"const":true},
    "reviewCustodyPolicy":{"const":"PINNED_A11_ED25519_SIGNATURE_PLUS_GIT_OBJECT_SINGLE_ADD_WITH_EXACT_CLOSEOUT_PARENT_AND_RECOMPUTED_PROCESS_EVIDENCE"},
    "credentialReadCount":{"const":0},
    "naturalQuestionReadCount":{"const":0},
    "providerCallCount":{"const":0},
    "naturalQuestionEgressCount":{"const":0},
    "tokenCount":{"const":0},
    "attemptCount":{"const":0},
    "usdSpent":{"const":0},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "signaturePayload":{"type":"object","additionalProperties":false,"required":["schemaVersion","designId","runnerVersion","decision","findingCount","reviewedAt","reviewedRunnerRegistrationHash","reviewedRunnerRegistrationCommit","reviewedRunnerSourceCommit","reviewedProductionSourceRootHash","reviewedTestSourceRootHash","reviewedImportClosureRootHash","reviewedRemediatedFindingIds","processEvidenceRootHash","baselineCommit","recomputedRuntimeSourceEnumerationRootHash","reviewerIdentityAnchorHash","reviewerKeyId"],"properties":{"schemaVersion":{"const":"IndependentExecutionRunnerReviewSignaturePayloadV1"},"designId":{"const":"MAIS-NATURAL-CA60-V5"},"runnerVersion":{"const":"V5-R9"},"decision":{"enum":["CONCURRED","DISCREPANCY","UNREVIEWABLE"]},"findingCount":{"type":"integer","minimum":0},"reviewedAt":{"type":"string","format":"date-time"},"reviewedRunnerRegistrationHash":{"$ref":"#/$defs/hash"},"reviewedRunnerRegistrationCommit":{"$ref":"#/$defs/commit"},"reviewedRunnerSourceCommit":{"$ref":"#/$defs/commit"},"reviewedProductionSourceRootHash":{"$ref":"#/$defs/hash"},"reviewedTestSourceRootHash":{"$ref":"#/$defs/hash"},"reviewedImportClosureRootHash":{"$ref":"#/$defs/hash"},"reviewedRemediatedFindingIds":{"type":"array","minItems":8,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^A11-R8-00[1-8]$"}},"processEvidenceRootHash":{"$ref":"#/$defs/hash"},"baselineCommit":{"$ref":"#/$defs/commit"},"recomputedRuntimeSourceEnumerationRootHash":{"$ref":"#/$defs/hash"},"reviewerIdentityAnchorHash":{"$ref":"#/$defs/hash"},"reviewerKeyId":{"type":"string","minLength":1}}}
  }
}
