{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/content-qa/ProtectedExecutionCustodyRegistryV1.schema.json",
  "title": "ProtectedExecutionCustodyRegistryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "designId",
    "designRegistrationHash",
    "runnerCommit",
    "runnerSourceManifest",
    "runnerSourceManifestRootHash",
    "runnerHash",
    "adapterHash",
    "protectedArtifactRoot",
    "providerExecutionAuthorized",
    "aggregatePublicationAuthorized",
    "createdAt",
    "previousRegistryHash",
    "registryHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ProtectedExecutionCustodyRegistryV1"
    },
    "designId": {
      "const": "MAIS-NATURAL-CA60-V4"
    },
    "designRegistrationHash": {
      "$ref": "#/$defs/sha256"
    },
    "runnerCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "runnerSourceManifest": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceRow"
      }
    },
    "runnerSourceManifestRootHash": {
      "$ref": "#/$defs/sha256"
    },
    "runnerHash": {
      "$ref": "#/$defs/sha256"
    },
    "adapterHash": {
      "$ref": "#/$defs/nullableSha256"
    },
    "protectedArtifactRoot": {
      "type": "string",
      "pattern": "^/.+/.local/mais-natural-ca60-v1$"
    },
    "providerExecutionAuthorized": {
      "const": false
    },
    "aggregatePublicationAuthorized": {
      "const": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "previousRegistryHash": {
      "$ref": "#/$defs/nullableSha256"
    },
    "registryHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000]+$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
