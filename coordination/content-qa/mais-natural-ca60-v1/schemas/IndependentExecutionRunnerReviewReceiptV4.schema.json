{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/IndependentExecutionRunnerReviewReceiptV4.schema.json",
  "title":"IndependentExecutionRunnerReviewReceiptV4",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","runnerVersion","reviewedAt","decision","reviewerLane","independentImplementation","findingCount","reviewedRunnerRegistrationHash","reviewedRunnerRegistrationCommit","reviewedRunnerSourceCommit","reviewedProductionSourceRootHash","reviewedTestSourceRootHash","reviewedImportClosureRootHash","selfHash"],
  "properties":{
    "schemaVersion":{"const":"IndependentExecutionRunnerReviewReceiptV4"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "runnerVersion":{"const":"V5-R6"},
    "reviewedAt":{"type":"string","format":"date-time"},
    "decision":{"enum":["CONCURRED","DISCREPANCY","UNREVIEWABLE"]},
    "reviewerLane":{"const":"A11"},
    "independentImplementation":{"const":true},
    "findingCount":{"type":"integer","minimum":0},
    "reviewedRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "reviewedRunnerRegistrationCommit":{"$ref":"#/$defs/commit"},
    "reviewedRunnerSourceCommit":{"$ref":"#/$defs/commit"},
    "reviewedProductionSourceRootHash":{"$ref":"#/$defs/hash"},
    "reviewedTestSourceRootHash":{"$ref":"#/$defs/hash"},
    "reviewedImportClosureRootHash":{"$ref":"#/$defs/hash"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "allOf":[
    {"if":{"properties":{"decision":{"const":"CONCURRED"}},"required":["decision"]},"then":{"properties":{"findingCount":{"const":0}}}},
    {"if":{"properties":{"decision":{"const":"DISCREPANCY"}},"required":["decision"]},"then":{"properties":{"findingCount":{"minimum":1}}}}
  ],
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"}}
}
