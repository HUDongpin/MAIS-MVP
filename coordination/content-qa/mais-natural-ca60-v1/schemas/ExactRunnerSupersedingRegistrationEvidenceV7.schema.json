{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.local/schemas/ExactRunnerSupersedingRegistrationEvidenceV7.schema.json",
  "title": "ExactRunnerSupersedingRegistrationEvidenceV7",
