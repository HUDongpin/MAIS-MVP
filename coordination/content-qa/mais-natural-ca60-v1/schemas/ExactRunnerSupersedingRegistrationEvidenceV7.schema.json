    "runnerSourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "productionSourceRootHash": {
      "$ref": "#/$defs/hash"
    },
    "testSourceRootHash": {
      "$ref": "#/$defs/hash"
    },
    "importClosureRootHash": {
      "$ref": "#/$defs/hash"
    },
    "runtimeSourceEnumerationRootHash": {
      "$ref": "#/$defs/hash"
    },
    "supersededRunnerRegistrationHash": {
      "const": "99b298b415d42756e8c3cc9b513e0b5ef6b33c8fe184ba98247fccc9eca8d9ed"
    },
    "supersededRunnerCloseoutCommit": {
      "const": "39f5a607dd64d71b18f1ce2cfd904a3c440977b0"
    },
    "discrepancyReviewHash": {
      "const": "e8aeaf8b5d4567a5e2f936baacea0ecd64487a00ab976a9f3106e35869ef9bde"
    },
