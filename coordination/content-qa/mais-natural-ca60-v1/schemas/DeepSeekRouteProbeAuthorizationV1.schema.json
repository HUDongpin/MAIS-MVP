{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/content-qa/DeepSeekRouteProbeAuthorizationV1.schema.json",
  "title": "DeepSeekRouteProbeAuthorizationV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authorizationKind", "designId", "registrationHash", "runnerRegistrationHash", "referenceSealHash", "referenceAttemptChainHash", "provider", "endpoint", "model", "containsNaturalQuestionTextAuthorized", "credentialReadAuthorized", "providerCallAuthorized", "maximumAttempts", "maximumTokens", "maximumEstimatedUsd", "currency", "issuedAt", "expiresAt", "authorizedBy", "ownerGrantHash", "authorizationHash"],
  "properties": {
    "schemaVersion": { "const": "DeepSeekRouteProbeAuthorizationV1" },
    "authorizationKind": { "const": "DEEPSEEK_ROUTE_PROBE" },
    "designId": { "const": "MAIS-NATURAL-CA60-V5" },
    "registrationHash": { "$ref": "#/$defs/sha256" },
    "runnerRegistrationHash": { "$ref": "#/$defs/sha256" },
    "referenceSealHash": { "$ref": "#/$defs/sha256" },
    "referenceAttemptChainHash": { "$ref": "#/$defs/sha256" },
    "provider": { "const": "DEEPSEEK_DIRECT" },
    "endpoint": { "const": "https://api.deepseek.com/chat/completions" },
    "model": { "const": "deepseek-v4-pro" },
    "containsNaturalQuestionTextAuthorized": { "const": false },
    "credentialReadAuthorized": { "const": true },
    "providerCallAuthorized": { "const": true },
    "maximumAttempts": { "const": 1 },
    "maximumTokens": { "type": "integer", "minimum": 1, "maximum": 256 },
    "maximumEstimatedUsd": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.1 },
    "currency": { "const": "USD" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "authorizedBy": { "type": "string", "minLength": 1 },
    "ownerGrantHash": { "$ref": "#/$defs/sha256" },
    "authorizationHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
