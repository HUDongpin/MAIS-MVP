{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/AuthenticatedRouteEvidenceReceiptV2.schema.json",
  "title":"AuthenticatedRouteEvidenceReceiptV2",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","provider","model","endpoint","projectResidency","dataRegion","subjectIdentityHash","directBillingConfirmed","routeProbeConfirmed","routeProbeContainsNaturalQuestionText","priceCurrency","inputUsdPerMillionTokens","outputUsdPerMillionTokens","captures","captureSetHash","rawSourceArtifacts","rawSourceArtifactSetHash","provenanceStatus","validatedAt","authorizationEligibility","selfHash"],
  "properties":{
    "schemaVersion":{"const":"AuthenticatedRouteEvidenceReceiptV2"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "provider":{"enum":["OPENAI_DIRECT","DEEPSEEK_DIRECT"]},
    "model":{"enum":["gpt-5.6-luna","deepseek-v4-pro"]},
    "endpoint":{"enum":["https://us.api.openai.com/v1/responses","https://api.deepseek.com/chat/completions"]},
    "projectResidency":{"type":"string","minLength":2},
    "dataRegion":{"type":"string","minLength":2},
    "subjectIdentityHash":{"$ref":"#/$defs/hash"},
    "directBillingConfirmed":{"const":true},
    "routeProbeConfirmed":{"const":true},
    "routeProbeContainsNaturalQuestionText":{"const":false},
    "priceCurrency":{"const":"USD"},
    "inputUsdPerMillionTokens":{"type":"number","exclusiveMinimum":0},
    "outputUsdPerMillionTokens":{"type":"number","exclusiveMinimum":0},
    "captures":{"type":"array","minItems":5,"maxItems":5,"items":{"type":"object"}},
    "captureSetHash":{"$ref":"#/$defs/hash"},
    "rawSourceArtifacts":{"type":"array","minItems":5,"maxItems":5,"items":{"type":"object"}},
    "rawSourceArtifactSetHash":{"$ref":"#/$defs/hash"},
    "provenanceStatus":{"const":"EXTERNALLY_ATTESTED_AND_REPLAYABLE"},
    "validatedAt":{"type":"string","format":"date-time"},
    "authorizationEligibility":{"const":"ELIGIBLE_PENDING_SEPARATE_OWNER_PROVIDER_GRANT"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
