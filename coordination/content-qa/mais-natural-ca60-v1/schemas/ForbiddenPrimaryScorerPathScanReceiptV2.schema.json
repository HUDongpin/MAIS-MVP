{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/ForbiddenPrimaryScorerPathScanReceiptV2.schema.json",
  "title":"ForbiddenPrimaryScorerPathScanReceiptV2",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","runnerVersion","verifierSourceTreeRoot","forbiddenPathPatterns","scannedPathCount","forbiddenPathMatchCount","matchedPaths","derivedAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"ForbiddenPrimaryScorerPathScanReceiptV2"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "runnerVersion":{"const":"V5-R11"},
    "verifierSourceTreeRoot":{"$ref":"#/$defs/hash"},
    "forbiddenPathPatterns":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "scannedPathCount":{"type":"integer","minimum":1},
    "forbiddenPathMatchCount":{"const":0},
    "matchedPaths":{"type":"array","maxItems":0},
    "derivedAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
