{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/ProviderAttemptCommitIntentV1.schema.json",
  "title":"ProviderAttemptCommitIntentV1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","authorizationHash","attemptId","provider","role","itemHash","requestArtifactHash","dispatchAuditHash","reservationHash","dispatchPermitHash","compatibilityDispatchPermitHash","rawResponseArtifactHash","rawResponseBindingReceiptHash","providerEventReceiptHash","roleOutputHash","preparedCompletionHash","attemptStatus","rawAndBindingDurable","preparedCompletionNotYetCommitted","preparedAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"ProviderAttemptCommitIntentV1"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "authorizationHash":{"$ref":"#/$defs/hash"},
    "attemptId":{"type":"string","minLength":1},
    "provider":{"enum":["OPENAI_DIRECT","DEEPSEEK_DIRECT"]},
    "role":{"type":"string","minLength":1},
    "itemHash":{"$ref":"#/$defs/hash"},
    "requestArtifactHash":{"$ref":"#/$defs/hash"},
    "dispatchAuditHash":{"$ref":"#/$defs/hash"},
    "reservationHash":{"$ref":"#/$defs/hash"},
    "dispatchPermitHash":{"$ref":"#/$defs/hash"},
    "compatibilityDispatchPermitHash":{"$ref":"#/$defs/hash"},
    "rawResponseArtifactHash":{"$ref":"#/$defs/hash"},
    "rawResponseBindingReceiptHash":{"$ref":"#/$defs/hash"},
    "providerEventReceiptHash":{"$ref":"#/$defs/hash"},
    "roleOutputHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "preparedCompletionHash":{"$ref":"#/$defs/hash"},
    "attemptStatus":{"type":"string","minLength":1},
    "rawAndBindingDurable":{"const":true},
    "preparedCompletionNotYetCommitted":{"const":true},
    "preparedAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
