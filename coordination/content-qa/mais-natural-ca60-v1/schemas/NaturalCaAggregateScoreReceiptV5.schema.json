{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/NaturalCaAggregateScoreReceiptV5.schema.json",
  "title":"NaturalCaAggregateScoreReceiptV5",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","sampleExecutionInventoryHash","referenceSealHash","executionRegistrationHash","c0ExecutionSetHash","deepSeekAttemptGraphReceiptHash","semanticDispatchVerificationReceiptHash","scoringInputHash","baseAggregateScoreReceiptHash","completeItemCount","missingItemCount","analysisStatus","overallDecision","decisionCeiling","claimCeiling","passClaimAllowed","limitedGeneralizationEvidenceAllowed","missingDataImputedAsNegative","verificationMode","scoredAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"NaturalCaAggregateScoreReceiptV5"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "sampleExecutionInventoryHash":{"$ref":"#/$defs/hash"},
    "referenceSealHash":{"$ref":"#/$defs/hash"},
    "executionRegistrationHash":{"$ref":"#/$defs/hash"},
    "c0ExecutionSetHash":{"$ref":"#/$defs/hash"},
    "deepSeekAttemptGraphReceiptHash":{"$ref":"#/$defs/hash"},
    "semanticDispatchVerificationReceiptHash":{"$ref":"#/$defs/hash"},
    "scoringInputHash":{"$ref":"#/$defs/hash"},
    "baseAggregateScoreReceiptHash":{"$ref":"#/$defs/hash"},
    "completeItemCount":{"type":"integer","minimum":0,"maximum":60},
    "missingItemCount":{"type":"integer","minimum":0,"maximum":60},
    "analysisStatus":{"enum":["INCOMPLETE_EXECUTION_NO_METRIC_INFERENCE","COMPLETE_FROZEN_METRIC_ANALYSIS"]},
    "overallDecision":{"enum":["INVALID_FOR_GENERALIZATION","EXECUTION_INTEGRITY_FAILED","POLICY_REVISION_REQUIRED_MACHINE_REFERENCE","INCONCLUSIVE_MACHINE_REFERENCE"]},
    "decisionCeiling":{"const":"INCONCLUSIVE_MACHINE_REFERENCE"},
    "claimCeiling":{"const":"CALIFORNIA_RUNTIME_EGRESS_ELIGIBLE_MACHINE_REFERENCE_PILOT_ONLY"},
    "passClaimAllowed":{"const":false},
    "limitedGeneralizationEvidenceAllowed":{"const":false},
    "missingDataImputedAsNegative":{"const":false},
    "verificationMode":{"const":"READ_ONLY_FULL_SCORING_INPUT_MATCHING_METRIC_INTERVAL_AND_DECISION_RECONSTRUCTION"},
    "scoredAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
