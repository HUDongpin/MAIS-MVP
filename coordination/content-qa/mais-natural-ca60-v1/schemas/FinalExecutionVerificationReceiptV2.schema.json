{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/FinalExecutionVerificationReceiptV2.schema.json",
  "title":"FinalExecutionVerificationReceiptV2",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","sampleExecutionInventoryHash","referenceSealHash","executionRegistrationHash","c0ExecutionSetHash","aggregateScoreReceiptHash","referenceAttemptChainHash","deepSeekAttemptChainHash","requestArtifactRootHash","dispatchAuditRootHash","itemResultSetHash","completedItemMarkerRootHash","referenceLabelCount","naturalQuestionResultCount","executionIntegrityDisposition","validationStatus","overallDecision","decisionCeiling","passClaimAllowed","limitedGeneralizationEvidenceAllowed","verifiedAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"FinalExecutionVerificationReceiptV2"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "sampleExecutionInventoryHash":{"$ref":"#/$defs/hash"},
    "referenceSealHash":{"$ref":"#/$defs/hash"},
    "executionRegistrationHash":{"$ref":"#/$defs/hash"},
    "c0ExecutionSetHash":{"$ref":"#/$defs/hash"},
    "aggregateScoreReceiptHash":{"$ref":"#/$defs/hash"},
    "referenceAttemptChainHash":{"$ref":"#/$defs/hash"},
    "deepSeekAttemptChainHash":{"$ref":"#/$defs/hash"},
    "requestArtifactRootHash":{"$ref":"#/$defs/hash"},
    "dispatchAuditRootHash":{"$ref":"#/$defs/hash"},
    "itemResultSetHash":{"$ref":"#/$defs/hash"},
    "completedItemMarkerRootHash":{"$ref":"#/$defs/hash"},
    "referenceLabelCount":{"const":60},
    "naturalQuestionResultCount":{"type":"integer","minimum":0,"maximum":60},
    "executionIntegrityDisposition":{"enum":["INTACT_PENDING_FROZEN_METRIC_DECISION","INVALID_FOR_GENERALIZATION","EXECUTION_INTEGRITY_FAILED"]},
    "validationStatus":{"const":"FULL_AUTHORITATIVE_R5_CHAIN_RECOMPUTED"},
    "overallDecision":{"enum":["INVALID_FOR_GENERALIZATION","EXECUTION_INTEGRITY_FAILED","POLICY_REVISION_REQUIRED_MACHINE_REFERENCE","INCONCLUSIVE_MACHINE_REFERENCE"]},
    "decisionCeiling":{"const":"INCONCLUSIVE_MACHINE_REFERENCE"},
    "passClaimAllowed":{"const":false},
    "limitedGeneralizationEvidenceAllowed":{"const":false},
    "verifiedAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
