    "completeFrameProtected",
    "originalItemIdsProtected",
    "naturalQuestionTextPublished",
    "formalFrameFrozen",
    "formalSampleFrozen",
    "c0RandomAuditFrozen",
    "protectedCustodyManifestHash",
