    "questionEgressAuthorizedNow",
    "providerExecutionAuthorized",
    "credentialReadAuthorized",
    "tokenAuthorizationCreated",
    "attemptAuthorizationCreated",
    "usdAuthorizationCreated",
    "providerRequestCount",
    "credentialReadCount",
    "naturalQuestionEgressCount",
    "naturalQuestionResultCount",
    "firstProviderExecutionAllowed",
    "decisionCeiling",
    "claimCeiling",
    "formalFreezeReceiptHash"
  ],
  "properties": {
    "schemaVersion": { "const": "NaturalCaFormalFreezeReceiptV1" },
    "artifactKind": { "const": "OFFLINE_FRAME_AND_SAMPLE_FREEZE_NOT_PROVIDER_AUTHORIZATION" },
    "designId": { "const": "MAIS-NATURAL-CA60-V5" },
    "registrationHash": { "const": "e240f1fb1af588fb3dbf085b8f57af1c41635bdb8576be8019838d4512fa0632" },
    "activationReceiptHash": { "$ref": "#/$defs/sha256" },
    "ownerDecisionRequestHash": { "const": "2d0e8c24f270aa39292fea1ef8d1d11c4e9bd5d9ecd1bdf5a5bbf5119b964f78" },
    "ownerDecisionReceiptHash": { "const": "855af9696548359bc7364a987aa0dc3a3f9cd5883f87911edd8067bc78ac3ad0" },
    "rightsPolicyHash": { "const": "c7f2832a701d813e928f1fa34f1b74d1d26a62c96f5bdea8be58d8bff134fe66" },
    "lineageRuleHash": { "const": "8130bcd70f3e42332478a284b5a5b54e0c73b9f3696b1c1c06f25254ea0fe449" },
    "sourceEnumerationHashErratumHash": { "const": "d4050ab3070985dd4689dda4f51f44cf1d2f5f8f286cc548ac98919c8e8b540d" },
    "inheritedSourceEnumerationMethodContractHash": { "const": "050572da562fba695e6ff654c50fb0810a0ac60028779decad005fb016b20f61" },
