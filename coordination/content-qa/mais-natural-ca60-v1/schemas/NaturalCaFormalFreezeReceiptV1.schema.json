    "dualRootErratumBound": { "const": true },
    "approvedReadinessReceiptHash": { "$ref": "#/$defs/sha256" },
    "a22ReadinessEnvironmentReceiptHash": { "$ref": "#/$defs/sha256" },
    "a11ReadinessReviewHash": { "$ref": "#/$defs/sha256" },
    "approvedReadinessSourceCommit": { "$ref": "#/$defs/gitOid" },
    "sourceCommit": { "$ref": "#/$defs/gitOid" },
    "runnerCommit": { "$ref": "#/$defs/gitOid" },
    "runnerHash": { "$ref": "#/$defs/sha256" },
    "sourceClosureParityHash": { "$ref": "#/$defs/sha256" },
    "runtimeConfigHash": { "$ref": "#/$defs/sha256" },
    "runtimeInventoryRootHash": { "$ref": "#/$defs/sha256" },
    "approvedPotentialEligibleContentRootHash": { "const": "58de40eb4db30ec717aa0758fb3aba8b88e63a2e66f24941fcbc47c9193e9ea3" },
    "approvedPotentialEligibleClusterSetHash": { "const": "58da62ff9d7d17819dd93672ecf761362554d084b9d030f158dfd4932cf7e9d9" },
    "sourceModuleManifestHash": { "$ref": "#/$defs/sha256" },
    "sourceModuleHash": { "$ref": "#/$defs/sha256" },
    "routeExecutionTrustRootHash": { "$ref": "#/$defs/sha256" },
    "dependencyClosureTrustRootHash": { "$ref": "#/$defs/sha256" },
    "scannerExecutionReceiptInventoryHash": { "$ref": "#/$defs/sha256" },
    "rightsDecisionTableHash": { "$ref": "#/$defs/sha256" },
    "runtimeExtractionSnapshotHash": { "$ref": "#/$defs/sha256" },
    "clusterAuditHash": { "$ref": "#/$defs/sha256" },
    "frameRegistrationHash": { "$ref": "#/$defs/sha256" },
    "samplingFrameHash": { "$ref": "#/$defs/sha256" },
    "frameSelectionContentRootHash": { "$ref": "#/$defs/sha256" },
    "frameRowCount": { "const": 2802 },
    "eligibleRowCount": { "const": 482 },
    "excludedRowCount": { "const": 2320 },
    "eligibleClusterCount": { "const": 106 },
    "singletonCount": { "type": "integer", "minimum": 0, "maximum": 106 },
    "singletonRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "componentSizeDistribution": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/componentSizeBucket" }
    },
    "largest20ComponentSizes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "integer", "minimum": 1 }
    },
    "crossCellComponentCount": { "type": "integer", "minimum": 0 },
    "clusterAnomalyCount": { "const": 0 },
    "sampleManifestHash": { "$ref": "#/$defs/sha256" },
    "sampleManifestTupleRootHash": { "$ref": "#/$defs/sha256" },
    "sampleSelectionContentRootHash": { "$ref": "#/$defs/sha256" },
    "sampleClusterCount": { "const": 60 },
    "sampleStratumAllocations": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/sampleAllocation" }
    },
    "sampleSecondaryWeightSummary": { "$ref": "#/$defs/weightSummary" },
    "selectedPublicRows": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/publicSelectionRow" }
    },
    "selectedPublicRowsRootHash": { "$ref": "#/$defs/sha256" },
    "c0RandomAuditHash": { "$ref": "#/$defs/sha256" },
    "c0SelectedCount": { "const": 12 },
    "c0PublicRows": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/publicSelectionRow" }
    },
    "c0PublicRowsRootHash": { "$ref": "#/$defs/sha256" },
    "frameFrozenAt": { "$ref": "#/$defs/timestamp" },
    "sampleFrozenAt": { "$ref": "#/$defs/timestamp" },
    "c0FrozenAt": { "$ref": "#/$defs/timestamp" },
    "completeFrameProtected": { "const": true },
    "originalItemIdsProtected": { "const": true },
    "naturalQuestionTextPublished": { "const": false },
    "formalFrameFrozen": { "const": true },
    "formalSampleFrozen": { "const": true },
    "c0RandomAuditFrozen": { "const": true },
    "protectedCustodyManifestHash": { "$ref": "#/$defs/sha256" },
    "protectedCustodyBound": { "const": true },
    "questionEgressAuthorizedNow": { "const": false },
    "providerExecutionAuthorized": { "const": false },
    "credentialReadAuthorized": { "const": false },
    "tokenAuthorizationCreated": { "const": false },
    "attemptAuthorizationCreated": { "const": false },
    "usdAuthorizationCreated": { "const": false },
    "providerRequestCount": { "const": 0 },
    "credentialReadCount": { "const": 0 },
    "naturalQuestionEgressCount": { "const": 0 },
    "naturalQuestionResultCount": { "const": 0 },
    "firstProviderExecutionAllowed": { "const": false },
    "decisionCeiling": { "const": "INCONCLUSIVE_MACHINE_REFERENCE" },
    "claimCeiling": { "const": "FRAME_AND_SAMPLE_FROZEN_NOT_EXECUTED" },
    "formalFreezeReceiptHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitOid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "stratum": { "type": "string", "pattern": "^(multiple-choice|fill-in|short-answer)::(Low|Medium|High)$" },
    "componentSizeBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligibleItemCount", "componentCount"],
      "properties": {
        "eligibleItemCount": { "type": "integer", "minimum": 1 },
        "componentCount": { "type": "integer", "minimum": 1 }
      }
    },
    "sampleAllocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stratum", "responseForm", "difficulty", "eligibleClusterCount", "executionEligibleClusterCount", "baseMinimumAllocation", "finalAllocation"],
      "properties": {
        "stratum": { "$ref": "#/$defs/stratum" },
        "responseForm": { "enum": ["multiple-choice", "fill-in", "short-answer"] },
        "difficulty": { "enum": ["Low", "Medium", "High"] },
        "eligibleClusterCount": { "type": "integer", "minimum": 0 },
        "executionEligibleClusterCount": { "type": "integer", "minimum": 0 },
        "baseMinimumAllocation": { "type": "integer", "minimum": 0, "maximum": 2 },
        "finalAllocation": { "type": "integer", "minimum": 0, "maximum": 60 }
      }
    },
    "weightSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemCount", "sumWeights", "sumSquaredWeights", "kishEffectiveSampleSize"],
      "properties": {
        "itemCount": { "const": 60 },
        "sumWeights": { "type": "number", "exclusiveMinimum": 0 },
        "sumSquaredWeights": { "type": "number", "exclusiveMinimum": 0 },
        "kishEffectiveSampleSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 }
      }
    },
    "publicSelectionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemIdPseudonym", "itemHash", "homologyClusterHash", "stratum", "selectionDigest"],
      "properties": {
        "itemIdPseudonym": { "type": "string", "pattern": "^ca60-[0-9a-f]{32}$" },
        "itemHash": { "$ref": "#/$defs/sha256" },
        "homologyClusterHash": { "$ref": "#/$defs/sha256" },
        "stratum": { "$ref": "#/$defs/stratum" },
        "selectionDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
