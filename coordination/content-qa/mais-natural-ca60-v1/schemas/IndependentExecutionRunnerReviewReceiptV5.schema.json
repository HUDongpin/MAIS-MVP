{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/IndependentExecutionRunnerReviewReceiptV5.schema.json",
  "title":"IndependentExecutionRunnerReviewReceiptV5",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","runnerVersion","reviewedAt","decision","reviewerLane","independentImplementation","findingCount","reviewedRunnerRegistrationHash","reviewedRunnerRegistrationCommit","reviewedRunnerSourceCommit","reviewedProductionSourceRootHash","reviewedTestSourceRootHash","reviewedImportClosureRootHash","reviewedRemediatedFindingIds","credentialReadCount","naturalQuestionReadCount","providerCallCount","naturalQuestionEgressCount","tokenCount","attemptCount","usdSpent","selfHash"],
  "properties":{
    "schemaVersion":{"const":"IndependentExecutionRunnerReviewReceiptV5"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "runnerVersion":{"const":"V5-R7"},
    "reviewedAt":{"type":"string","format":"date-time"},
    "decision":{"enum":["CONCURRED","DISCREPANCY","UNREVIEWABLE"]},
    "reviewerLane":{"const":"A11"},
    "independentImplementation":{"const":true},
    "findingCount":{"type":"integer","minimum":0},
    "reviewedRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "reviewedRunnerRegistrationCommit":{"$ref":"#/$defs/commit"},
    "reviewedRunnerSourceCommit":{"$ref":"#/$defs/commit"},
    "reviewedProductionSourceRootHash":{"$ref":"#/$defs/hash"},
    "reviewedTestSourceRootHash":{"$ref":"#/$defs/hash"},
    "reviewedImportClosureRootHash":{"$ref":"#/$defs/hash"},
    "reviewedRemediatedFindingIds":{"type":"array","minItems":11,"maxItems":11,"uniqueItems":true,"items":{"type":"string","pattern":"^A11-R6-0(?:0[1-9]|1[01])$"}},
    "credentialReadCount":{"const":0},
    "naturalQuestionReadCount":{"const":0},
    "providerCallCount":{"const":0},
    "naturalQuestionEgressCount":{"const":0},
    "tokenCount":{"const":0},
    "attemptCount":{"const":0},
    "usdSpent":{"const":0},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"}}
}
