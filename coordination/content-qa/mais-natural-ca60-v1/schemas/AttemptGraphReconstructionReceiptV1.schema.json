{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/AttemptGraphReconstructionReceiptV1.schema.json",
  "title":"AttemptGraphReconstructionReceiptV1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","authorizationHash","sampleExecutionInventoryHash","provider","ledgerEntryRootHash","ledgerTerminalHash","requestArtifactRootHash","dispatchAuditRootHash","semanticDispatchAuthorityRootHash","rawResponseArtifactRootHash","rawResponseBindingRootHash","attemptCommitIntentRootHash","resolvedAttemptReceiptRootHash","roleAttemptEvidenceRootHash","roleAttemptEvidenceReceipts","reservationCount","completionCount","resolvedAttemptCount","successfulAttemptCount","failedAttemptCount","activeReservationCount","rawReparseFailureCount","lineageErrorCount","lineageErrors","graphStatus","derivedAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"AttemptGraphReconstructionReceiptV1"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "authorizationHash":{"$ref":"#/$defs/hash"},
    "sampleExecutionInventoryHash":{"$ref":"#/$defs/hash"},
    "provider":{"enum":["OPENAI_DIRECT","DEEPSEEK_DIRECT"]},
    "ledgerEntryRootHash":{"$ref":"#/$defs/hash"},
    "ledgerTerminalHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "requestArtifactRootHash":{"$ref":"#/$defs/hash"},
    "dispatchAuditRootHash":{"$ref":"#/$defs/hash"},
    "semanticDispatchAuthorityRootHash":{"$ref":"#/$defs/hash"},
    "rawResponseArtifactRootHash":{"$ref":"#/$defs/hash"},
    "rawResponseBindingRootHash":{"$ref":"#/$defs/hash"},
    "attemptCommitIntentRootHash":{"$ref":"#/$defs/hash"},
    "resolvedAttemptReceiptRootHash":{"$ref":"#/$defs/hash"},
    "roleAttemptEvidenceRootHash":{"$ref":"#/$defs/hash"},
    "roleAttemptEvidenceReceipts":{"type":"array","maxItems":850,"items":{"$ref":"#/$defs/roleAttempt"}},
    "reservationCount":{"type":"integer","minimum":0,"maximum":850},
    "completionCount":{"type":"integer","minimum":0,"maximum":850},
    "resolvedAttemptCount":{"type":"integer","minimum":0,"maximum":850},
    "successfulAttemptCount":{"type":"integer","minimum":0,"maximum":420},
    "failedAttemptCount":{"type":"integer","minimum":0,"maximum":850},
    "activeReservationCount":{"type":"integer","minimum":0,"maximum":4},
    "rawReparseFailureCount":{"type":"integer","minimum":0,"maximum":850},
    "lineageErrorCount":{"type":"integer","minimum":0},
    "lineageErrors":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "graphStatus":{"enum":["COMPLETE_VALID","INCOMPLETE_OR_INVALID"]},
    "derivedAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "roleAttempt":{
      "type":"object",
      "additionalProperties":false,
      "required":["schemaVersion","designId","activeRunnerRegistrationHash","authorizationHash","compatibilityAuthorizationHash","sampleExecutionInventoryHash","attemptId","provider","role","itemHash","itemIdPseudonym","attemptStatus","requestArtifactHash","compatibilityRequestArtifactHash","dispatchAuditHash","semanticDispatchAuthorityHash","reservationHash","dispatchPermitHash","compatibilityDispatchPermitHash","rawResponseArtifactHash","rawResponseBindingReceiptHash","providerEventReceiptHash","roleOutputHash","completionHash","resolvedAttemptReceiptHash","attemptCommitIntentHash","rawResponseReparsed","lineageRebuilt","naturalQuestionReferenceInputCount","derivedAt","selfHash"],
      "properties":{
        "schemaVersion":{"const":"RoleAttemptEvidenceReceiptV1"},
        "designId":{"const":"MAIS-NATURAL-CA60-V5"},
        "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
        "authorizationHash":{"$ref":"#/$defs/hash"},
        "compatibilityAuthorizationHash":{"$ref":"#/$defs/hash"},
        "sampleExecutionInventoryHash":{"$ref":"#/$defs/hash"},
        "attemptId":{"type":"string","minLength":1},
        "provider":{"enum":["OPENAI_DIRECT","DEEPSEEK_DIRECT"]},
        "role":{"type":"string","minLength":1},
        "itemHash":{"$ref":"#/$defs/hash"},
        "itemIdPseudonym":{"type":"string","minLength":1},
        "attemptStatus":{"type":"string","minLength":1},
        "requestArtifactHash":{"$ref":"#/$defs/hash"},
        "compatibilityRequestArtifactHash":{"$ref":"#/$defs/hash"},
        "dispatchAuditHash":{"$ref":"#/$defs/hash"},
        "semanticDispatchAuthorityHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
        "reservationHash":{"$ref":"#/$defs/hash"},
        "dispatchPermitHash":{"$ref":"#/$defs/hash"},
        "compatibilityDispatchPermitHash":{"$ref":"#/$defs/hash"},
        "rawResponseArtifactHash":{"$ref":"#/$defs/hash"},
        "rawResponseBindingReceiptHash":{"$ref":"#/$defs/hash"},
        "providerEventReceiptHash":{"$ref":"#/$defs/hash"},
        "roleOutputHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
        "completionHash":{"$ref":"#/$defs/hash"},
        "resolvedAttemptReceiptHash":{"$ref":"#/$defs/hash"},
        "attemptCommitIntentHash":{"$ref":"#/$defs/hash"},
        "rawResponseReparsed":{"type":"boolean"},
        "lineageRebuilt":{"const":true},
        "naturalQuestionReferenceInputCount":{"type":"integer","minimum":0},
        "derivedAt":{"type":"string","format":"date-time"},
        "selfHash":{"$ref":"#/$defs/hash"}
      }
    }
  }
}
