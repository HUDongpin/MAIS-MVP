{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/ProviderRawResponseBindingReceiptV1.schema.json",
  "title":"ProviderRawResponseBindingReceiptV1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","attemptId","rawResponseArtifactHash","rawResponseBodyHash","providerEventReceiptHash","roleOutputHash","parsedPayloadHash","parserVersion","parserImplementationHash","independentReparseVerified","boundAt","selfHash"],
