{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/FinalEvaluationReceiptV2.schema.json",
  "title":"FinalEvaluationReceiptV2",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","sampleExecutionInventoryHash","referenceSealHash","executionRegistrationHash","deepSeekAuthorizationHash","c0ExecutionSetHash","itemResultSetHash","completedItemMarkerRootHash","observedLedgerHash","counterfactualLedgerHash","metricInputLedgerHash","itemResultCount","completedItemMarkerCount","accounting","confusionMatrix","metricResults","metricOutputCount","statisticalKernel","executionIntegrity","invalidationCauseCodes","analysisStatus","overallDecision","decisionCeiling","claimCeiling","passClaimAllowed","limitedGeneralizationEvidenceAllowed","missingDataImputedAsNegative","scoredAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"FinalEvaluationReceiptV2"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "sampleExecutionInventoryHash":{"$ref":"#/$defs/hash"},
    "referenceSealHash":{"$ref":"#/$defs/hash"},
    "executionRegistrationHash":{"$ref":"#/$defs/hash"},
    "deepSeekAuthorizationHash":{"$ref":"#/$defs/hash"},
    "c0ExecutionSetHash":{"$ref":"#/$defs/hash"},
    "itemResultSetHash":{"$ref":"#/$defs/hash"},
    "completedItemMarkerRootHash":{"$ref":"#/$defs/hash"},
    "observedLedgerHash":{"$ref":"#/$defs/hash"},
    "counterfactualLedgerHash":{"$ref":"#/$defs/hash"},
    "metricInputLedgerHash":{"$ref":"#/$defs/hash"},
    "itemResultCount":{"const":60},
    "completedItemMarkerCount":{"type":"integer","minimum":0,"maximum":60},
    "accounting":{"type":"object"},
    "confusionMatrix":{"type":"object"},
    "metricResults":{"anyOf":[{"type":"array","minItems":11,"maxItems":11},{"type":"null"}]},
    "metricOutputCount":{"enum":[0,11]},
    "statisticalKernel":{"type":"object"},
    "executionIntegrity":{"type":"object"},
    "invalidationCauseCodes":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "analysisStatus":{"enum":["COMPLETE_FROZEN_METRIC_ANALYSIS","INVALID_NO_METRIC_INFERENCE","TERMINAL_INTEGRITY_DECISION_NO_METRIC_INFERENCE"]},
    "overallDecision":{"$ref":"#/$defs/decision"},
    "decisionCeiling":{"const":"INCONCLUSIVE_MACHINE_REFERENCE"},
    "claimCeiling":{"const":"CALIFORNIA_RUNTIME_EGRESS_ELIGIBLE_MACHINE_REFERENCE_PILOT_ONLY"},
    "passClaimAllowed":{"const":false},
    "limitedGeneralizationEvidenceAllowed":{"const":false},
    "missingDataImputedAsNegative":{"const":false},
    "scoredAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"decision":{"enum":["INVALID_FOR_GENERALIZATION","EXECUTION_INTEGRITY_FAILED","POLICY_REVISION_REQUIRED_MACHINE_REFERENCE","INCONCLUSIVE_MACHINE_REFERENCE"]}}
}
