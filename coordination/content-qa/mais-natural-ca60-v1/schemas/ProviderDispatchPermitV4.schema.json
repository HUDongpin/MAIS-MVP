{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.local/schemas/ProviderDispatchPermitV4.schema.json",
  "title": "ProviderDispatchPermitV4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "activeRunnerRegistrationHash", "freshRunnerReviewHash", "authorizationHash", "authenticatedRouteEvidenceHash", "sampleExecutionInventoryHash", "reservationHash", "requestArtifactHash", "compatibilityRequestArtifactHash", "dispatchAuditHash", "attemptId", "provider", "model", "endpoint", "projectResidency", "dataRegion", "projectIdentityHash", "role", "itemHash", "itemIdPseudonym", "wireRequestBodyHash", "wireRequestByteLength", "issuedAt", "selfHash"],
  "properties": {
    "schemaVersion": { "const": "ProviderDispatchPermitV4" },
    "mode": { "const": "LIVE" },
    "activeRunnerRegistrationHash": { "$ref": "#/$defs/hash" },
    "freshRunnerReviewHash": { "$ref": "#/$defs/hash" },
    "authorizationHash": { "$ref": "#/$defs/hash" },
    "authenticatedRouteEvidenceHash": { "$ref": "#/$defs/hash" },
    "sampleExecutionInventoryHash": { "$ref": "#/$defs/hash" },
    "reservationHash": { "$ref": "#/$defs/hash" },
    "requestArtifactHash": { "$ref": "#/$defs/hash" },
    "compatibilityRequestArtifactHash": { "$ref": "#/$defs/hash" },
    "dispatchAuditHash": { "$ref": "#/$defs/hash" },
    "attemptId": { "type": "string", "minLength": 1 },
    "provider": { "enum": ["OPENAI_DIRECT", "DEEPSEEK_DIRECT"] },
    "model": { "enum": ["gpt-5.6-luna", "deepseek-v4-pro"] },
    "endpoint": { "enum": ["https://us.api.openai.com/v1/responses", "https://api.deepseek.com/chat/completions"] },
    "projectResidency": { "type": "string", "minLength": 2 },
    "dataRegion": { "type": "string", "minLength": 2 },
    "projectIdentityHash": { "$ref": "#/$defs/hash" },
    "role": { "type": "string", "minLength": 1 },
    "itemHash": { "$ref": "#/$defs/hash" },
    "itemIdPseudonym": { "type": "string", "minLength": 1 },
    "wireRequestBodyHash": { "$ref": "#/$defs/hash" },
    "wireRequestByteLength": { "type": "integer", "minimum": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "selfHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
