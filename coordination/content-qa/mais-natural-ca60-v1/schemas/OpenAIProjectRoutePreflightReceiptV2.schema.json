{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.local/schemas/OpenAIProjectRoutePreflightReceiptV2.schema.json",
  "title": "OpenAIProjectRoutePreflightReceiptV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "registrationHash", "preflightAuthorizationHash", "credentialReadinessReceiptHash", "provider", "requestedProjectResidency", "requestedEndpoint", "requestedModel", "containsNaturalQuestionText", "observedEndpoint", "observedModel", "projectResidencyConsoleEvidenceHash", "projectIdentityHash", "projectStorageAndProcessingConfirmed", "modelAvailableOnProject", "providerAttemptReceiptHash", "priceSnapshotHash", "preflightStatus", "completedAt", "selfHash"],
  "properties": {
    "schemaVersion": { "const": "OpenAIProjectRoutePreflightReceiptV2" },
    "designId": { "const": "MAIS-NATURAL-CA60-V5" },
    "registrationHash": { "$ref": "#/$defs/hash" },
    "preflightAuthorizationHash": { "$ref": "#/$defs/hash" },
    "credentialReadinessReceiptHash": { "$ref": "#/$defs/hash" },
    "provider": { "const": "OPENAI_DIRECT" },
    "requestedProjectResidency": { "const": "US_STORAGE_PROCESSING" },
    "requestedEndpoint": { "const": "https://us.api.openai.com/v1/responses" },
    "requestedModel": { "const": "gpt-5.6-luna" },
    "containsNaturalQuestionText": { "const": false },
    "observedEndpoint": { "anyOf": [{ "const": "https://us.api.openai.com/v1/responses" }, { "type": "null" }] },
    "observedModel": { "anyOf": [{ "const": "gpt-5.6-luna" }, { "type": "null" }] },
    "projectResidencyConsoleEvidenceHash": { "$ref": "#/$defs/hash" },
    "projectIdentityHash": { "$ref": "#/$defs/hash" },
    "projectStorageAndProcessingConfirmed": { "type": "boolean" },
    "modelAvailableOnProject": { "type": "boolean" },
    "providerAttemptReceiptHash": { "$ref": "#/$defs/hash" },
    "priceSnapshotHash": { "$ref": "#/$defs/hash" },
    "preflightStatus": { "enum": ["CONFIRMED", "BLOCKED", "FAILED"] },
    "completedAt": { "type": "string", "format": "date-time" },
    "selfHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
