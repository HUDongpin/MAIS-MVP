{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/DeepSeekC0TerminalPredicateReceiptV1.schema.json",
  "title":"DeepSeekC0TerminalPredicateReceiptV1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","executionRegistrationHash","sampleExecutionInventoryHash","itemHash","itemIdPseudonym","manifestOrdinal","critiqueEvidenceStatus","revisionEvidenceStatus","terminalEvidenceCode","malformedOrMissingInputDisposition","unknownInputDisposition","mandatoryReasonCodes","mandatoryTrigger","registeredRandomAudit","selectedForC0","openAIReferenceInputCount","selfHash"],
  "properties":{
    "schemaVersion":{"const":"DeepSeekC0TerminalPredicateReceiptV1"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "executionRegistrationHash":{"$ref":"#/$defs/hash"},
    "sampleExecutionInventoryHash":{"$ref":"#/$defs/hash"},
    "itemHash":{"$ref":"#/$defs/hash"},
    "itemIdPseudonym":{"type":"string","minLength":1},
    "manifestOrdinal":{"type":"integer","minimum":1,"maximum":60},
    "critiqueEvidenceStatus":{"enum":["MISSING","MALFORMED","VALID"]},
    "revisionEvidenceStatus":{"enum":["MISSING","MALFORMED","VALID"]},
    "terminalEvidenceCode":{"enum":["ATTEMPT_CAP_EXHAUSTED","NETWORK_TERMINAL_FAILURE","SCHEMA_TERMINAL_FAILURE","INTERRUPTED_RECOVERY_UNCERTAIN","ROLE_OUTPUT_MISSING","ROLE_OUTPUT_MALFORMED"]},
    "malformedOrMissingInputDisposition":{"const":"TRIGGER"},
    "unknownInputDisposition":{"const":"TRIGGER"},
    "mandatoryReasonCodes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"const":"INVALID_TAXONOMY_SCHEMA_OR_ROLE"}},
    "mandatoryTrigger":{"const":true},
    "registeredRandomAudit":{"type":"boolean"},
    "selectedForC0":{"const":true},
    "openAIReferenceInputCount":{"const":0},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
