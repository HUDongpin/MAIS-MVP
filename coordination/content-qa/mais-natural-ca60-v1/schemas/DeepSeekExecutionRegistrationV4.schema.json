{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/DeepSeekExecutionRegistrationV4.schema.json",
  "title":"DeepSeekExecutionRegistrationV4",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","registeredAt","activeRunnerRegistrationHash","freshRunnerReviewHash","deepSeekAuthorizationHash","authenticatedRouteEvidenceHash","costPreviewHash","referenceSealHash","referenceSealValidationReceiptHash","referenceAttemptChainHash","referenceLedgerTerminalHash","finalLabelRoot","sampleExecutionInventoryHash","frameRegistrationHash","sampleManifestHash","c0RandomAuditHash","provider","model","endpoint","resolvedProjectResidency","resolvedDataRegion","adapterHash","decisionCeiling","passClaimAllowed","limitedGeneralizationEvidenceAllowed","selfHash"],
  "properties":{
    "schemaVersion":{"const":"DeepSeekExecutionRegistrationV4"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "registeredAt":{"type":"string","format":"date-time"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "freshRunnerReviewHash":{"$ref":"#/$defs/hash"},
    "deepSeekAuthorizationHash":{"$ref":"#/$defs/hash"},
    "authenticatedRouteEvidenceHash":{"$ref":"#/$defs/hash"},
    "costPreviewHash":{"$ref":"#/$defs/hash"},
    "referenceSealHash":{"$ref":"#/$defs/hash"},
    "referenceSealValidationReceiptHash":{"$ref":"#/$defs/hash"},
    "referenceAttemptChainHash":{"$ref":"#/$defs/hash"},
    "referenceLedgerTerminalHash":{"$ref":"#/$defs/hash"},
    "finalLabelRoot":{"$ref":"#/$defs/hash"},
    "sampleExecutionInventoryHash":{"$ref":"#/$defs/hash"},
    "frameRegistrationHash":{"$ref":"#/$defs/hash"},
    "sampleManifestHash":{"$ref":"#/$defs/hash"},
    "c0RandomAuditHash":{"$ref":"#/$defs/hash"},
    "provider":{"const":"DEEPSEEK_DIRECT"},
    "model":{"const":"deepseek-v4-pro"},
    "endpoint":{"const":"https://api.deepseek.com/chat/completions"},
    "resolvedProjectResidency":{"type":"string","minLength":2},
    "resolvedDataRegion":{"type":"string","minLength":2},
    "adapterHash":{"$ref":"#/$defs/hash"},
    "decisionCeiling":{"const":"INCONCLUSIVE_MACHINE_REFERENCE"},
    "passClaimAllowed":{"const":false},
    "limitedGeneralizationEvidenceAllowed":{"const":false},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
