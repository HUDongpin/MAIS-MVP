{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.local/schemas/ProviderDispatchPermitV3.schema.json",
  "title": "ProviderDispatchPermitV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "mode", "runnerRegistrationHash", "freshRunnerReviewHash",
    "authorizationHash", "sampleExecutionInventoryHash", "reservationHash", "requestArtifactHash",
    "attemptId", "provider", "model", "endpoint", "projectIdentityHash", "role", "itemHash", "itemIdPseudonym",
    "wireRequestBodyHash", "wireRequestByteLength", "issuedAt", "selfHash"
  ],
  "properties": {
    "schemaVersion": { "const": "ProviderDispatchPermitV3" },
    "mode": { "const": "LIVE" },
    "runnerRegistrationHash": { "$ref": "#/$defs/hash" },
    "freshRunnerReviewHash": { "$ref": "#/$defs/hash" },
    "authorizationHash": { "$ref": "#/$defs/hash" },
    "sampleExecutionInventoryHash": { "$ref": "#/$defs/hash" },
    "reservationHash": { "$ref": "#/$defs/hash" },
    "requestArtifactHash": { "$ref": "#/$defs/hash" },
    "attemptId": { "type": "string", "minLength": 1 },
    "provider": { "enum": ["OPENAI_DIRECT", "DEEPSEEK_DIRECT"] },
    "model": { "enum": ["gpt-5.6-luna", "deepseek-v4-pro"] },
    "endpoint": { "enum": ["https://us.api.openai.com/v1/responses", "https://api.deepseek.com/chat/completions"] },
    "projectIdentityHash": { "$ref": "#/$defs/hash" },
    "role": { "type": "string", "minLength": 1 },
    "itemHash": { "$ref": "#/$defs/hash" },
    "itemIdPseudonym": { "type": "string", "minLength": 1 },
    "wireRequestBodyHash": { "$ref": "#/$defs/hash" },
    "wireRequestByteLength": { "type": "integer", "minimum": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "selfHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
