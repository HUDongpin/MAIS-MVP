{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/IndependentExecutionRunnerReviewReceiptV6.schema.json",
  "title":"IndependentExecutionRunnerReviewReceiptV6",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","runnerVersion","reviewedAt","decision","reviewerLane","independentImplementation","findingCount","reviewedRunnerRegistrationHash","reviewedRunnerRegistrationCommit","reviewedRunnerSourceCommit","reviewedProductionSourceRootHash","reviewedTestSourceRootHash","reviewedImportClosureRootHash","reviewedRemediatedFindingIds","verifierSourceTreeRoot","dependencyLockRoot","staticImportGraphHash","forbiddenPrimaryScorerPathScanHash","commandRuntimeHash","baselineCommit","recomputedRuntimeSourceEnumerationRootHash","independentSourceEnumerationReceiptHash","processEvidenceRootHash","reviewCustodyPolicy","credentialReadCount","naturalQuestionReadCount","providerCallCount","naturalQuestionEgressCount","tokenCount","attemptCount","usdSpent","selfHash"],
  "properties":{
    "schemaVersion":{"const":"IndependentExecutionRunnerReviewReceiptV6"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "runnerVersion":{"const":"V5-R8"},
    "reviewedAt":{"type":"string","format":"date-time"},
    "decision":{"enum":["CONCURRED","DISCREPANCY","UNREVIEWABLE"]},
    "reviewerLane":{"const":"A11"},
    "independentImplementation":{"const":true},
    "findingCount":{"type":"integer","minimum":0},
    "reviewedRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "reviewedRunnerRegistrationCommit":{"$ref":"#/$defs/commit"},
    "reviewedRunnerSourceCommit":{"$ref":"#/$defs/commit"},
    "reviewedProductionSourceRootHash":{"$ref":"#/$defs/hash"},
    "reviewedTestSourceRootHash":{"$ref":"#/$defs/hash"},
    "reviewedImportClosureRootHash":{"$ref":"#/$defs/hash"},
    "reviewedRemediatedFindingIds":{"type":"array","minItems":8,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^A11-R7-00[1-8]$"}},
    "verifierSourceTreeRoot":{"$ref":"#/$defs/hash"},
    "dependencyLockRoot":{"$ref":"#/$defs/hash"},
    "staticImportGraphHash":{"$ref":"#/$defs/hash"},
    "forbiddenPrimaryScorerPathScanHash":{"$ref":"#/$defs/hash"},
    "commandRuntimeHash":{"$ref":"#/$defs/hash"},
    "baselineCommit":{"$ref":"#/$defs/commit"},
    "recomputedRuntimeSourceEnumerationRootHash":{"$ref":"#/$defs/hash"},
    "independentSourceEnumerationReceiptHash":{"$ref":"#/$defs/hash"},
    "processEvidenceRootHash":{"$ref":"#/$defs/hash"},
    "reviewCustodyPolicy":{"const":"GIT_OBJECT_SINGLE_ADD_WITH_EXACT_REGISTRATION_PARENT_AND_RECOMPUTED_PROCESS_EVIDENCE"},
    "credentialReadCount":{"const":0},
    "naturalQuestionReadCount":{"const":0},
    "providerCallCount":{"const":0},
    "naturalQuestionEgressCount":{"const":0},
    "tokenCount":{"const":0},
    "attemptCount":{"const":0},
    "usdSpent":{"const":0},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"}}
}
