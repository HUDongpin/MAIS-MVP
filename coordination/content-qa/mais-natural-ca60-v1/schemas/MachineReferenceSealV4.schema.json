    "finding":{"type":"object","additionalProperties":false,"required":["findingId","evidenceLocator","code","family","severity"],"properties":{"findingId":{"type":"string","minLength":1},"evidenceLocator":{"type":"string","minLength":1},"code":{"$ref":"#/$defs/code"},"family":{"type":"string","minLength":1},"severity":{"enum":["P0","P1","P2"]}}},
    "itemSummary":{"type":"object","additionalProperties":false,"required":["itemHash","itemIdPseudonym","clusterId","roleOutputHashes","adjudicationTriggerHash","finalLabelHash"],"properties":{"itemHash":{"$ref":"#/$defs/hash"},"itemIdPseudonym":{"type":"string","minLength":1},"clusterId":{"type":"string","minLength":1},"roleOutputHashes":{"type":"object","minProperties":4,"maxProperties":5,"propertyNames":{"enum":["A_SOLVE","A_LABEL","B_SOLVE","B_LABEL","ADJUDICATOR"]},"additionalProperties":{"$ref":"#/$defs/hash"}},"adjudicationTriggerHash":{"$ref":"#/$defs/hash"},"finalLabelHash":{"$ref":"#/$defs/hash"}}},
    "finalLabel":{"type":"object","additionalProperties":false,"required":["schemaVersion","labelSourceType","humanGold","sameModelCorrelatedErrorRisk","provider","model","itemHash","itemIdPseudonym","clusterId","resolutionMethod","sourceRoleOutputHashes","adjudicationTriggerHash","label","taxonomyCodes","severity","findingFamilies","findings","unresolved","selfHash"],"properties":{"schemaVersion":{"const":"MachineReferenceLabelV1"},"labelSourceType":{"const":"machine_reference_panel"},"humanGold":{"const":false},"sameModelCorrelatedErrorRisk":{"const":true},"provider":{"const":"OPENAI_DIRECT"},"model":{"const":"gpt-5.6-luna"},"itemHash":{"$ref":"#/$defs/hash"},"itemIdPseudonym":{"type":"string","minLength":1},"clusterId":{"type":"string","minLength":1},"resolutionMethod":{"enum":["DETERMINISTIC_EXACT_AGREEMENT_MERGER","OPENAI_ADJUDICATION"]},"sourceRoleOutputHashes":{"type":"array","minItems":4,"maxItems":5,"uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},"adjudicationTriggerHash":{"$ref":"#/$defs/hash"},"label":{"enum":["DEFECT","NO_FINDING","UNRESOLVED_REFERENCE"]},"taxonomyCodes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/code"}},"severity":{"enum":["NONE","P2","P1","P0","UNRESOLVED"]},"findingFamilies":{"type":"object","propertyNames":{"$ref":"#/$defs/code"},"additionalProperties":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]}},"findings":{"type":"array","items":{"$ref":"#/$defs/finding"}},"unresolved":{"type":"boolean"},"selfHash":{"$ref":"#/$defs/hash"}}}
  }
}
