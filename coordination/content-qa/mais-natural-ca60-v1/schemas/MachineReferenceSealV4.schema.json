    "agreementStatistics":{"type":"object","additionalProperties":false,"required":["pairCount","categoryCount","rawExactAgreement","severityAgreement","codeJaccard","familyJaccard","cohenKappa","gwetAc1","degenerateKappaDisposition","adjudicationRate"],"properties":{"pairCount":{"const":60},"categoryCount":{"type":"integer","minimum":1},"rawExactAgreement":{"$ref":"#/$defs/rate"},"severityAgreement":{"$ref":"#/$defs/rate"},"codeJaccard":{"$ref":"#/$defs/rate"},"familyJaccard":{"$ref":"#/$defs/rate"},"cohenKappa":{"anyOf":[{"type":"number","minimum":-1,"maximum":1},{"type":"null"}]},"gwetAc1":{"anyOf":[{"type":"number","minimum":-1,"maximum":1},{"type":"null"}]},"degenerateKappaDisposition":{"enum":["NULL_SINGLE_CATEGORY","DEFINED"]},"adjudicationRate":{"$ref":"#/$defs/rate"}}},
    "selfHash":{"$ref":"#/$defs/hash"}
