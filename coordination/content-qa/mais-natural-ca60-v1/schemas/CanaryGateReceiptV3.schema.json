{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/CanaryGateReceiptV3.schema.json",
  "title":"CanaryGateReceiptV3",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","executionRegistrationHash","deepSeekAuthorizationHash","sampleExecutionInventoryHash","canaryItemHash","manifestOrdinal","c0PredicateReceiptHash","selectedForC0","requiredRoleOrder","roleAttemptEvidenceHashes","successfulRoleOutputHashes","rawResponseArtifactHashes","rawResponseBindingReceiptHashes","resolvedAttemptReceiptHashes","stateBoundDispatchAuditHashes","semanticDispatchVerificationReceiptHash","ledgerTerminalHash","tuningAllowed","state","passedAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"CanaryGateReceiptV3"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "executionRegistrationHash":{"$ref":"#/$defs/hash"},
    "deepSeekAuthorizationHash":{"$ref":"#/$defs/hash"},
    "sampleExecutionInventoryHash":{"$ref":"#/$defs/hash"},
    "canaryItemHash":{"$ref":"#/$defs/hash"},
    "manifestOrdinal":{"const":1},
    "c0PredicateReceiptHash":{"$ref":"#/$defs/hash"},
    "selectedForC0":{"type":"boolean"},
    "requiredRoleOrder":{"type":"array","minItems":2,"maxItems":7,"uniqueItems":true,"items":{"enum":["B_PRIME_CRITIQUE","B_PRIME_REVISION","C0_PRIME_ROLE_1","C0_PRIME_ROLE_2","C0_PRIME_ROLE_3","C0_PRIME_ROLE_4","C0_PRIME_ROLE_5"]}},
    "roleAttemptEvidenceHashes":{"type":"array","minItems":2,"maxItems":7,"uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
    "successfulRoleOutputHashes":{"type":"array","minItems":2,"maxItems":7,"uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
    "rawResponseArtifactHashes":{"type":"array","minItems":2,"maxItems":7,"uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
    "rawResponseBindingReceiptHashes":{"type":"array","minItems":2,"maxItems":7,"uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
    "resolvedAttemptReceiptHashes":{"type":"array","minItems":2,"maxItems":7,"uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
    "stateBoundDispatchAuditHashes":{"type":"array","minItems":2,"maxItems":7,"uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
    "semanticDispatchVerificationReceiptHash":{"$ref":"#/$defs/hash"},
    "ledgerTerminalHash":{"$ref":"#/$defs/hash"},
    "tuningAllowed":{"const":false},
    "state":{"const":"CANARY_INTEGRITY_CLEARED_NO_TUNING"},
    "passedAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
