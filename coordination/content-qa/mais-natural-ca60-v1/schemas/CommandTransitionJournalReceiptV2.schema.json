{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/CommandTransitionJournalReceiptV2.schema.json",
  "title":"CommandTransitionJournalReceiptV2",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","commandId","activeRunnerRegistrationHash","status","preparedIntentCount","preparedIntentHashes","observedDurableTransitionCount","observedDurableSteps","observedDurableTransitionHashes","persistedSubreceiptCount","persistedSubreceiptHashes","lastObservedDurableWorkflowIndexHash","providerDispatchIntentCount","providerEventCountLowerBound","httpRequestCountLowerBound","credentialReadCountLowerBound","naturalQuestionEgressCountLowerBound","activityAccountingStatus","errorClass","startedAt","finishedAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"CommandTransitionJournalReceiptV2"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "commandId":{"$ref":"#/$defs/hash"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "status":{"enum":["COMPLETED","FAILED_BEFORE_DURABLE_TRANSITION","FAILED_AFTER_DURABLE_TRANSITION","FAILED_AFTER_DURABLE_TRANSITION_PERSISTENCE_UNCERTAIN","PROVIDER_ACTIVITY_POSSIBLE_ACCOUNTING_INCOMPLETE"]},
    "preparedIntentCount":{"type":"integer","minimum":0},
    "preparedIntentHashes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
    "observedDurableTransitionCount":{"type":"integer","minimum":0},
    "observedDurableSteps":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "observedDurableTransitionHashes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
    "persistedSubreceiptCount":{"type":"integer","minimum":0},
    "persistedSubreceiptHashes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
    "lastObservedDurableWorkflowIndexHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "providerDispatchIntentCount":{"type":"integer","minimum":0},
    "providerEventCountLowerBound":{"type":"integer","minimum":0},
    "httpRequestCountLowerBound":{"type":"integer","minimum":0},
    "credentialReadCountLowerBound":{"type":"integer","minimum":0},
    "naturalQuestionEgressCountLowerBound":{"type":"integer","minimum":0},
    "activityAccountingStatus":{"enum":["EXACT","LOWER_BOUND_PROVIDER_ACTIVITY_POSSIBLE","UNKNOWN_FAIL_CLOSED"]},
    "errorClass":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
    "startedAt":{"type":"string","format":"date-time"},
    "finishedAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
