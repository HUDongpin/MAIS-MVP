{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/ProviderRequestArtifactV5.schema.json",
  "title":"ProviderRequestArtifactV5",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","compatibilityBaseRunnerRegistrationHash","authorizationHash","compatibilityAuthorizationHash","authenticatedRouteEvidenceHash","sampleManifestHash","sampleExecutionInventoryHash","manifestOrdinal","itemHash","itemIdPseudonym","clusterId","provider","model","endpoint","projectResidency","dataRegion","role","attemptId","itemLeafHash","providerInput","providerInputHash","providerInputFieldNames","rolePromptHash","roleSchemaHash","adapterTransformHash","logicalRequest","logicalRequestHash","wireRequest","wireRequestBodyHash","wireRequestByteLength","reservedInputTokens","reservedOutputTokens","reservedTokens","referenceInputCount","deepSeekInputCount","priorCompletionHashes","compatibilityRequestArtifactHash","compatibilityRequestArtifact","selfHash"],
  "properties":{
    "schemaVersion":{"const":"ProviderRequestArtifactV5"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "compatibilityBaseRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "authorizationHash":{"$ref":"#/$defs/hash"},
    "compatibilityAuthorizationHash":{"$ref":"#/$defs/hash"},
    "authenticatedRouteEvidenceHash":{"$ref":"#/$defs/hash"},
    "sampleManifestHash":{"$ref":"#/$defs/hash"},
    "sampleExecutionInventoryHash":{"$ref":"#/$defs/hash"},
    "manifestOrdinal":{"type":"integer","minimum":1,"maximum":60},
    "itemHash":{"$ref":"#/$defs/hash"},
    "itemIdPseudonym":{"type":"string","minLength":1},
    "clusterId":{"type":"string","minLength":1},
    "provider":{"enum":["OPENAI_DIRECT","DEEPSEEK_DIRECT"]},
    "model":{"enum":["gpt-5.6-luna","deepseek-v4-pro"]},
    "endpoint":{"enum":["https://us.api.openai.com/v1/responses","https://api.deepseek.com/chat/completions"]},
    "projectResidency":{"type":"string","minLength":2},
    "dataRegion":{"type":"string","minLength":2},
    "role":{"type":"string","minLength":1},
    "attemptId":{"type":"string","minLength":1},
    "itemLeafHash":{"$ref":"#/$defs/hash"},
    "providerInput":{"type":"object"},
    "providerInputHash":{"$ref":"#/$defs/hash"},
    "providerInputFieldNames":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "rolePromptHash":{"$ref":"#/$defs/hash"},
    "roleSchemaHash":{"$ref":"#/$defs/hash"},
    "adapterTransformHash":{"$ref":"#/$defs/hash"},
    "logicalRequest":{"type":"object"},
    "logicalRequestHash":{"$ref":"#/$defs/hash"},
    "wireRequest":{"type":"object"},
    "wireRequestBodyHash":{"$ref":"#/$defs/hash"},
    "wireRequestByteLength":{"type":"integer","minimum":1},
    "reservedInputTokens":{"type":"integer","minimum":1},
    "reservedOutputTokens":{"const":8192},
    "reservedTokens":{"type":"integer","minimum":8193},
    "referenceInputCount":{"const":0},
    "deepSeekInputCount":{"const":0},
    "priorCompletionHashes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/hash"}},
    "compatibilityRequestArtifactHash":{"$ref":"#/$defs/hash"},
    "compatibilityRequestArtifact":{"type":"object"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
