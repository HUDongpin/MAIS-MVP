{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/NaturalCaAggregateScoreReceiptV7.schema.json",
  "title":"NaturalCaAggregateScoreReceiptV7",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","sampleExecutionInventoryHash","referenceSealHash","executionRegistrationHash","c0ExecutionSetHash","deepSeekAttemptGraphReceiptHash","semanticDispatchVerificationReceiptHash","decisionEvidenceReceiptHash","itemResultSetHash","completedItemMarkerRootHash","finalEvaluationReceiptHash","completeItemCount","missingItemCount","unifiedNonresolvedItemCount","metricOutputCount","analysisStatus","overallDecision","decisionCeiling","claimCeiling","passClaimAllowed","limitedGeneralizationEvidenceAllowed","missingDataImputedAsNegative","verificationMode","scoredAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"NaturalCaAggregateScoreReceiptV7"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "sampleExecutionInventoryHash":{"$ref":"#/$defs/hash"},
    "referenceSealHash":{"$ref":"#/$defs/hash"},
    "executionRegistrationHash":{"$ref":"#/$defs/hash"},
    "c0ExecutionSetHash":{"$ref":"#/$defs/hash"},
    "deepSeekAttemptGraphReceiptHash":{"$ref":"#/$defs/hash"},
    "semanticDispatchVerificationReceiptHash":{"$ref":"#/$defs/hash"},
    "decisionEvidenceReceiptHash":{"$ref":"#/$defs/hash"},
    "itemResultSetHash":{"$ref":"#/$defs/hash"},
    "completedItemMarkerRootHash":{"$ref":"#/$defs/hash"},
    "finalEvaluationReceiptHash":{"$ref":"#/$defs/hash"},
    "completeItemCount":{"type":"integer","minimum":0,"maximum":60},
    "missingItemCount":{"type":"integer","minimum":0,"maximum":60},
    "unifiedNonresolvedItemCount":{"type":"integer","minimum":0,"maximum":60},
    "metricOutputCount":{"enum":[0,11]},
    "analysisStatus":{"enum":["COMPLETE_FROZEN_METRIC_ANALYSIS","INVALID_NO_METRIC_INFERENCE","TERMINAL_INTEGRITY_DECISION_NO_METRIC_INFERENCE"]},
    "overallDecision":{"enum":["INVALID_FOR_GENERALIZATION","EXECUTION_INTEGRITY_FAILED","POLICY_REVISION_REQUIRED_MACHINE_REFERENCE","INCONCLUSIVE_MACHINE_REFERENCE"]},
    "decisionCeiling":{"const":"INCONCLUSIVE_MACHINE_REFERENCE"},
    "claimCeiling":{"const":"CALIFORNIA_RUNTIME_EGRESS_ELIGIBLE_MACHINE_REFERENCE_PILOT_ONLY"},
    "passClaimAllowed":{"const":false},
    "limitedGeneralizationEvidenceAllowed":{"const":false},
    "missingDataImputedAsNegative":{"const":false},
    "verificationMode":{"const":"READ_ONLY_RAW_GRAPH_ITEM_RESULT_STATISTICS_AND_TERMINAL_DECISION_RECONSTRUCTION"},
    "scoredAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
