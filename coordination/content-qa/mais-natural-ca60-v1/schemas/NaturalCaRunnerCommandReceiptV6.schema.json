{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/NaturalCaRunnerCommandReceiptV6.schema.json",
  "title":"NaturalCaRunnerCommandReceiptV6",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","runnerVersion","designId","command","status","activeRunnerRegistrationHash","providerCommandInvoked","providerEventCount","httpRequestCount","credentialReadCount","naturalQuestionEgressCount","referenceLabelCount","naturalQuestionResultCount","activityAccountingStatus","transitionJournalHash","observedDurableTransitionCount","lastObservedDurableWorkflowIndexHash","decisionCeiling","claimCeiling","passClaimAllowed","limitedGeneralizationEvidenceAllowed","selfHash"],
  "properties":{
    "schemaVersion":{"const":"NaturalCaRunnerCommandReceiptV6"},
    "runnerVersion":{"const":"V5-R7"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "command":{"enum":["register","freeze-frame","audit-clusters","freeze-sample","register-route-evidence","label-reference","label-qwen","seal-reference-labels","dry-run","authorize-check","freeze-deepseek-registration","execute-deepseek","score","verify","export-aggregate-report"]},
    "status":{"type":"string","minLength":1},
    "activeRunnerRegistrationHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "providerCommandInvoked":{"type":"boolean"},
    "providerEventCount":{"$ref":"#/$defs/maybeCount"},
    "httpRequestCount":{"$ref":"#/$defs/maybeCount"},
    "credentialReadCount":{"$ref":"#/$defs/maybeCount"},
    "naturalQuestionEgressCount":{"$ref":"#/$defs/maybeCount"},
    "referenceLabelCount":{"type":"integer","minimum":0,"maximum":60},
    "naturalQuestionResultCount":{"type":"integer","minimum":0,"maximum":60},
    "activityAccountingStatus":{"enum":["EXACT","LOWER_BOUND_PROVIDER_ACTIVITY_POSSIBLE","UNKNOWN_FAIL_CLOSED"]},
    "transitionJournalHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "observedDurableTransitionCount":{"type":"integer","minimum":0},
    "lastObservedDurableWorkflowIndexHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "decisionCeiling":{"const":"INCONCLUSIVE_MACHINE_REFERENCE"},
    "claimCeiling":{"enum":["FRAME_AND_SAMPLE_FROZEN_RUNNER_OFFLINE_IMPLEMENTED_NOT_EXECUTED","CALIFORNIA_RUNTIME_EGRESS_ELIGIBLE_MACHINE_REFERENCE_PILOT_ONLY"]},
    "passClaimAllowed":{"const":false},
    "limitedGeneralizationEvidenceAllowed":{"const":false},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "maybeCount":{"anyOf":[{"type":"integer","minimum":0},{"type":"null"}]}
  }
}
