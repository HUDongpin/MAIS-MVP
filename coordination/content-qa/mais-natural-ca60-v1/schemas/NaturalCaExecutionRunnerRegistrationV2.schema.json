{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.local/schemas/NaturalCaExecutionRunnerRegistrationV2.schema.json",
  "title": "NaturalCaExecutionRunnerRegistrationV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runnerVersion", "designId", "registeredAt", "supersedesRunnerRegistrationHash",
    "discrepancyReviewHash", "discrepancyReviewCommit", "previousReceiptHash", "designRegistrationHash",
    "frameRegistrationHash", "samplingFrameHash", "sampleManifestHash", "samplePayloadSetHash",
    "sampleSelectionContentRootHash", "privacyScreenHash", "rightsScreenHash", "rightsPolicyHash",
    "lineageRuleHash", "taxonomyHash", "labelingAndAdjudicationHash", "thresholdsDecisionAndPowerHash",
    "decisionCeiling", "providerContractErratumHash", "runnerSourceCommit", "productionSourceManifest",
    "productionSourceRootHash", "testSourceManifest", "testSourceRootHash", "providerImplementations",
    "authorizationState", "status", "claimCeiling", "selfHash"
  ],
  "properties": {
    "schemaVersion": { "const": "NaturalCaExecutionRunnerRegistrationV2" },
    "runnerVersion": { "const": "V5-R3" },
    "designId": { "const": "MAIS-NATURAL-CA60-V5" },
    "registeredAt": { "type": "string", "format": "date-time" },
    "supersedesRunnerRegistrationHash": { "$ref": "#/$defs/hash" },
    "discrepancyReviewHash": { "$ref": "#/$defs/hash" },
    "discrepancyReviewCommit": { "$ref": "#/$defs/commit" },
    "previousReceiptHash": { "$ref": "#/$defs/hash" },
    "designRegistrationHash": { "$ref": "#/$defs/hash" },
    "frameRegistrationHash": { "$ref": "#/$defs/hash" },
    "samplingFrameHash": { "$ref": "#/$defs/hash" },
    "sampleManifestHash": { "$ref": "#/$defs/hash" },
    "samplePayloadSetHash": { "$ref": "#/$defs/hash" },
    "sampleSelectionContentRootHash": { "$ref": "#/$defs/hash" },
    "privacyScreenHash": { "$ref": "#/$defs/hash" },
    "rightsScreenHash": { "$ref": "#/$defs/hash" },
    "rightsPolicyHash": { "$ref": "#/$defs/hash" },
    "lineageRuleHash": { "$ref": "#/$defs/hash" },
    "taxonomyHash": { "$ref": "#/$defs/hash" },
    "labelingAndAdjudicationHash": { "$ref": "#/$defs/hash" },
    "thresholdsDecisionAndPowerHash": { "$ref": "#/$defs/hash" },
    "decisionCeiling": { "const": "INCONCLUSIVE_MACHINE_REFERENCE" },
    "providerContractErratumHash": { "$ref": "#/$defs/hash" },
    "runnerSourceCommit": { "$ref": "#/$defs/commit" },
    "productionSourceManifest": { "$ref": "#/$defs/sourceManifest" },
    "productionSourceRootHash": { "$ref": "#/$defs/hash" },
    "testSourceManifest": { "$ref": "#/$defs/sourceManifest" },
    "testSourceRootHash": { "$ref": "#/$defs/hash" },
    "providerImplementations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openAI", "deepSeek"],
      "properties": {
        "openAI": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "endpoint", "projectResidency", "adapterHash", "authorizationGuardHash", "transportHash", "atomicLedgerHash", "routeReceiptBuilderHash", "resumeHash", "runnerHash", "cliHash", "providerCallsMade"],
          "properties": {
            "provider": { "const": "OPENAI_DIRECT" },
            "model": { "const": "gpt-5.6-luna" },
            "endpoint": { "const": "https://us.api.openai.com/v1/responses" },
            "projectResidency": { "const": "US_STORAGE_PROCESSING" },
            "adapterHash": { "$ref": "#/$defs/hash" },
            "authorizationGuardHash": { "$ref": "#/$defs/hash" },
            "transportHash": { "$ref": "#/$defs/hash" },
            "atomicLedgerHash": { "$ref": "#/$defs/hash" },
            "routeReceiptBuilderHash": { "$ref": "#/$defs/hash" },
            "resumeHash": { "$ref": "#/$defs/hash" },
            "runnerHash": { "$ref": "#/$defs/hash" },
            "cliHash": { "$ref": "#/$defs/hash" },
            "providerCallsMade": { "const": 0 }
          }
        },
        "deepSeek": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "endpoint", "projectResidency", "adapterHash", "authorizationGuardHash", "transportHash", "atomicLedgerHash", "routeReceiptBuilderHash", "resumeHash", "runnerHash", "executionRegistrationValidatorHash", "referenceInputCount", "providerCallsMade"],
          "properties": {
            "provider": { "const": "DEEPSEEK_DIRECT" },
            "model": { "const": "deepseek-v4-pro" },
            "endpoint": { "const": "https://api.deepseek.com/chat/completions" },
            "projectResidency": { "const": "UNKNOWN_PENDING_ROUTE_PROBE_EVIDENCE" },
            "adapterHash": { "$ref": "#/$defs/hash" },
            "authorizationGuardHash": { "$ref": "#/$defs/hash" },
            "transportHash": { "$ref": "#/$defs/hash" },
            "atomicLedgerHash": { "$ref": "#/$defs/hash" },
            "routeReceiptBuilderHash": { "$ref": "#/$defs/hash" },
            "resumeHash": { "$ref": "#/$defs/hash" },
            "runnerHash": { "$ref": "#/$defs/hash" },
            "executionRegistrationValidatorHash": { "$ref": "#/$defs/hash" },
            "referenceInputCount": { "const": 0 },
            "providerCallsMade": { "const": 0 }
          }
        }
      }
    },
    "authorizationState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentialReadAuthorized", "providerExecutionAuthorized", "naturalQuestionEgressAuthorized", "tokenAuthorizationCreated", "attemptAuthorizationCreated", "usdAuthorizationCreated", "credentialReadCount", "providerEventCount", "naturalQuestionEgressCount", "tokenCount", "attemptCount", "usdSpent", "referenceLabelCount", "naturalQuestionResultCount"],
      "properties": {
        "credentialReadAuthorized": { "const": false },
        "providerExecutionAuthorized": { "const": false },
        "naturalQuestionEgressAuthorized": { "const": false },
        "tokenAuthorizationCreated": { "const": false },
        "attemptAuthorizationCreated": { "const": false },
        "usdAuthorizationCreated": { "const": false },
        "credentialReadCount": { "const": 0 },
        "providerEventCount": { "const": 0 },
        "naturalQuestionEgressCount": { "const": 0 },
        "tokenCount": { "const": 0 },
        "attemptCount": { "const": 0 },
        "usdSpent": { "const": 0 },
        "referenceLabelCount": { "const": 0 },
        "naturalQuestionResultCount": { "const": 0 }
      }
    },
    "status": { "const": "OFFLINE_IMPLEMENTED_PENDING_FRESH_A11_V5_R3_REVIEW_PROVIDER_EXECUTION_BLOCKED" },
    "claimCeiling": { "const": "FRAME_AND_SAMPLE_FROZEN_RUNNER_OFFLINE_IMPLEMENTED_NOT_EXECUTED" },
    "selfHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceManifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "byteLength", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "byteLength": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    }
  }
}
