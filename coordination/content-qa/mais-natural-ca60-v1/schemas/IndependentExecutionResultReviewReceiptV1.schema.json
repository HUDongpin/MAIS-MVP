{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mais.local/schemas/IndependentExecutionResultReviewReceiptV1.schema.json","title":"IndependentExecutionResultReviewReceiptV1","type":"object","additionalProperties":false,
