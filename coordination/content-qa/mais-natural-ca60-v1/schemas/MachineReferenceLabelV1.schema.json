{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mais.local/schemas/MachineReferenceLabelV1.schema.json","title":"MachineReferenceLabelV1","type":"object","additionalProperties":false,
  "required":["schemaVersion","labelSourceType","humanGold","sameModelCorrelatedErrorRisk","provider","model","itemHash","itemIdPseudonym","clusterId","resolutionMethod","sourceRoleOutputHashes","adjudicationTriggerHash","label","taxonomyCodes","severity","findingFamilies","findings","unresolved","selfHash"],
  "properties":{
