{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mais.local/schemas/ClaimBoundaryReviewReceiptV2.schema.json","title":"ClaimBoundaryReviewReceiptV2","type":"object","additionalProperties":false,
