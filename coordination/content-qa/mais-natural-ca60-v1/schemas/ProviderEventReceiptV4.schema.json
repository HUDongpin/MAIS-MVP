{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.local/schemas/ProviderEventReceiptV4.schema.json",
  "title": "ProviderEventReceiptV4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "reservationHash", "authorizationHash", "requestArtifactHash", "dispatchPermitHash",
    "dispatchPermit", "attemptId", "role", "itemHash", "itemIdPseudonym", "clusterId", "provider",
    "requestedModel", "observedModel", "requestedEndpoint", "observedEndpoint", "projectIdentityHash", "requestBodyHash",
    "responseBodyHash", "providerRequestId", "startedAt", "finishedAt", "latencyMs", "transportStatus",
    "bodyReadStatus", "httpStatus", "providerEventCount", "httpRequestCount", "parseStatus", "schemaStatus",
    "finishReason", "attemptStatus", "usageSource", "inputTokens", "outputTokens", "reasoningTokens",
    "totalTokens", "priceSnapshotHash", "estimatedCostUsd", "reservedInputTokens", "reservedOutputTokens",
    "reservedTokens", "reservedCostUsd", "providerInvoiceAuthoritative", "selfHash"
  ],
  "properties": {
    "schemaVersion": { "const": "ProviderEventReceiptV4" },
    "reservationHash": { "$ref": "#/$defs/hash" },
    "authorizationHash": { "$ref": "#/$defs/hash" },
    "requestArtifactHash": { "$ref": "#/$defs/hash" },
    "dispatchPermitHash": { "$ref": "#/$defs/hash" },
    "dispatchPermit": { "type": "object" },
    "attemptId": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "itemHash": { "$ref": "#/$defs/hash" },
    "itemIdPseudonym": { "type": "string", "minLength": 1 },
    "clusterId": { "type": "string", "minLength": 1 },
    "provider": { "enum": ["OPENAI_DIRECT", "DEEPSEEK_DIRECT"] },
    "requestedModel": { "enum": ["gpt-5.6-luna", "deepseek-v4-pro"] },
    "observedModel": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "requestedEndpoint": { "enum": ["https://us.api.openai.com/v1/responses", "https://api.deepseek.com/chat/completions"] },
    "observedEndpoint": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "projectIdentityHash": { "$ref": "#/$defs/hash" },
    "requestBodyHash": { "$ref": "#/$defs/hash" },
    "responseBodyHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "providerRequestId": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "latencyMs": { "type": "number", "minimum": 0 },
    "transportStatus": { "type": "string", "minLength": 1 },
    "bodyReadStatus": { "type": "string", "minLength": 1 },
    "httpStatus": { "anyOf": [{ "type": "integer", "minimum": 100, "maximum": 599 }, { "type": "null" }] },
    "providerEventCount": { "enum": [0, 1] },
    "httpRequestCount": { "enum": [0, 1] },
    "parseStatus": { "type": "string", "minLength": 1 },
    "schemaStatus": { "type": "string", "minLength": 1 },
    "finishReason": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "attemptStatus": { "type": "string", "minLength": 1 },
    "usageSource": { "enum": ["PROVIDER_ENVELOPE", "UNAVAILABLE_RESERVED_WORST_CASE"] },
    "inputTokens": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "outputTokens": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "reasoningTokens": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "totalTokens": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "priceSnapshotHash": { "$ref": "#/$defs/hash" },
    "estimatedCostUsd": { "type": "number", "minimum": 0 },
    "reservedInputTokens": { "type": "integer", "minimum": 1 },
    "reservedOutputTokens": { "const": 8192 },
    "reservedTokens": { "type": "integer", "minimum": 8193 },
    "reservedCostUsd": { "type": "number", "minimum": 0 },
    "providerInvoiceAuthoritative": { "const": true },
    "selfHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
