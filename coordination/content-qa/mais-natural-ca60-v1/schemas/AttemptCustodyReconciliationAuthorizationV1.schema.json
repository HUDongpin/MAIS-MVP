{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.local/schemas/AttemptCustodyReconciliationAuthorizationV1.schema.json",
  "title": "AttemptCustodyReconciliationAuthorizationV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "activeRunnerRegistrationHash", "providerAuthorizationHash", "reservationHash", "recoveryScope", "automaticRecoveryAuthorized", "zeroHttpOnly", "authorizedBy", "ownerAuthorizationTextHash", "issuedAt", "expiresAt", "selfHash"],
  "properties": {
    "schemaVersion": {"const": "AttemptCustodyReconciliationAuthorizationV1"},
    "designId": {"const": "MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash": {"$ref": "#/$defs/hash"},
    "providerAuthorizationHash": {"$ref": "#/$defs/hash"},
    "reservationHash": {"$ref": "#/$defs/hash"},
    "recoveryScope": {"const": "EXACT_SINGLE_INTERRUPTED_ATTEMPT_ZERO_HTTP"},
    "automaticRecoveryAuthorized": {"const": false},
    "zeroHttpOnly": {"const": true},
    "authorizedBy": {"type": "string", "minLength": 1},
    "ownerAuthorizationTextHash": {"$ref": "#/$defs/hash"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "selfHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
