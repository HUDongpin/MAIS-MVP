{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/ProviderEvidenceCaptureReceiptV1.schema.json",
  "title":"ProviderEvidenceCaptureReceiptV1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","provider","model","endpoint","projectResidency","dataRegion","subjectIdentityHash","evidenceKind","sourceKind","rawSourceArtifactHash","rawSourceBytesHash","rawSourceByteLength","sourceLocatorHash","captureLane","authenticatedSessionEvidenceHash","ownerAttestationReceiptHash","guardedProviderEventReceiptHash","zeroNaturalContentRequestHash","credentialLikeMaterialDetected","capturedAt","expiresAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"ProviderEvidenceCaptureReceiptV1"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "provider":{"enum":["OPENAI_DIRECT","DEEPSEEK_DIRECT"]},
    "model":{"enum":["gpt-5.6-luna","deepseek-v4-pro"]},
    "endpoint":{"enum":["https://us.api.openai.com/v1/responses","https://api.deepseek.com/chat/completions"]},
    "projectResidency":{"type":"string","minLength":2},
    "dataRegion":{"type":"string","minLength":2},
    "subjectIdentityHash":{"$ref":"#/$defs/hash"},
    "evidenceKind":{"enum":["ACCOUNT_PROJECT_IDENTITY","DIRECT_BILLING_ROUTE","DATA_REGION","PRICE","ROUTE_PROBE_RESPONSE"]},
    "sourceKind":{"enum":["PROVIDER_CONSOLE_EXPORT","PROVIDER_BILLING_EXPORT","PROVIDER_OFFICIAL_RATE_CARD","GUARDED_ZERO_CONTENT_ROUTE_PROBE"]},
    "rawSourceArtifactHash":{"$ref":"#/$defs/hash"},
    "rawSourceBytesHash":{"$ref":"#/$defs/hash"},
    "rawSourceByteLength":{"type":"integer","minimum":2},
    "sourceLocatorHash":{"$ref":"#/$defs/hash"},
    "captureLane":{"enum":["A19","A07"]},
    "authenticatedSessionEvidenceHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "ownerAttestationReceiptHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "guardedProviderEventReceiptHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "zeroNaturalContentRequestHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "credentialLikeMaterialDetected":{"const":false},
    "capturedAt":{"type":"string","format":"date-time"},
    "expiresAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
