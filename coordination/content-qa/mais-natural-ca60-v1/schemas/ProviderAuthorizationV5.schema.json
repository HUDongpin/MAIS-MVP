{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/ProviderAuthorizationV5.schema.json",
  "title":"ProviderAuthorizationV5",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","compatibilityBaseRunnerRegistrationHash","freshRunnerReviewHash","authenticatedRouteEvidenceHash","referenceSealHash","referenceAttemptChainHash","provider","model","endpoint","projectResidency","dataRegion","projectIdentityHash","roleSet","compatibilityAuthorizationHash","compatibilityAuthorization","credentialReadAuthorized","providerExecutionAuthorized","naturalQuestionEgressAuthorized","tokenAuthorizationCreated","attemptAuthorizationCreated","usdAuthorizationCreated","maximumAttempts","maximumSuccessfulCalls","maximumInputTokens","maximumOutputTokens","maximumTokens","maximumEstimatedUsd","concurrencyCap","maximumAttemptsPerItemRole","issuedAt","expiresAt","authorizedBy","ownerAuthorizationTextHash","selfHash"],
  "properties":{
    "schemaVersion":{"const":"ProviderAuthorizationV5"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "compatibilityBaseRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "freshRunnerReviewHash":{"$ref":"#/$defs/hash"},
    "authenticatedRouteEvidenceHash":{"$ref":"#/$defs/hash"},
    "referenceSealHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "referenceAttemptChainHash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "provider":{"enum":["OPENAI_DIRECT","DEEPSEEK_DIRECT"]},
    "model":{"enum":["gpt-5.6-luna","deepseek-v4-pro"]},
    "endpoint":{"enum":["https://us.api.openai.com/v1/responses","https://api.deepseek.com/chat/completions"]},
    "projectResidency":{"type":"string","minLength":2},
    "dataRegion":{"type":"string","minLength":2},
    "projectIdentityHash":{"$ref":"#/$defs/hash"},
    "roleSet":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "compatibilityAuthorizationHash":{"$ref":"#/$defs/hash"},
    "compatibilityAuthorization":{"type":"object"},
    "credentialReadAuthorized":{"const":true},
    "providerExecutionAuthorized":{"const":true},
    "naturalQuestionEgressAuthorized":{"const":true},
    "tokenAuthorizationCreated":{"const":true},
    "attemptAuthorizationCreated":{"const":true},
    "usdAuthorizationCreated":{"const":true},
    "maximumAttempts":{"type":"integer","minimum":1,"maximum":850},
    "maximumSuccessfulCalls":{"type":"integer","minimum":1,"maximum":420},
    "maximumInputTokens":{"type":"integer","minimum":0,"maximum":6000000},
    "maximumOutputTokens":{"type":"integer","minimum":0,"maximum":6000000},
    "maximumTokens":{"type":"integer","minimum":1,"maximum":6000000},
    "maximumEstimatedUsd":{"type":"number","exclusiveMinimum":0,"maximum":25},
    "concurrencyCap":{"type":"integer","minimum":1,"maximum":4},
    "maximumAttemptsPerItemRole":{"const":2},
    "issuedAt":{"type":"string","format":"date-time"},
    "expiresAt":{"type":"string","format":"date-time"},
    "authorizedBy":{"type":"string","minLength":1},
    "ownerAuthorizationTextHash":{"$ref":"#/$defs/hash"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
