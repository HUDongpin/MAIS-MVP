{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mais.local/schemas/MachineReferenceSealV6.schema.json",
  "title":"MachineReferenceSealV6",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","designId","activeRunnerRegistrationHash","freshRunnerReviewHash","compatibilityRunnerRegistrationHash","compatibilityReferenceSealHash","openAIReferenceAuthorizationHash","compatibilityOpenAIReferenceAuthorizationHash","sampleExecutionInventoryHash","sampleManifestHash","samplePayloadSetHash","provider","model","endpoint","labelSourceType","humanGold","sameModelCorrelatedErrorRisk","itemCount","totalSuccessfulCallCount","totalAttemptCount","providerEventCountAtSeal","executionLedgerTerminalHash","attemptChainHash","attemptGraphReconstructionReceiptHash","roleAttemptEvidenceRootHash","rawResponseArtifactRootHash","rawResponseBindingRootHash","attemptCommitIntentRootHash","resolvedAttemptReceiptRootHash","finalLabelRoot","unresolvedCount","unresolvedWithinExecutionCap","labelBlindnessVerified","sealReconstructionStatus","sealedAt","selfHash"],
  "properties":{
    "schemaVersion":{"const":"MachineReferenceSealV6"},
    "designId":{"const":"MAIS-NATURAL-CA60-V5"},
    "activeRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "freshRunnerReviewHash":{"$ref":"#/$defs/hash"},
    "compatibilityRunnerRegistrationHash":{"$ref":"#/$defs/hash"},
    "compatibilityReferenceSealHash":{"$ref":"#/$defs/hash"},
    "openAIReferenceAuthorizationHash":{"$ref":"#/$defs/hash"},
    "compatibilityOpenAIReferenceAuthorizationHash":{"$ref":"#/$defs/hash"},
    "sampleExecutionInventoryHash":{"$ref":"#/$defs/hash"},
    "sampleManifestHash":{"$ref":"#/$defs/hash"},
    "samplePayloadSetHash":{"$ref":"#/$defs/hash"},
    "provider":{"const":"OPENAI_DIRECT"},
    "model":{"const":"gpt-5.6-luna"},
    "endpoint":{"const":"https://us.api.openai.com/v1/responses"},
    "labelSourceType":{"const":"machine_reference_panel"},
    "humanGold":{"const":false},
    "sameModelCorrelatedErrorRisk":{"const":true},
    "itemCount":{"const":60},
    "totalSuccessfulCallCount":{"type":"integer","minimum":240,"maximum":300},
    "totalAttemptCount":{"type":"integer","minimum":240,"maximum":610},
    "providerEventCountAtSeal":{"type":"integer","minimum":240,"maximum":610},
    "executionLedgerTerminalHash":{"$ref":"#/$defs/hash"},
    "attemptChainHash":{"$ref":"#/$defs/hash"},
    "attemptGraphReconstructionReceiptHash":{"$ref":"#/$defs/hash"},
    "roleAttemptEvidenceRootHash":{"$ref":"#/$defs/hash"},
    "rawResponseArtifactRootHash":{"$ref":"#/$defs/hash"},
    "rawResponseBindingRootHash":{"$ref":"#/$defs/hash"},
    "attemptCommitIntentRootHash":{"$ref":"#/$defs/hash"},
    "resolvedAttemptReceiptRootHash":{"$ref":"#/$defs/hash"},
    "finalLabelRoot":{"$ref":"#/$defs/hash"},
    "unresolvedCount":{"type":"integer","minimum":0,"maximum":60},
    "unresolvedWithinExecutionCap":{"type":"boolean"},
    "labelBlindnessVerified":{"const":true},
    "sealReconstructionStatus":{"const":"FULL_RAW_RESPONSE_REPARSE_AND_ATTEMPT_GRAPH_RECONSTRUCTION_BOUND_TO_R7"},
    "sealedAt":{"type":"string","format":"date-time"},
    "selfHash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
