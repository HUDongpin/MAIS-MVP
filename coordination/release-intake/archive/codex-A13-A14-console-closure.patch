+    projector: { en: "Projector", zh: "作答上屏" },
+    "screen-sync": { en: "Screen sync", zh: "手機同步" },
+    whiteboard: { en: "Whiteboard", zh: "白板批注" },
+    "math-workbench": { en: "Math tools", zh: "數學工具" }
+  };
