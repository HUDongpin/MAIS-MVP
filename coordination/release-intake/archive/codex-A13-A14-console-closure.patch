+  const bounded = Math.max(0, Math.floor(value));
+  const minutes = Math.floor(bounded / 60).toString().padStart(2, "0");
+  const seconds = (bounded % 60).toString().padStart(2, "0");
+  return `${minutes}:${seconds}`;
+}
