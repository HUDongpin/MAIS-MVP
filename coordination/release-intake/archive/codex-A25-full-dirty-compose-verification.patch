+async function withProviderEnv(env: Record<string, string | undefined>, run: () => void | Promise<void>) {
+  const keys = [
+    "DEEPSEEK_API_KEY",
+    "DEEPSEEK_API_URL",
+    "DEEPSEEK_MODEL",
+    "LLM_API_KEY",
+    "LLM_API_URL",
