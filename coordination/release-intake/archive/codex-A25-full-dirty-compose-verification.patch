+function defaultSampleMathPoint(coordinateSpace: CoordinateSpaceSpec): Vec3 {
+  return [
+    midpoint(coordinateSpace.mathRange.x),
+    midpoint(coordinateSpace.mathRange.y),
+    midpoint(coordinateSpace.mathRange.z)
+  ];
+}
