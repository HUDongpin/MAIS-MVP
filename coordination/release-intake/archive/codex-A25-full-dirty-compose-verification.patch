+  statement: XapiStatement;
+  fetcher: LrsFetch;
+}) {
+  let attempts = 0;
+  let lastError: LrsDeliveryError | null = null;
+
+  while (attempts < config.maxDeliveryAttempts) {
+    attempts += 1;
