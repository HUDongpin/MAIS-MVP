+  addPoint({ x: xMin, y: lineY(xMin) });
+  addPoint({ x: xMax, y: lineY(xMax) });
+  if (Math.abs(slope) > epsilon) {
+    addPoint({ x: x0 + (yMin - y0) / slope, y: yMin });
