+  const sizeLimits = useMemo(() => lessonTitleSizeLimits(title), [title]);
+
+  useLayoutEffect(() => {
+    const heading = titleRef.current;
+    if (!heading) return;
+
+    let animationFrame = 0;
+
+    function fitTitleToTwoLines() {
