+                    : item.submission.status === "correction-required"
+                      ? t({ en: "Submit correction", zh: "提交訂正", zhHans: "提交订正" })
+                      : t({ en: "Submit work", zh: "提交作業", zhHans: "提交作业" })}
+                </button>
+              </article>
+            ))}
+          </div>
+        </section>
+      ) : null}
+
+      {loadSecondaryPanels ? (
+        <>
+          <StudentMotivationHub />
+          <StudentRewardsPanel />
+        </>
+      ) : null}
     </div>
   );
 }
