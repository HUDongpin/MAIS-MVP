-      !eligibility.topicId ||
-      defeatedEnemies < adventureIslandMinCorrectQuestions ||
-      verifiedTopicAdventureIslandQuestionCount(database, studentId, correctQuestionIds, eligibility.topicId) < adventureIslandMinCorrectQuestions
-    ) {
