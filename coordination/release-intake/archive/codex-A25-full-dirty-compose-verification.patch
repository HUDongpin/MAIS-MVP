+  return {
+    curriculumTrack: "US_CA_MATH",
+    sourcePolicy: californiaSourcePolicy,
+    standardIds,
+    domainId: `CA.CCSS.Math.${domainCode}`,
+    domainTitle: domain.domainTitle,
+    clusterId: cluster?.clusterId,
+    capabilitySummary: domain.capabilitySummary
+  };
+}
