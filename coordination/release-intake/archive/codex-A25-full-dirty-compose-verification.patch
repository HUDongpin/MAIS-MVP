-type PracticeGameRoundValidation = {
-  reason: PracticeGameRoundValidationReason;
-  topicId: string | null;
-  topicTitle: LocalizedText | null;
-  roundKey: string;
-  roundQuestionIds: string[];
-  correctRoundQuestionIds: string[];
-  attemptedCount: number;
-  correctCount: number;
-  accuracyPercent: number;
-};
