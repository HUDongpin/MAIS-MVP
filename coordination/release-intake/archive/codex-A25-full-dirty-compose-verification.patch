-function pickCsvField(row: Record<string, string>, keys: string[]) {
-  for (const key of keys) {
-    const normalizedKey = key.toLowerCase().replace(/[\s_-]+/g, "");
-    if (row[normalizedKey]) return row[normalizedKey];
-  }
-  return "";
-}
