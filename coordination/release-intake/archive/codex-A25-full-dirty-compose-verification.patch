-  const lifetimeEarned = ledger.filter((entry) => entry.amount > 0).reduce((sum, entry) => sum + entry.amount, 0);
-  const spent = Math.abs(ledger.filter((entry) => entry.amount < 0).reduce((sum, entry) => sum + entry.amount, 0));
