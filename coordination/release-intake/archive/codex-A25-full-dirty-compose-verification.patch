+    const worldPoint = mapMathPointToWorld(mathPoint, coordinateSpace);
+    const roundTripPoint = mapWorldPointToMath(worldPoint, coordinateSpace);
+    if (!isFiniteVec3(worldPoint) || !isFiniteVec3(roundTripPoint)) return;
