+async function upsertPostgresProjectionRows<Row>(
+  sql: PostgresExecutor,
+  table: typeof postgresProjectionTableNames[number],
+  rows: Row[],
+  columns: readonly string[],
+  upsertBatch: (rows: Row[]) => Promise<void>
+) {
+  void sql;
+  if (!rows.length) return;
+
+  const batchSize = postgresBulkInsertBatchSize(columns.length);
+  for (let index = 0; index < rows.length; index += batchSize) {
+    const batch = rows.slice(index, index + batchSize);
+    if (batch.length > batchSize) {
+      throw new Error(`Postgres projection batch for ${table} exceeded ${batchSize} rows.`);
+    }
+    await upsertBatch(batch);
+  }
+}
