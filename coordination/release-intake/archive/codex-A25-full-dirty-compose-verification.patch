-      .map((event) => startOfUtcDay(new Date(event.created_at)).toISOString().slice(0, 10))
-  );
-  let cursor = startOfUtcDay(asOf);
-  let count = 0;
-
-  while (activeDates.has(cursor.toISOString().slice(0, 10))) {
