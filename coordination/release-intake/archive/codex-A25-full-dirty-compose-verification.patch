+  colorRole: string;
+  conceptId: string;
+  coordinateSystem: CoordinateSystem3D;
+  id: string;
+  uRange: Range2;
+  uSegments: number;
+  valueAt: (u: number, v: number, uProgress: number, vProgress: number) => Vec3;
+  vRange: Range2;
+  vSegments: number;
