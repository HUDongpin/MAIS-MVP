+export type LLMProviderCircuitBreaker = {
+  isOpen: (config: LLMProviderConfig) => boolean;
+  recordFailure: (config: LLMProviderConfig) => void;
+  recordSuccess: (config: LLMProviderConfig) => void;
+  snapshot: (config: LLMProviderConfig) => {
