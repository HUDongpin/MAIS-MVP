+function clippedLineSegment({
+  xMin,
+  xMax,
+  yMin,
+  yMax,
+  x0,
+  y0,
+  slope
+}: {
+  xMin: number;
+  xMax: number;
+  yMin: number;
+  yMax: number;
+  x0: number;
+  y0: number;
+  slope: number;
