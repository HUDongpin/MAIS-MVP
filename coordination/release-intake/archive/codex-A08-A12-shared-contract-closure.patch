-          topicId,
-          roundKey,
-          roundQuestionIds,
-          correctRoundQuestionIds
-        }),
-        reward: emptyReward,
-        gamification: summary()
-      };
-    }
-
-    if (decision.appliedRewardPoints > 0) {
-      database.reward_point_ledger.unshift({
-        id: `reward-ledger-${randomUUID()}`,
