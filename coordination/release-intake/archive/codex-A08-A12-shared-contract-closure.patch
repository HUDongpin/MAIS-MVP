+function postgresBulkInsertBatchSize(columnCount: number) {
+  if (!Number.isInteger(columnCount) || columnCount < 1) {
+    throw new Error(`Invalid Postgres bulk insert column count: ${columnCount}`);
+  }
+
+  return Math.max(1, Math.floor(maxPostgresParametersPerStatement / columnCount));
+}
