+async function readPostgresHotAuthRows(sql: PostgresExecutor): Promise<HotAuthRows> {
+  const userRows = await sql<Record<string, unknown>[]>`SELECT * FROM auth_users`;
+  const profileRows = await sql<Record<string, unknown>[]>`SELECT * FROM auth_student_profiles`;
+  const settingRows = await sql<Record<string, unknown>[]>`SELECT * FROM auth_user_settings`;
+  const resetRows = await sql<Record<string, unknown>[]>`SELECT * FROM auth_password_reset_tokens`;
+
+  return {
+    users: userRows.map(projectedUserRecordFromAuthSessionPersistence).filter((row): row is UserRecord => Boolean(row)),
+    studentProfiles: profileRows.map(projectedStudentProfileRecordFromAuthSessionPersistence).filter((row): row is StudentProfileRecord => Boolean(row)),
+    userSettings: settingRows.map(projectedUserSettingsRecordFromAuthSessionPersistence).filter((row): row is UserSettingsRecord => Boolean(row)),
+    passwordResetTokens: resetRows.map(projectedPasswordResetTokenRecordFromAuthSessionPersistence).filter((row): row is PasswordResetTokenRecord => Boolean(row))
+  };
+}
+
+async function readPostgresHotAuthRowsForUserIds(sql: PostgresExecutor, userIds: string[]): Promise<Pick<HotAuthRows, "users" | "studentProfiles" | "userSettings">> {
+  if (!userIds.length) return { users: [], studentProfiles: [], userSettings: [] };
+  const userRows = await sql<Record<string, unknown>[]>`SELECT * FROM auth_users WHERE id = ANY(${userIds})`;
+  const profileRows = await sql<Record<string, unknown>[]>`SELECT * FROM auth_student_profiles WHERE user_id = ANY(${userIds})`;
+  const settingRows = await sql<Record<string, unknown>[]>`SELECT * FROM auth_user_settings WHERE user_id = ANY(${userIds})`;
+
+  return {
+    users: userRows.map(projectedUserRecordFromAuthSessionPersistence).filter((row): row is UserRecord => Boolean(row)),
+    studentProfiles: profileRows.map(projectedStudentProfileRecordFromAuthSessionPersistence).filter((row): row is StudentProfileRecord => Boolean(row)),
+    userSettings: settingRows.map(projectedUserSettingsRecordFromAuthSessionPersistence).filter((row): row is UserSettingsRecord => Boolean(row))
+  };
+}
+
+async function overlayPostgresHotAuthRowsIfEnabled(sql: PostgresExecutor, database: Database) {
+  if (!postgresHotAuthTablesEnabled()) return database;
+
+  let hotRows = await readPostgresHotAuthRows(sql);
+  if (!hotRows.users.length && database.users.length) {
+    await syncPostgresHotAuthTablesWith(sql, database);
+    hotRows = await readPostgresHotAuthRows(sql);
+  }
+
+  return hotRows.users.length ? overlayAuthSessionDatabaseWithHotAuthRows(database, hotRows) as Database : database;
+}
