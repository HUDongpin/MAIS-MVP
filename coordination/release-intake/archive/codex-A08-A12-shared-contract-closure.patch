+async function deleteMissingPostgresProjectionRows(
+  sql: PostgresExecutor,
+  table: typeof postgresProjectionTableNames[number],
+  keyColumn: string,
+  keys: string[]
+) {
+  if (keys.length) {
+    await sql.unsafe(`DELETE FROM ${table} WHERE NOT (${keyColumn} = ANY($1))`, [keys]);
+    return;
+  }
+
+  await sql.unsafe(`DELETE FROM ${table}`);
+}
