+    return {
+      topicId: payload.topicId,
+      roundQuestionIds,
+      correctRoundQuestionIds,
+      accuracyPercent: payload.accuracyPercent,
+      roundKey: payload.roundKey
+    };
+  } catch {
+    return null;
