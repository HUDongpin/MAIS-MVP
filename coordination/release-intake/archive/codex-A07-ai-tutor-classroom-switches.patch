-type AutomaticRewardReason = Exclude<RewardPointReason, "teacher-award" | "redemption-spent">;
-
-function rewardEarnRuleFor(reason: AutomaticRewardReason) {
-  return rewardEarnRules.find((rule) => rule.id === reason) ?? null;
-}
