+++ b/scripts/release-governance.test.mjs
@@ -0,0 +1,162 @@
+import assert from "node:assert/strict";
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { spawnSync } from "node:child_process";
+import test from "node:test";
+
+const repoRoot = path.resolve(new URL("..", import.meta.url).pathname);
+
+function runNode(args, options = {}) {
+  return spawnSync(process.execPath, args, {
+    cwd: repoRoot,
+    encoding: "utf8",
+    env: {
+      ...process.env,
+      MAIS_RELEASE_MIN_FREE_GB: "1",
+      ...options.env
+    }
+  });
+}
+
+test("dirty map assert-current enforces a 60 minute freshness window", async () => {
+  const tempDir = await mkdtemp(path.join(tmpdir(), "mais-dirty-map-"));
+  const latestJson = path.join(tempDir, "latest-A25-dirty-tree-map.json");
+
+  try {
+    const refresh = runNode([
+      "scripts/refresh-dirty-tree-map.mjs",
+      "--latest-json",
+      latestJson,
+      "--no-report",
+      "--json",
+      "--reason",
+      "release governance test"
+    ]);
+    assert.equal(refresh.status, 0, `${refresh.stdout}\n${refresh.stderr}`);
+
+    const pass = runNode([
+      "scripts/refresh-dirty-tree-map.mjs",
+      "--assert-current",
+      "--latest-json",
+      latestJson,
+      "--max-age-minutes",
+      "60",
+      "--json"
+    ]);
+    assert.equal(pass.status, 0, `${pass.stdout}\n${pass.stderr}`);
+
+    const staleMap = JSON.parse(await readFile(latestJson, "utf8"));
+    staleMap.generatedAt = new Date(Date.now() - 61 * 60 * 1000).toISOString();
+    await writeFile(latestJson, `${JSON.stringify(staleMap, null, 2)}\n`);
+
+    const fail = runNode([
+      "scripts/refresh-dirty-tree-map.mjs",
+      "--assert-current",
+      "--latest-json",
+      latestJson,
+      "--max-age-minutes",
+      "60",
+      "--json"
+    ]);
+    assert.notEqual(fail.status, 0);
+    assert.match(`${fail.stdout}\n${fail.stderr}`, /older than 60 minutes/i);
+  } finally {
+    await rm(tempDir, { recursive: true, force: true });
+  }
+});
+
+test("dirty map assert-current blocks unmapped owner entries without blockers", async () => {
+  const tempDir = await mkdtemp(path.join(tmpdir(), "mais-dirty-map-unmapped-"));
+  const latestJson = path.join(tempDir, "latest-A25-dirty-tree-map.json");
+  const fixturePath = path.join(repoRoot, "zz-release-unmapped-fixture.tmpx");
+
+  try {
+    await writeFile(fixturePath, "temporary unmapped owner fixture\n");
+    const refresh = runNode([
+      "scripts/refresh-dirty-tree-map.mjs",
+      "--latest-json",
+      latestJson,
+      "--no-report",
+      "--json",
+      "--reason",
+      "unmapped owner test"
+    ]);
+    assert.equal(refresh.status, 0, `${refresh.stdout}\n${refresh.stderr}`);
+
+    const result = runNode([
+      "scripts/refresh-dirty-tree-map.mjs",
+      "--assert-current",
+      "--latest-json",
+      latestJson,
+      "--max-age-minutes",
+      "60",
+      "--json"
+    ]);
+
+    assert.notEqual(result.status, 0);
+    assert.match(`${result.stdout}\n${result.stderr}`, /unmapped owner/i);
+  } finally {
+    await rm(fixturePath, { force: true });
+    await rm(tempDir, { recursive: true, force: true });
+  }
+});
+
+test("package gate rejects dot staging and invalid final states", async () => {
+  const tempDir = await mkdtemp(path.join(tmpdir(), "mais-package-gate-"));
+  const manifestPath = path.join(tempDir, "owner-package-manifest.json");
+
+  try {
+    await writeFile(
+      manifestPath,
+      `${JSON.stringify({
+        packages: [
+          {
+            id: "bad-package",
+            owner: "A10",
+            pathspecs: ["."],
+            checks: ["npm run type-check"],
+            finalState: "maybe"
+          }
+        ]
+      }, null, 2)}\n`
+    );
+
+    const result = runNode([
+      "scripts/release-package-gate.mjs",
+      "--manifest",
+      manifestPath,
+      "--json"
+    ]);
+
+    assert.notEqual(result.status, 0);
+    assert.match(`${result.stdout}\n${result.stderr}`, /git add \./i);
+    assert.match(`${result.stdout}\n${result.stderr}`, /final state/i);
+  } finally {
+    await rm(tempDir, { recursive: true, force: true });
+  }
+});
+
+test("release source preflight freezes the dirty root unless pruned staging is owner-approved", () => {
+  const blocked = runNode(["scripts/release-env-guard.mjs", "source", "--json"], {
+    env: {
+      MAIS_RELEASE_SOURCE_ROOT: repoRoot,
+      MAIS_CANONICAL_RELEASE_ROOT: repoRoot,
+      MAIS_RELEASE_SOURCE_KIND: "root"
+    }
+  });
+
+  assert.notEqual(blocked.status, 0);
+  assert.match(`${blocked.stdout}\n${blocked.stderr}`, /root release is frozen/i);
+
+  const allowed = runNode(["scripts/release-env-guard.mjs", "source", "--json"], {
+    env: {
+      MAIS_RELEASE_SOURCE_ROOT: repoRoot,
+      MAIS_CANONICAL_RELEASE_ROOT: repoRoot,
+      MAIS_RELEASE_SOURCE_KIND: "pruned-staging",
+      MAIS_OWNER_APPROVED_PRUNED_STAGING: "1"
+    }
+  });
+
+  assert.equal(allowed.status, 0, `${allowed.stdout}\n${allowed.stderr}`);
+});
diff --git a/scripts/release-package-gate.mjs b/scripts/release-package-gate.mjs
new file mode 100644
index 000000000..9c3e51088
--- /dev/null
+++ b/scripts/release-package-gate.mjs
@@ -0,0 +1,129 @@
+#!/usr/bin/env node
+import fs from "node:fs/promises";
+import path from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const SCRIPT_DIR = path.dirname(fileURLToPath(import.meta.url));
+const REPO_ROOT = path.resolve(SCRIPT_DIR, "..");
+const DEFAULT_MANIFEST = path.join(REPO_ROOT, "coordination", "release-intake", "owner-package-manifest.json");
+const ALLOWED_FINAL_STATES = new Set([
+  "reviewed commit",
+  "owner-approved discard",
+  "evidence archive",
+  "blocker report"
+]);
+
+function parseArgs(argv) {
+  const options = {
+    manifest: DEFAULT_MANIFEST,
+    json: false
+  };
+
+  for (let index = 0; index < argv.length; index += 1) {
+    const arg = argv[index];
+    if (arg === "--manifest") {
+      options.manifest = resolvePath(argv[++index]);
+    } else if (arg === "--json") {
+      options.json = true;
+    } else {
+      throw new Error(`Unknown argument: ${arg}`);
+    }
+  }
+
+  return options;
+}
+
+function resolvePath(value) {
+  if (!value) throw new Error("Expected a path value.");
+  return path.isAbsolute(value) ? value : path.resolve(REPO_ROOT, value);
+}
+
+async function readJson(filePath) {
+  return JSON.parse(await fs.readFile(filePath, "utf8"));
+}
+
+function validatePackageManifest(manifest) {
+  const errors = [];
+  const packages = Array.isArray(manifest.packages) ? manifest.packages : [];
+
+  if (packages.length === 0) {
+    errors.push("owner-package-manifest.json must contain at least one package.");
+  }
+
+  for (const [index, pkg] of packages.entries()) {
+    const label = pkg?.id || `package[${index}]`;
+    const pathspecs = Array.isArray(pkg?.pathspecs) ? pkg.pathspecs : [];
+    const checks = Array.isArray(pkg?.checks) ? pkg.checks : [];
+
+    if (!pkg?.id) errors.push(`${label}: missing id.`);
+    if (!pkg?.owner) errors.push(`${label}: missing owner.`);
+    if (pathspecs.length === 0) errors.push(`${label}: missing pathspecs.`);
+    if (checks.length === 0) errors.push(`${label}: missing checks.`);
+    if (!ALLOWED_FINAL_STATES.has(pkg?.finalState)) {
+      errors.push(`${label}: invalid final state "${pkg?.finalState}". Allowed final states: ${[...ALLOWED_FINAL_STATES].join(", ")}.`);
+    }
+
+    for (const pathspec of pathspecs) {
+      if (isForbiddenDotPathspec(pathspec)) {
+        errors.push(`${label}: pathspec "${pathspec}" is forbidden because it enables git add .; use owner pathspecs instead.`);
+      }
+      if (typeof pathspec !== "string" || pathspec.trim() === "") {
+        errors.push(`${label}: pathspecs must be non-empty strings.`);
+      }
+      if (String(pathspec).includes("\0")) {
+        errors.push(`${label}: pathspec contains a NUL byte.`);
+      }
+    }
+
+    if (pkg?.finalState === "blocker report" && !pkg?.blocker) {
+      errors.push(`${label}: blocker report final state requires a blocker explanation.`);
+    }
+  }
+
+  return {
+    valid: errors.length === 0,
+    errors,
+    packageCount: packages.length,
+    allowedFinalStates: [...ALLOWED_FINAL_STATES],
+    packages: packages.map((pkg) => ({
+      id: pkg.id,
+      owner: pkg.owner,
+      pathspecCount: Array.isArray(pkg.pathspecs) ? pkg.pathspecs.length : 0,
+      checkCount: Array.isArray(pkg.checks) ? pkg.checks.length : 0,
+      finalState: pkg.finalState
+    }))
+  };
+}
+
+function isForbiddenDotPathspec(pathspec) {
+  const normalized = String(pathspec).trim();
+  return normalized === "." || normalized === "./" || normalized === ":/" || normalized === "*" || normalized === "**";
+}
+
+async function main() {
+  const options = parseArgs(process.argv.slice(2));
+  const manifest = await readJson(options.manifest);
+  const result = validatePackageManifest(manifest);
+
+  if (!result.valid) {
+    if (options.json) {
+      console.log(JSON.stringify(result, null, 2));
+    }
+    throw new Error(["Owner package gate failed:", ...result.errors.map((error) => `- ${error}`)].join("\n"));
+  }
+
+  if (options.json) {
+    console.log(JSON.stringify(result, null, 2));
+    return;
+  }
+
+  console.log("Owner package gate passed");
+  console.log(`Packages: ${result.packageCount}`);
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  main().catch((error) => {
+    console.error(error instanceof Error ? error.message : String(error));
+    process.exitCode = 1;
+  });
+}
