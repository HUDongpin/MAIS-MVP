+    status.statusEntries === 0 &&
+    status.trackedModified === 0 &&
+    status.trackedDeleted === 0 &&
+    status.untrackedFiles === 0;
+
+  if (sourceRoot === canonicalRoot && kind !== "owner-approved-pruned-staging") {
+    fail(formatRootFreezeBlock({ sourceRoot, canonicalRoot, kind, status }));
+  }
+
+  if (kind === "owner-approved-pruned-staging") {
