+    cwd: REPO_ROOT,
+    encoding: "utf8",
+    maxBuffer: 64 * 1024 * 1024
+  });
+}
+
+function summarizeGitStatus() {
+  const statusLines = gitOutput(["status", "--porcelain=v1"])
