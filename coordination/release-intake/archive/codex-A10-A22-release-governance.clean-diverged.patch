+      fail(
+        [
+          "Owner-approved pruned staging was selected, but MAIS_OWNER_APPROVED_PRUNED_STAGING=1 is not set.",
+          "A22 may use pruned staging only after explicit owner approval."
+        ].join("\n")
+      );
+    }
+    return {
+      sourceRoot,
+      canonicalRoot,
+      kind,
+      clean,
+      ownerApprovedPrunedStaging: true,
