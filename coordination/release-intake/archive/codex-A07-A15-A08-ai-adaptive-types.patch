+    "QWEN_API_URL",
+    "QWEN_IMAGE_MODEL",
+    "QWEN_TEXT_MODEL"
+  ];
+  const original = Object.fromEntries(keys.map((key) => [key, process.env[key]]));
+
+  keys.forEach((key) => {
+    delete process.env[key];
+  });
+  Object.entries(env).forEach(([key, value]) => {
+    if (value === undefined) delete process.env[key];
+    else process.env[key] = value;
+  });
+
+  try {
+    await run();
+  } finally {
+    keys.forEach((key) => {
