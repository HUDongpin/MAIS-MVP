  "findings": [
    {
      "id": "HISTORY-GRAFT-01",
      "priority": "P1",
      "blocking": true,
      "title": "Git graft metadata can remove an authority-changing real merge parent from the collected graph",
      "path": "scripts/promotion-reaffirmation-history.mjs",
      "line": 122,
      "relatedLines": [
        97,
        117,
        136,
        154
      ],
      "condition": "The repository has an effective info/grafts record that presents a three-parent merge as a two-parent merge. This was created only in an independent temporary fixture, not in the MAIS repository.",
      "observed": "Without the graft, the real third parent changes authority and AUTHORITY_MERGE_CHANGE is raised. With a graft listing only the two safe parents, collectPromotionReaffirmationHistory succeeds and returns only the original binding two A events plus the Receipt A. cat-file -p still confirms the raw commit has all three parents.",
      "rootCause": "--no-replace-objects excludes replace refs but does not disable info/grafts. rev-list --parents and merge-base use the graft-rewritten graph. The parent-to-result loop therefore never checks the omitted real third parent.",
      "impact": "The helper cannot currently prove the claimed complete real parent graph or that all reachable authority changes are rejected. A canonical final tree and apparently valid atomic/Receipt events are insufficient when a real parent is hidden.",
      "minimumRemediation": "Make graph and ancestry collection independent of effective graft metadata, or fail closed before collection when such metadata is active; bind the graph parent arrays to actual commit object parents as appropriate. Add the true temporary Git negative case and retain all current ordinary-merge positives.",
      "reproduction": {
        "script": "/private/tmp/mais-history-review/probes.mjs",
        "case": "graft metadata cannot hide a real third parent authority mutation",
