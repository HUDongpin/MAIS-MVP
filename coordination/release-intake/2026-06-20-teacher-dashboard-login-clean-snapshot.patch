+import assert from "node:assert/strict";
+import test from "node:test";
+
+process.env.AUTH_SESSION_SECRET ??= "api-me-route-test-secret";
+
+test("GET /api/me skips lesson entry lookup when includeLessonEntry is false", async () => {
+  const [{ createSessionToken, SESSION_COOKIE_NAME }, { GET }] = await Promise.all([
+    import("@/lib/session"),
+    import("./route")
+  ]);
+  const token = await createSessionToken("student-shirleen-us");
+  const request = new Request("https://mais.hk/api/me?includeLessonEntry=false", {
+    headers: {
+      cookie: `${SESSION_COOKIE_NAME}=${encodeURIComponent(token)}`
+    }
+  });
+
+  const startedAt = Date.now();
+  const response = await GET(request);
+  const durationMs = Date.now() - startedAt;
+  const body = await response.json();
+
+  assert.equal(response.status, 200);
+  assert.equal(body.user.id, "student-shirleen-us");
+  assert.equal(body.user.role, "student");
+  assert.equal("lessonEntryTarget" in body, false);
+  assert.ok(durationMs < 500, `includeLessonEntry=false should not read full lesson storage; took ${durationMs}ms`);
+});
