+async function getTeacherShellDataFromPostgresProjection(userId: string): Promise<TeacherShellData | null | undefined> {
+  if (storageProvider !== "postgres") return undefined;
+
+  try {
+    await ensurePostgresStateTable();
+    const rows = await getPostgresClient()<TeacherShellProjectionRow[]>`
+      WITH user_match AS (
+        SELECT
+          state.payload,
+          user_items.user_record
+        FROM app_state AS state
+        CROSS JOIN LATERAL jsonb_array_elements(COALESCE(state.payload->'users', '[]'::jsonb)) AS user_items(user_record)
+        WHERE state.id = ${stateRecordId}
+          AND user_items.user_record->>'id' = ${userId}
+        LIMIT 1
+      ),
+      class_records AS (
+        SELECT class_items.class_record
+        FROM user_match
+        CROSS JOIN LATERAL jsonb_array_elements(COALESCE(user_match.payload->'teacher_classes', '[]'::jsonb)) AS class_items(class_record)
+        WHERE class_items.class_record->>'teacher_id' = ${userId}
+          OR EXISTS (
+            SELECT 1
+            FROM jsonb_array_elements(COALESCE(user_match.payload->'school_memberships', '[]'::jsonb)) AS membership_items(membership_record)
+            WHERE membership_items.membership_record->>'user_id' = ${userId}
+              AND membership_items.membership_record->>'class_id' = class_items.class_record->>'id'
+              AND membership_items.membership_record->>'role' IN ('teacher', 'admin')
+          )
+      )
+      SELECT
+        user_match.user_record AS user_record,
+        (
+          SELECT profile_record
+          FROM jsonb_array_elements(COALESCE(user_match.payload->'student_profiles', '[]'::jsonb)) AS profile_items(profile_record)
+          WHERE profile_record->>'user_id' = user_match.user_record->>'id'
+          LIMIT 1
+        ) AS profile_record,
+        (
+          SELECT settings_record
+          FROM jsonb_array_elements(COALESCE(user_match.payload->'user_settings', '[]'::jsonb)) AS settings_items(settings_record)
+          WHERE settings_record->>'user_id' = user_match.user_record->>'id'
+          LIMIT 1
+        ) AS settings_record,
+        COALESCE((SELECT jsonb_agg(class_record) FROM class_records), '[]'::jsonb) AS class_records,
+        COALESCE((
+          SELECT jsonb_agg(enrollment_record)
+          FROM jsonb_array_elements(COALESCE(user_match.payload->'class_enrollments', '[]'::jsonb)) AS enrollment_items(enrollment_record)
+          WHERE EXISTS (
+            SELECT 1
+            FROM class_records
+            WHERE class_records.class_record->>'id' = enrollment_items.enrollment_record->>'class_id'
+          )
+        ), '[]'::jsonb) AS enrollment_records
+      FROM user_match
+      LIMIT 1
+    `;
+
+    const row = rows[0];
+    if (!row) return null;
+
+    const user = projectedRecord<UserRecord>(row.user_record);
+    if (!canUseTeacherArea(user)) return null;
+    if (user.role === "admin") return undefined;
+
+    const profile = projectedRecord<StudentProfileRecord>(row.profile_record);
+    if (!profile) return null;
+
+    const session = toAuthenticatedUserFromRecords(user, profile, projectedRecord<UserSettingsRecord>(row.settings_record));
+    if (!session) return null;
+
+    return {
+      teacher: session.user,
+      classes: teacherClassesFromProjectedRecords({
+        classRecords: projectionArray<TeacherClassRecord>(row.class_records),
+        enrollmentRecords: projectionArray<ClassEnrollmentRecord>(row.enrollment_records),
+        teacher: session.user
+      })
+    };
+  } catch {
+    return undefined;
+  }
+}
