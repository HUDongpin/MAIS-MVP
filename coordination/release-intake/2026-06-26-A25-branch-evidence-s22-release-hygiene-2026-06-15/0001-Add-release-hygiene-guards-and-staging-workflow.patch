+      project,
+      target: "production",
+      stagingDir: staging.stagingDir,
+      stagingFileCount: staging.fileCount,
+      stagingTotalBytes: staging.totalBytes,
+      forbiddenPathCount: staging.forbiddenPathCount,
+      deployed: false
+    };
+  }
+
+  const deployArgs = [
+    "deploy",
+    staging.stagingDir,
+    "-y",
+    "--prod",
+    "--scope",
