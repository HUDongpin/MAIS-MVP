{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.local/schemas/NaturalCaDesignActivationReceiptV1.schema.json",
  "title": "NaturalCaDesignActivationReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "designFamily",
    "designId",
    "registrationHash",
    "v5PackageRootHash",
    "priorActiveDesignId",
    "priorActiveRegistrationHash",
    "priorActivePointerHash",
    "newActivePointerHash",
    "a11ReviewCommit",
    "independentVerificationHash",
    "reviewReceiptHash",
    "reviewDecision",
    "runnerCommit",
    "runnerSourceManifestRootHash",
    "runnerHash",
    "adapterHash",
    "custodyRegistryHash",
    "activatedAt",
    "activationAuthorityBasis",
    "providerEventCountAtActivation",
    "firstProviderExecutionAllowed",
    "providerExecutionAuthorizationCreated",
    "frameRegistrationHash",
    "sampleManifestHash",
    "openaiProjectRoutePreflightReceiptHash",
    "openaiAuthorizationHash",
    "referenceLabelSealHash",
    "deepSeekAuthorizationHash",
    "executionRegistrationHash",
    "decisionCeiling",
    "claimScopeCeiling",
    "postActivationBlockers",
    "supersedesActivePointerHash",
    "selfHash"
  ],
  "properties": {
    "schemaVersion": { "const": "NaturalCaDesignActivationReceiptV1" },
    "artifactKind": { "const": "APPEND_ONLY_METHOD_REGISTRATION_ACTIVATION_NOT_EXECUTION_AUTHORIZATION" },
    "designFamily": { "const": "MAIS-NATURAL-CA60" },
    "designId": { "const": "MAIS-NATURAL-CA60-V5" },
    "registrationHash": { "$ref": "#/$defs/sha256" },
    "v5PackageRootHash": { "$ref": "#/$defs/sha256" },
    "priorActiveDesignId": { "const": "MAIS-NATURAL-CA60-V3" },
    "priorActiveRegistrationHash": { "$ref": "#/$defs/sha256" },
    "priorActivePointerHash": { "$ref": "#/$defs/sha256" },
    "newActivePointerHash": { "$ref": "#/$defs/sha256" },
    "a11ReviewCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "independentVerificationHash": { "$ref": "#/$defs/sha256" },
    "reviewReceiptHash": { "$ref": "#/$defs/sha256" },
    "reviewDecision": { "const": "CONCURRED" },
    "runnerCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runnerSourceManifestRootHash": { "$ref": "#/$defs/sha256" },
    "runnerHash": { "$ref": "#/$defs/sha256" },
    "adapterHash": { "$ref": "#/$defs/sha256" },
    "custodyRegistryHash": { "$ref": "#/$defs/sha256" },
    "activatedAt": { "type": "string", "format": "date-time" },
    "activationAuthorityBasis": { "const": "OWNER_REQUESTED_PLAN_IMPLEMENTATION_AFTER_REQUIRED_A11_REVIEW" },
    "providerEventCountAtActivation": { "const": 0 },
    "firstProviderExecutionAllowed": { "const": false },
    "providerExecutionAuthorizationCreated": { "const": false },
    "frameRegistrationHash": { "type": "null" },
    "sampleManifestHash": { "type": "null" },
    "openaiProjectRoutePreflightReceiptHash": { "type": "null" },
    "openaiAuthorizationHash": { "type": "null" },
    "referenceLabelSealHash": { "type": "null" },
    "deepSeekAuthorizationHash": { "type": "null" },
    "executionRegistrationHash": { "type": "null" },
    "decisionCeiling": { "const": "INCONCLUSIVE_MACHINE_REFERENCE" },
    "claimScopeCeiling": { "const": "CALIFORNIA_RUNTIME_EGRESS_ELIGIBLE_MACHINE_REFERENCE_PILOT_ONLY" },
    "postActivationBlockers": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "FINE_GRAINED_LINEAGE_AND_RIGHTS_BINDING_REQUIRED" },
        { "const": "A22_CLEAN_EXECUTION_ENVIRONMENT_REQUIRED" },
        { "const": "FRAME_REGISTRATION_REQUIRED" },
        { "const": "SAMPLE_REGISTRATION_REQUIRED" },
        { "const": "OPENAI_PROJECT_ROUTE_PREFLIGHT_REQUIRED" },
        { "const": "OPENAI_CREDENTIAL_READINESS_REQUIRED" },
        { "const": "CURRENT_OPENAI_PRICE_SNAPSHOT_REQUIRED" },
        { "const": "HASH_BOUND_OPENAI_AUTHORIZATION_REQUIRED" },
        { "const": "REFERENCE_LABEL_SEAL_REQUIRED" },
        { "const": "DEEPSEEK_ROUTE_PROBE_REQUIRED" },
        { "const": "HASH_BOUND_DEEPSEEK_AUTHORIZATION_REQUIRED" },
        { "const": "EXECUTION_REGISTRATION_REQUIRED" }
      ],
      "items": false
    },
    "supersedesActivePointerHash": { "$ref": "#/$defs/sha256" },
    "selfHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
