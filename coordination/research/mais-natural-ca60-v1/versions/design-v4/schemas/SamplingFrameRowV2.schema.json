{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/SamplingFrameRowV2.schema.json",
  "title": "SamplingFrameRowV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "registrationHash", "frameFrozenAt", "itemId", "itemHash", "sourceCommit", "runtimeConfigHash", "region", "curriculumProfile", "grade", "canonicalTopic", "topicId", "responseForm", "difficulty", "prompt", "topic", "options", "answer", "storedAnswer", "acceptedAnswers", "explanation", "diagram", "questionAssets", "localePolicy", "rubric", "sourceIds", "sourceModuleHash", "exactDuplicateGroupId", "homologyClusterId", "clusterId", "sourceClusterId", "eligible", "exclusionCode", "inclusionProbability", "analysisWeight", "analysisWeightPurpose", "clusterInclusionProbability", "representativeSelectionProbability", "runtimeOrigin", "runtimeVisible", "egressEligibility", "egressRights", "serializationStatus", "answerPresent", "optionsPresent", "explanationPresent", "normalizedPromptHash", "templateSkeletonHash", "lineageKind", "lineageKeyHash", "packageId", "batchId", "generationTemplate", "sourceLessonSlug", "sourceModule", "assignedClusterStratum", "clusterRepresentative", "provenanceType", "rowHash"],
  "properties": {
    "schemaVersion": { "const": "SamplingFrameRowV2" }, "designId": { "const": "MAIS-NATURAL-CA60-V4" }, "registrationHash": { "$ref": "#/$defs/sha256" }, "frameFrozenAt": { "type": "string", "format": "date-time" }, "itemId": { "$ref": "#/$defs/id" }, "itemHash": { "$ref": "#/$defs/sha256" }, "sourceCommit": { "$ref": "#/$defs/gitOid" }, "runtimeConfigHash": { "$ref": "#/$defs/sha256" },
    "region": { "const": "CALIFORNIA" }, "curriculumProfile": { "const": "US_CA_MATH" }, "grade": { "enum": ["K", "P1", "P2", "P3", "P4", "P5", "P6", "S1", "S2", "S3", "S4", "S5", "S6"] }, "canonicalTopic": { "$ref": "#/$defs/nonempty" }, "topicId": { "$ref": "#/$defs/nullableString" }, "responseForm": { "$ref": "#/$defs/responseForm" }, "difficulty": { "$ref": "#/$defs/difficulty" },
    "prompt": { "$ref": "#/$defs/localizedText" }, "topic": { "$ref": "#/$defs/localizedText" }, "options": { "type": ["array", "null"], "items": { "$ref": "#/$defs/localizedText" } }, "answer": { "type": ["string", "null"] }, "storedAnswer": { "type": ["string", "null"] }, "acceptedAnswers": { "type": ["array", "null"], "items": { "type": "string" } }, "explanation": { "anyOf": [{ "$ref": "#/$defs/localizedText" }, { "type": "null" }] }, "diagram": {}, "questionAssets": { "type": ["array", "null"], "items": {} }, "localePolicy": { "const": "FULL_RUNTIME_LOCALIZED_BUNDLE" }, "rubric": { "const": "MAIS_NATURAL_CA60_QA_RUBRIC_V4" }, "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "sourceModuleHash": { "$ref": "#/$defs/sha256" }, "exactDuplicateGroupId": { "$ref": "#/$defs/id" }, "homologyClusterId": { "$ref": "#/$defs/id" }, "clusterId": { "type": ["string", "null"], "minLength": 1 }, "sourceClusterId": { "$ref": "#/$defs/nullableString" },
    "eligible": { "type": "boolean" }, "exclusionCode": { "anyOf": [{ "$ref": "#/$defs/exclusion" }, { "type": "null" }] }, "inclusionProbability": { "$ref": "#/$defs/nonnegativeProbability" }, "analysisWeight": { "$ref": "#/$defs/nonnegative" }, "analysisWeightPurpose": { "enum": ["SECONDARY_CLUSTER_REPRESENTATIVE_INVENTORY_IPW", "OUTSIDE_SECONDARY_ESTIMAND_NONREPRESENTATIVE", "EXCLUDED_FROM_ALL_ESTIMANDS"] }, "clusterInclusionProbability": { "$ref": "#/$defs/nonnegativeProbability" }, "representativeSelectionProbability": { "enum": [0, 1] },
    "runtimeOrigin": { "const": "QUESTION_STORE_AUTHENTICATED_STUDENT_PROJECTION" }, "runtimeVisible": { "type": "boolean" }, "egressEligibility": { "enum": ["ELIGIBLE", "INELIGIBLE_CLOSED_EXCLUSION"] }, "egressRights": { "type": "object", "additionalProperties": false, "required": ["piiScreenPassed", "secretsScreenPassed", "copyrightExternalizationAuthorized", "providerEgressAllowed"], "properties": { "piiScreenPassed": { "type": "boolean" }, "secretsScreenPassed": { "type": "boolean" }, "copyrightExternalizationAuthorized": { "type": "boolean" }, "providerEgressAllowed": { "type": "boolean" } } }, "serializationStatus": { "const": "SERIALIZED" },
    "answerPresent": { "type": "boolean" }, "optionsPresent": { "type": "boolean" }, "explanationPresent": { "type": "boolean" }, "normalizedPromptHash": { "$ref": "#/$defs/sha256" }, "templateSkeletonHash": { "$ref": "#/$defs/sha256" }, "lineageKind": { "anyOf": [{ "enum": ["K5", "G6_12", "CCSS"] }, { "type": "null" }] }, "lineageKeyHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "packageId": { "$ref": "#/$defs/nullableString" }, "batchId": { "$ref": "#/$defs/nullableString" }, "generationTemplate": { "$ref": "#/$defs/nullableString" }, "sourceLessonSlug": { "$ref": "#/$defs/nullableString" }, "sourceModule": { "$ref": "#/$defs/nullableString" }, "assignedClusterStratum": { "$ref": "#/$defs/nullableStratum" }, "clusterRepresentative": { "type": "boolean" }, "provenanceType": { "const": "RUNTIME_NATURAL_ITEM" }, "rowHash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    { "if": { "properties": { "eligible": { "const": true } }, "required": ["eligible"] }, "then": { "properties": { "runtimeVisible": { "const": true }, "exclusionCode": { "type": "null" }, "egressEligibility": { "const": "ELIGIBLE" }, "egressRights": { "properties": { "piiScreenPassed": { "const": true }, "secretsScreenPassed": { "const": true }, "copyrightExternalizationAuthorized": { "const": true }, "providerEgressAllowed": { "const": true } } }, "serializationStatus": { "const": "SERIALIZED" }, "clusterInclusionProbability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "assignedClusterStratum": { "$ref": "#/$defs/stratum" } } } },
    { "if": { "properties": { "eligible": { "const": false } }, "required": ["eligible"] }, "then": { "properties": { "exclusionCode": { "$ref": "#/$defs/exclusion" }, "egressEligibility": { "const": "INELIGIBLE_CLOSED_EXCLUSION" }, "inclusionProbability": { "const": 0 }, "analysisWeight": { "const": 0 }, "clusterInclusionProbability": { "const": 0 }, "representativeSelectionProbability": { "const": 0 }, "assignedClusterStratum": { "type": "null" }, "clusterRepresentative": { "const": false }, "analysisWeightPurpose": { "const": "EXCLUDED_FROM_ALL_ESTIMANDS" } } } },
    { "if": { "properties": { "eligible": { "const": true }, "clusterRepresentative": { "const": true } }, "required": ["eligible", "clusterRepresentative"] }, "then": { "properties": { "inclusionProbability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "analysisWeight": { "type": "number", "exclusiveMinimum": 0 }, "representativeSelectionProbability": { "const": 1 }, "analysisWeightPurpose": { "const": "SECONDARY_CLUSTER_REPRESENTATIVE_INVENTORY_IPW" } } } },
    { "if": { "properties": { "eligible": { "const": true }, "clusterRepresentative": { "const": false } }, "required": ["eligible", "clusterRepresentative"] }, "then": { "properties": { "inclusionProbability": { "const": 0 }, "analysisWeight": { "const": 0 }, "representativeSelectionProbability": { "const": 0 }, "analysisWeightPurpose": { "const": "OUTSIDE_SECONDARY_ESTIMAND_NONREPRESENTATIVE" } } } }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "gitOid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }, "nonempty": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1, "pattern": "^[^|]+$" }, "nullableString": { "type": ["string", "null"] }, "localizedText": { "type": "object", "additionalProperties": false, "required": ["en", "zh"], "properties": { "en": { "type": "string", "minLength": 1 }, "zh": { "type": "string", "minLength": 1 }, "zhHans": { "type": "string", "minLength": 1 } } }, "responseForm": { "enum": ["multiple-choice", "fill-in", "short-answer"] }, "difficulty": { "enum": ["Low", "Medium", "High"] }, "stratum": { "type": "string", "pattern": "^(multiple-choice|fill-in|short-answer)::(Low|Medium|High)$" }, "nullableStratum": { "anyOf": [{ "$ref": "#/$defs/stratum" }, { "type": "null" }] }, "exclusion": { "enum": ["NON_CA_TRACK", "RUNTIME_NOT_VISIBLE", "SYNTHETIC_TEST_CANDIDATE_ONLY", "RESTRICTED_EGRESS_CONTENT", "UNSTABLE_SERIALIZATION"] }, "nonnegativeProbability": { "type": "number", "minimum": 0, "maximum": 1 }, "nonnegative": { "type": "number", "minimum": 0 }
  }
}
