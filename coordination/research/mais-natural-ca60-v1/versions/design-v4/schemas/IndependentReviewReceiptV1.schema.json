{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/IndependentReviewReceiptV1.schema.json",
  "title": "IndependentReviewReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "designId", "reviewerLane", "reviewerPseudonym", "provenanceType",
    "humanReferenceClaimAllowed", "sourceArtifactsReadOnly", "mainScorerImported",
    "independenceAttestation", "mainScorerImplementationHash", "mainScorerDependencyHash",
    "verifierProofHash", "recomputationImplementationHash", "recomputationDependencyHash",
    "recomputationImportGraphHash", "forbiddenScorerScanHash", "verificationCommandHash",
    "verificationRuntimeHash", "verificationBaselineProofHash", "reviewedItems", "reviewedItemCount",
    "reviewedAttemptCount", "reviewStatus", "discrepancyCodes", "unreviewableReason", "reviewedAt",
    "previousReceiptHash", "recomputedFrameHash", "recomputedSampleHash",
    "recomputedRuntimeSourceEnumerationRootHash", "independentSourceEnumerationReceiptHash",
    "recomputedReferenceSealHash",
    "recomputedQwenAttemptChainHash", "recomputedDeepSeekAttemptChainHash", "recomputedItemResultSetHash",
    "recomputedObservedLedgerHash", "recomputedCounterfactualLedgerHash", "recomputedMatchingHash",
    "recomputedMetricSetHash", "recomputedDecision", "activeDesignRegistrationHash",
    "activeExecutionRegistrationHash", "latestFinalEvaluationReceiptHash", "referenceSealHash",
    "frameRegistrationHash", "sampleManifestHash", "thresholdHash", "taxonomyHash", "labelSchemaHash",
    "adjudicationMethodHash", "severityRuleHash", "promptSetHash", "schemaSetHash", "runnerHash",
    "adapterHash", "statisticalPowerHash", "designSupersedesHash", "methodComponentRootSetHash", "reviewLedgerHeadHash",
    "finalFinishedAt", "receiptHash"
  ],
  "properties": {
    "schemaVersion": { "const": "IndependentReviewReceiptV1" },
    "designId": { "const": "MAIS-NATURAL-CA60-V4" },
    "reviewerLane": { "const": "A11" },
    "reviewerPseudonym": { "type": "string", "minLength": 1 },
    "provenanceType": { "const": "A11_INDEPENDENT_RECOMPUTATION" },
    "humanReferenceClaimAllowed": { "const": false },
    "sourceArtifactsReadOnly": { "const": true },
    "mainScorerImported": { "const": false },
    "independenceAttestation": { "const": "PROCESS_ATTESTATION_NOT_MACHINE_PROOF" },
    "mainScorerImplementationHash": { "$ref": "#/$defs/sha256" },
    "mainScorerDependencyHash": { "$ref": "#/$defs/sha256" },
    "verifierProofHash": { "$ref": "#/$defs/sha256" },
    "recomputationImplementationHash": { "$ref": "#/$defs/sha256" },
    "recomputationDependencyHash": { "$ref": "#/$defs/sha256" },
    "recomputationImportGraphHash": { "$ref": "#/$defs/sha256" },
    "forbiddenScorerScanHash": { "$ref": "#/$defs/sha256" },
    "verificationCommandHash": { "$ref": "#/$defs/sha256" },
    "verificationRuntimeHash": { "$ref": "#/$defs/sha256" },
    "verificationBaselineProofHash": { "$ref": "#/$defs/sha256" },
    "reviewedItems": { "type": "array", "minItems": 60, "maxItems": 60, "uniqueItems": true, "items": { "$ref": "#/$defs/reviewedItem" } },
    "reviewedItemCount": { "const": 60 },
    "reviewedAttemptCount": { "type": "integer", "minimum": 0, "maximum": 1460 },
    "reviewStatus": { "enum": ["CONCURRED", "DISCREPANCY", "UNREVIEWABLE"] },
    "discrepancyCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "unreviewableReason": { "type": ["string", "null"] },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "previousReceiptHash": { "$ref": "#/$defs/sha256" },
    "recomputedFrameHash": { "$ref": "#/$defs/sha256" },
    "recomputedSampleHash": { "$ref": "#/$defs/sha256" },
    "recomputedRuntimeSourceEnumerationRootHash": { "$ref": "#/$defs/sha256" },
    "independentSourceEnumerationReceiptHash": { "$ref": "#/$defs/sha256" },
    "recomputedReferenceSealHash": { "$ref": "#/$defs/sha256" },
    "recomputedQwenAttemptChainHash": { "$ref": "#/$defs/sha256" },
    "recomputedDeepSeekAttemptChainHash": { "$ref": "#/$defs/sha256" },
    "recomputedItemResultSetHash": { "$ref": "#/$defs/sha256" },
    "recomputedObservedLedgerHash": { "$ref": "#/$defs/sha256" },
    "recomputedCounterfactualLedgerHash": { "$ref": "#/$defs/sha256" },
    "recomputedMatchingHash": { "$ref": "#/$defs/sha256" },
    "recomputedMetricSetHash": { "$ref": "#/$defs/sha256" },
    "recomputedDecision": { "$ref": "#/$defs/conclusion" },
    "activeDesignRegistrationHash": { "$ref": "#/$defs/sha256" },
    "activeExecutionRegistrationHash": { "$ref": "#/$defs/sha256" },
    "latestFinalEvaluationReceiptHash": { "$ref": "#/$defs/sha256" },
    "referenceSealHash": { "$ref": "#/$defs/sha256" },
    "frameRegistrationHash": { "$ref": "#/$defs/sha256" },
    "sampleManifestHash": { "$ref": "#/$defs/sha256" },
    "thresholdHash": { "$ref": "#/$defs/sha256" },
    "taxonomyHash": { "$ref": "#/$defs/sha256" },
    "labelSchemaHash": { "$ref": "#/$defs/sha256" },
    "adjudicationMethodHash": { "$ref": "#/$defs/sha256" },
    "severityRuleHash": { "$ref": "#/$defs/sha256" },
    "promptSetHash": { "$ref": "#/$defs/sha256" },
    "schemaSetHash": { "$ref": "#/$defs/sha256" },
    "runnerHash": { "$ref": "#/$defs/sha256" },
    "adapterHash": { "$ref": "#/$defs/sha256" },
    "statisticalPowerHash": { "$ref": "#/$defs/sha256" },
    "designSupersedesHash": { "$ref": "#/$defs/sha256" },
    "methodComponentRootSetHash": { "$ref": "#/$defs/sha256" },
    "reviewLedgerHeadHash": { "$ref": "#/$defs/sha256" },
    "finalFinishedAt": { "type": "string", "format": "date-time" },
    "receiptHash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    { "if": { "properties": { "reviewStatus": { "const": "CONCURRED" } }, "required": ["reviewStatus"] }, "then": { "properties": { "discrepancyCodes": { "maxItems": 0 }, "unreviewableReason": { "type": "null" } } } },
    { "if": { "properties": { "reviewStatus": { "const": "DISCREPANCY" } }, "required": ["reviewStatus"] }, "then": { "properties": { "discrepancyCodes": { "minItems": 1 }, "unreviewableReason": { "type": "null" } } } },
    { "if": { "properties": { "reviewStatus": { "const": "UNREVIEWABLE" } }, "required": ["reviewStatus"] }, "then": { "properties": { "discrepancyCodes": { "minItems": 1 }, "unreviewableReason": { "type": "string", "minLength": 1 } } } }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewedItem": { "type": "object", "additionalProperties": false, "required": ["itemId", "itemHash", "clusterId"], "properties": { "itemId": { "type": "string", "minLength": 1 }, "itemHash": { "$ref": "#/$defs/sha256" }, "clusterId": { "type": "string", "minLength": 1 } } },
    "conclusion": { "enum": ["INVALID_FOR_GENERALIZATION", "EXECUTION_INTEGRITY_FAILED", "POLICY_REVISION_REQUIRED_MACHINE_REFERENCE", "INCONCLUSIVE_MACHINE_REFERENCE"] }
  }
}
