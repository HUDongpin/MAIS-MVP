{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/ItemEvaluationResultV1.schema.json",
  "title": "ItemEvaluationResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "registrationHash", "sampleManifestHash", "referenceSealHash", "executionRegistrationHash", "itemId", "itemHash", "clusterId", "executionDisposition", "machineDisposition", "machineNonresolvedReasonCodes", "referenceDisposition", "machineSurfaceFinding", "referenceFindings", "machineFindings", "finalReferenceLabelHash", "attemptReceiptHashes", "completedItemCommitMarkerHash", "itemResultHash"],
  "properties": {
    "schemaVersion": { "const": "ItemEvaluationResultV1" }, "designId": { "const": "MAIS-NATURAL-CA60-V4" }, "registrationHash": { "$ref": "#/$defs/sha256" }, "sampleManifestHash": { "$ref": "#/$defs/sha256" }, "referenceSealHash": { "$ref": "#/$defs/sha256" }, "executionRegistrationHash": { "$ref": "#/$defs/sha256" }, "itemId": { "type": "string", "minLength": 1 }, "itemHash": { "$ref": "#/$defs/sha256" }, "clusterId": { "type": "string", "minLength": 1 }, "executionDisposition": { "enum": ["COMPLETE", "MISSING_RECEIPT", "INVALID"] }, "machineDisposition": { "enum": ["RESOLVED", "UNRESOLVED_MACHINE", "MISSING_RECEIPT"] }, "machineNonresolvedReasonCodes": { "type": "array", "uniqueItems": true, "items": { "enum": ["MISSING_RECEIPT", "B_PRIME_REDUCER_UNRESOLVED", "B_PRIME_FINDING_CONFLICT", "C0_REDUCER_UNRESOLVED", "NORMALIZED_FINDING_CONFLICT", "PROVIDER_OUTPUT_UNASSESSABLE"] } }, "referenceDisposition": { "enum": ["RESOLVED_POSITIVE", "RESOLVED_NEGATIVE", "UNRESOLVED_REFERENCE", "INVALID"] }, "machineSurfaceFinding": { "type": ["boolean", "null"] }, "referenceFindings": { "$ref": "#/$defs/findings" }, "machineFindings": { "$ref": "#/$defs/findings" }, "finalReferenceLabelHash": { "$ref": "#/$defs/sha256" }, "attemptReceiptHashes": { "type": "array", "minItems": 0, "maxItems": 14, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } }, "completedItemCommitMarkerHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "itemResultHash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    { "if": { "properties": { "machineDisposition": { "const": "RESOLVED" } }, "required": ["machineDisposition"] }, "then": { "properties": { "machineNonresolvedReasonCodes": { "maxItems": 0 }, "machineSurfaceFinding": { "type": "boolean" }, "attemptReceiptHashes": { "minItems": 2 }, "completedItemCommitMarkerHash": { "$ref": "#/$defs/sha256" } } } },
    { "if": { "properties": { "machineDisposition": { "const": "UNRESOLVED_MACHINE" } }, "required": ["machineDisposition"] }, "then": { "properties": { "machineNonresolvedReasonCodes": { "minItems": 1 }, "machineSurfaceFinding": { "type": "null" }, "machineFindings": { "maxItems": 0 } } } },
    { "if": { "properties": { "executionDisposition": { "const": "MISSING_RECEIPT" } }, "required": ["executionDisposition"] }, "then": { "properties": { "machineDisposition": { "const": "MISSING_RECEIPT" }, "machineNonresolvedReasonCodes": { "const": ["MISSING_RECEIPT"] }, "machineSurfaceFinding": { "type": "null" }, "machineFindings": { "maxItems": 0 }, "attemptReceiptHashes": { "minItems": 1 }, "completedItemCommitMarkerHash": { "type": "null" } } } },
    { "if": { "properties": { "executionDisposition": { "const": "INVALID" } }, "required": ["executionDisposition"] }, "then": { "properties": { "machineSurfaceFinding": { "type": "null" }, "machineFindings": { "maxItems": 0 }, "completedItemCommitMarkerHash": { "type": "null" } } } }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "operationalCode": { "enum": ["WRONG_CANONICAL_ANSWER", "UNSOLVABLE_OR_INTERNALLY_INCONSISTENT", "FALSE_ACCEPT_CORRECT_RESPONSE", "FALSE_ACCEPT_NEAR_MISS", "FALSE_REJECT_CORRECT_RESPONSE", "ORACLE_OR_PROMPT_LEAKAGE", "EQUIVALENT_ANSWER_NOT_ACCEPTED", "MULTIPLE_CORRECT_OPTIONS", "MISSING_OR_MISMATCHED_OPTIONS", "EXPLANATION_ANSWER_MISMATCH", "EVIDENCE_MISMATCH", "LANGUAGE_SEMANTIC_MISMATCH", "CURRICULUM_OR_METADATA_MISMATCH", "MINOR_WORDING_OR_FORMAT", "MINOR_EXPLANATION_WEAKNESS", "REDUNDANT_OR_NEAR_DUPLICATE", "MINOR_METADATA_MISMATCH"] },
    "family": { "enum": ["CANONICAL_ANSWER_SOLVABILITY", "RESPONSE_ACCEPTANCE", "ORACLE_PROMPT_INTEGRITY", "OPTION_SET_INTEGRITY", "EXPLANATION_INTEGRITY", "EVIDENCE_INTEGRITY", "LANGUAGE_SEMANTICS", "CURRICULUM_METADATA", "WORDING_FORMAT", "DUPLICATION_HOMOLOGY"] },
    "finding": { "type": "object", "additionalProperties": false, "required": ["itemId", "findingId", "evidenceLocator", "code", "family", "severity"], "properties": { "itemId": { "type": "string", "minLength": 1 }, "findingId": { "type": "string", "minLength": 1 }, "evidenceLocator": { "type": "string", "minLength": 1 }, "code": { "$ref": "#/$defs/operationalCode" }, "family": { "$ref": "#/$defs/family" }, "severity": { "enum": ["P0", "P1", "P2"] } } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  }
}
