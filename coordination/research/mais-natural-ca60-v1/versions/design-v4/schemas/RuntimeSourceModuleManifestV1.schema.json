{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/RuntimeSourceModuleManifestV1.schema.json",
  "title": "RuntimeSourceModuleManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "designId",
    "sourceCommit",
    "entries",
    "sortOrder",
    "rootFormula",
    "sourceModuleHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "RuntimeSourceModuleManifestV1"
    },
    "designId": {
      "const": "MAIS-NATURAL-CA60-V4"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repoRelativePath",
          "gitBlobOid"
        ],
        "properties": {
          "repoRelativePath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[^\\u0000]+$"
          },
          "gitBlobOid": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          }
        }
      }
    },
    "sortOrder": {
      "const": "REPO_RELATIVE_PATH_UTF8_BYTEWISE_ASCENDING"
    },
    "rootFormula": {
      "const": "SHA256(UTF8(JCS(sorted[{repoRelativePath,gitBlobOid}])))"
    },
    "sourceModuleHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nullableSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
