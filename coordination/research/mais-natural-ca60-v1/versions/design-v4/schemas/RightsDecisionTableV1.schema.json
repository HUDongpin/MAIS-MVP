{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/RightsDecisionTableV1.schema.json",
  "title": "RightsDecisionTableV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "designId",
    "registrationHash",
    "sourceCommit",
    "decisions",
    "requiredSourceIds",
    "allRequiredSourcesResolved",
    "tableHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "RightsDecisionTableV1"
    },
    "designId": {
      "const": "MAIS-NATURAL-CA60-V4"
    },
    "registrationHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "decisions": {
      "type": "array",
      "minItems": 1
    },
    "requiredSourceIds": {
      "const": [
        "california-math-common-core-skill",
        "ccss-math-textbook-app"
      ]
    },
    "allRequiredSourcesResolved": {
      "type": "boolean"
    },
    "tableHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "nullableSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
