{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/DeepSeekRouteProbeAuthorizationV1.schema.json",
  "title": "DeepSeekRouteProbeAuthorizationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registrationHash",
    "provider",
    "endpoint",
    "requestedModel",
    "role",
    "maximumAttempts",
    "maximumTokens",
    "maximumEstimatedUsd",
    "containsNaturalItemTextAuthorized",
    "ownerGrantRootHash",
    "issuedAt",
    "expiresAt",
    "authorizationHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "DeepSeekRouteProbeAuthorizationV1"
    },
    "registrationHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider": {
      "const": "DEEPSEEK_DIRECT"
    },
    "endpoint": {
      "const": "https://api.deepseek.com/chat/completions"
    },
    "requestedModel": {
      "const": "deepseek-v4-pro"
    },
    "role": {
      "const": "DEEPSEEK_DIRECT_ROUTE_PROBE"
    },
    "maximumAttempts": {
      "const": 1
    },
    "maximumTokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "maximumEstimatedUsd": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.1
    },
    "containsNaturalItemTextAuthorized": {
      "const": false
    },
    "ownerGrantRootHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "authorizationHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
