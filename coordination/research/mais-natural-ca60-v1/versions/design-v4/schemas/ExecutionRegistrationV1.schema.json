{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/ExecutionRegistrationV1.schema.json",
  "title": "ExecutionRegistrationV1",
  "type": "object",
  "additionalProperties": false,
  "x-mais-chronology": "design<runtime-source<frame<sample<qwen-authorization<nonzero-qwen-history<reference-seal<route-probe-authorization<route-probe-receipt<deepseek-authorization<execution-registration<first-deepseek-natural-attempt",
  "required": [
    "schemaVersion",
    "designId",
    "registrationHash",
    "runtimeSourceBindingHash",
    "frameRegistrationHash",
    "samplingFrameHash",
    "sampleManifestHash",
    "qwenAuthorizationHash",
    "qwenAttemptChainHash",
    "qwenAttemptCount",
    "qwenSuccessfulReferenceCallCount",
    "firstQwenReferenceAttemptAt",
    "referenceSealHash",
    "referenceLabelsFrozenAt",
    "deepSeekRouteProbeAuthorizationHash",
    "deepSeekRouteProbeReceiptHash",
    "deepSeekRouteProbeAttemptCount",
    "deepSeekAuthorizationHash",
    "runtimeConfigHash",
    "promptSetHash",
    "schemaSetHash",
    "runnerCommit",
    "runnerHash",
    "adapterHash",
    "c0RandomAuditSelectionHash",
    "thresholdHash",
    "taxonomyHash",
    "labelSchemaHash",
    "adjudicationMethodHash",
    "severityRuleHash",
    "statisticalPowerHash",
    "designSupersedesHash",
    "providerEventCountBeforeExecutionRegistration",
    "deepSeekNaturalAttemptCountBeforeRegistration",
    "firstDeepSeekNaturalItemAttemptAt",
    "registeredAt",
    "executionRegistrationHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ExecutionRegistrationV1"
    },
    "designId": {
      "const": "MAIS-NATURAL-CA60-V4"
    },
    "registrationHash": {
      "$ref": "#/$defs/sha256"
    },
    "runtimeSourceBindingHash": {
      "$ref": "#/$defs/sha256"
    },
    "frameRegistrationHash": {
      "$ref": "#/$defs/sha256"
    },
    "samplingFrameHash": {
      "$ref": "#/$defs/sha256"
    },
    "sampleManifestHash": {
      "$ref": "#/$defs/sha256"
    },
    "qwenAuthorizationHash": {
      "$ref": "#/$defs/sha256"
    },
    "qwenAttemptChainHash": {
      "$ref": "#/$defs/sha256"
    },
    "qwenAttemptCount": {
      "type": "integer",
      "minimum": 240,
      "maximum": 610
    },
    "qwenSuccessfulReferenceCallCount": {
      "type": "integer",
      "minimum": 240,
      "maximum": 300
    },
    "firstQwenReferenceAttemptAt": {
      "type": "string",
      "format": "date-time"
    },
    "referenceSealHash": {
      "$ref": "#/$defs/sha256"
    },
    "referenceLabelsFrozenAt": {
      "type": "string",
      "format": "date-time"
    },
    "deepSeekRouteProbeAuthorizationHash": {
      "$ref": "#/$defs/sha256"
    },
    "deepSeekRouteProbeReceiptHash": {
      "$ref": "#/$defs/sha256"
    },
    "deepSeekRouteProbeAttemptCount": {
      "const": 1
    },
    "deepSeekAuthorizationHash": {
      "$ref": "#/$defs/sha256"
    },
    "runtimeConfigHash": {
      "$ref": "#/$defs/sha256"
    },
    "promptSetHash": {
      "$ref": "#/$defs/sha256"
    },
    "schemaSetHash": {
      "$ref": "#/$defs/sha256"
    },
    "runnerCommit": {
      "$ref": "#/$defs/gitOid"
    },
    "runnerHash": {
      "$ref": "#/$defs/sha256"
    },
    "adapterHash": {
      "$ref": "#/$defs/sha256"
    },
    "c0RandomAuditSelectionHash": {
      "$ref": "#/$defs/sha256"
    },
    "thresholdHash": {
      "$ref": "#/$defs/sha256"
    },
    "taxonomyHash": {
      "$ref": "#/$defs/sha256"
    },
    "labelSchemaHash": {
      "$ref": "#/$defs/sha256"
    },
    "adjudicationMethodHash": {
      "$ref": "#/$defs/sha256"
    },
    "severityRuleHash": {
      "$ref": "#/$defs/sha256"
    },
    "statisticalPowerHash": {
      "$ref": "#/$defs/sha256"
    },
    "designSupersedesHash": {
      "$ref": "#/$defs/sha256"
    },
    "providerEventCountBeforeExecutionRegistration": {
      "type": "integer",
      "minimum": 241,
      "maximum": 611
    },
    "deepSeekNaturalAttemptCountBeforeRegistration": {
      "const": 0
    },
    "firstDeepSeekNaturalItemAttemptAt": {
      "type": "null"
    },
    "registeredAt": {
      "type": "string",
      "format": "date-time"
    },
    "executionRegistrationHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    }
  }
}
