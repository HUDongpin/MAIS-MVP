{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/SampleManifestV1.schema.json",
  "title": "SampleManifestV1",
  "$comment": "Legacy structural-only compatibility schema; not a semantic execution interface for MAIS-NATURAL-CA60-V4.",
  "x-mais-interface-status": "LEGACY_STRUCTURAL_ONLY_NOT_ACCEPTED_FOR_EXECUTION",
  "x-mais-semantic-execution-eligible": false,
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "registrationHash", "designHash", "samplingFrameHash", "frameHash", "algorithmVersion", "manifestFrozenAt", "supersedesSampleManifestHash", "selectionFormula", "allocationMethod", "totalEligibleClusterCount", "crossCellComponentCount", "clusterOwnershipRule", "stratumAllocations", "hamiltonAudit", "clusterCount", "selectedRows", "manifestRootTupleOrder", "primaryAnalysisWeight", "secondaryWeightMethod", "resultBlind", "rerollAfterAnyLabelOrResult", "replacementAfterAnyLabelOrResult", "sampleManifestHash"],
  "properties": {
    "schemaVersion": { "const": "SampleManifestV1" },
    "designId": { "const": "MAIS-NATURAL-CA60-V4" },
    "registrationHash": { "$ref": "#/$defs/sha256" },
    "designHash": { "$ref": "#/$defs/sha256" },
    "samplingFrameHash": { "$ref": "#/$defs/sha256" },
    "frameHash": { "$ref": "#/$defs/sha256" },
    "algorithmVersion": { "const": "natural-ca60-hamilton-v3" },
    "manifestFrozenAt": { "type": "string", "format": "date-time" },
    "supersedesSampleManifestHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "selectionFormula": { "const": "SHA256(designHash|frameHash|algorithmVersion|stratum|clusterId|itemHash)" },
    "allocationMethod": { "const": "HAMILTON_LARGEST_REMAINDER_MINIMUM_TWO" },
    "totalEligibleClusterCount": { "type": "integer", "minimum": 60 },
    "crossCellComponentCount": { "type": "integer", "minimum": 0 },
    "clusterOwnershipRule": { "const": "LOWEST_MEMBER_SELECTION_DIGEST_THEN_ITEM_ID" },
    "stratumAllocations": { "type": "array", "minItems": 9, "maxItems": 9, "contains": { "$ref": "#/$defs/allocation" }, "minContains": 1, "items": { "$ref": "#/$defs/allocation" } },
    "hamiltonAudit": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "properties": {} } },
    "clusterCount": { "const": 60 },
    "selectedRows": { "type": "array", "minItems": 60, "maxItems": 60, "items": { "$ref": "#/$defs/row" } },
    "manifestRootTupleOrder": { "const": "SORTED_ITEM_ID_PLUS_ITEM_HASH_PLUS_CLUSTER_ID" },
    "primaryAnalysisWeight": { "const": 1 },
    "secondaryWeightMethod": { "const": "INVERSE_INCLUSION_PROBABILITY_DESCRIPTIVE_WITH_KISH_EFFECTIVE_N" },
    "resultBlind": { "const": true },
    "rerollAfterAnyLabelOrResult": { "const": false },
    "replacementAfterAnyLabelOrResult": { "const": false },
    "sampleManifestHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "responseForm": { "enum": ["multiple-choice", "fill-in", "short-answer"] },
    "difficulty": { "enum": ["Low", "Medium", "High"] },
    "allocation": { "type": "object", "additionalProperties": false, "required": ["responseForm", "difficulty", "eligibleClusterCount", "baseMinimumAllocation", "finalAllocation"], "properties": { "responseForm": { "$ref": "#/$defs/responseForm" }, "difficulty": { "$ref": "#/$defs/difficulty" }, "eligibleClusterCount": { "type": "integer", "minimum": 0 }, "baseMinimumAllocation": { "type": "integer", "minimum": 0, "maximum": 2 }, "finalAllocation": { "type": "integer", "minimum": 0, "maximum": 60 } } },
    "row": { "type": "object", "additionalProperties": false, "required": ["clusterId", "itemId", "itemHash", "stratum", "selectionDigest", "responseForm", "difficulty", "inclusionProbability", "analysisWeight"], "properties": { "clusterId": { "type": "string", "minLength": 1, "pattern": "^[^|]+$" }, "itemId": { "type": "string", "minLength": 1, "pattern": "^[^|]+$" }, "itemHash": { "$ref": "#/$defs/sha256" }, "stratum": { "type": "string", "pattern": "^(multiple-choice|fill-in|short-answer)::(Low|Medium|High)$" }, "selectionDigest": { "$ref": "#/$defs/sha256" }, "responseForm": { "$ref": "#/$defs/responseForm" }, "difficulty": { "$ref": "#/$defs/difficulty" }, "inclusionProbability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "analysisWeight": { "const": 1 } } }
  }
}
