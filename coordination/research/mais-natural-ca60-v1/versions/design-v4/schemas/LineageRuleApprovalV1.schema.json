{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/LineageRuleApprovalV1.schema.json",
  "title": "LineageRuleApprovalV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "designId",
    "approvedRuleHash",
    "lineageRuleApprovalHash",
    "authorizedBy",
    "issuedAt",
    "expiresAt",
    "nonAuthorizations",
    "approvalReceiptHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "LineageRuleApprovalV1"
    },
    "designId": {
      "const": "MAIS-NATURAL-CA60-V4"
    },
    "approvedRuleHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lineageRuleApprovalHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorizedBy": {
      "type": "string",
      "minLength": 1
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "nonAuthorizations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approvalReceiptHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "nullableSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
