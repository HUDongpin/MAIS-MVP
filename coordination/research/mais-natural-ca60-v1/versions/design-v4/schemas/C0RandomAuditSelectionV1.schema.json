{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/C0RandomAuditSelectionV1.schema.json",
  "title": "C0RandomAuditSelectionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "designId",
    "registrationHash",
    "sampleManifestHash",
    "sampleSelectionContentRootHash",
    "algorithmVersion",
    "algorithmDescriptorHash",
    "targetItemCount",
    "selectedRows",
    "frozenAt",
    "firstQwenReferenceAttemptAt",
    "selectionHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "C0RandomAuditSelectionV1"
    },
    "designId": {
      "const": "MAIS-NATURAL-CA60-V4"
    },
    "registrationHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sampleManifestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sampleSelectionContentRootHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "algorithmVersion": {
      "type": "string",
      "minLength": 1
    },
    "algorithmDescriptorHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "targetItemCount": {
      "const": 12
    },
    "selectedRows": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12
    },
    "frozenAt": {
      "type": "string",
      "format": "date-time"
    },
    "firstQwenReferenceAttemptAt": {
      "type": "null"
    },
    "selectionHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "nullableSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
