{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/CredentialReadinessReceiptV1.schema.json",
  "title": "CredentialReadinessReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provider",
    "variableName",
    "targetEnvironment",
    "status",
    "checkedAt",
    "receiptHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "CredentialReadinessReceiptV1"
    },
    "provider": {
      "enum": [
        "ALIBABA_CLOUD_MODEL_STUDIO",
        "DEEPSEEK_DIRECT"
      ]
    },
    "variableName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "targetEnvironment": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "status": {
      "enum": [
        "present",
        "missing"
      ]
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "receiptHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
