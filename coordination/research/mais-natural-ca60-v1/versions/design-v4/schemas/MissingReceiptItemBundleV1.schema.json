{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/MissingReceiptItemBundleV1.schema.json",
  "title": "MissingReceiptItemBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "designId",
    "registrationHash",
    "sampleManifestHash",
    "executionRegistrationHash",
    "itemHash",
    "itemId",
    "itemIdPseudonym",
    "clusterId",
    "executionDisposition",
    "reasonCode",
    "itemAttemptReceipts",
    "successfulRoleEvidence",
    "terminalAttemptReceiptHash",
    "terminalAttemptChainHash",
    "machineEvaluationFinalized",
    "includedInUnifiedNonresolvedUniverse",
    "missingReceiptBundleHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "MissingReceiptItemBundleV1"
    },
    "designId": {
      "const": "MAIS-NATURAL-CA60-V4"
    },
    "registrationHash": {
      "$ref": "#/$defs/sha256"
    },
    "sampleManifestHash": {
      "$ref": "#/$defs/sha256"
    },
    "executionRegistrationHash": {
      "$ref": "#/$defs/sha256"
    },
    "itemHash": {
      "$ref": "#/$defs/sha256"
    },
    "itemId": {
      "type": "string",
      "minLength": 1
    },
    "itemIdPseudonym": {
      "type": "string",
      "pattern": "^ca60-[0-9a-f]{32}$"
    },
    "clusterId": {
      "type": "string",
      "minLength": 1
    },
    "executionDisposition": {
      "const": "MISSING_RECEIPT"
    },
    "reasonCode": {
      "enum": [
        "PROVIDER_ATTEMPTS_EXHAUSTED",
        "PROVIDER_NETWORK_TERMINAL_FAILURE",
        "PROVIDER_SCHEMA_TERMINAL_FAILURE",
        "CAP_FAIL_CLOSED_BEFORE_COMPLETION",
        "ITEM_RESULT_FINALIZATION_FAILED_CLOSED"
      ]
    },
    "itemAttemptReceipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "$ref": "https://mais.hk/schemas/research/ProviderAttemptReceiptV1.schema.json"
      }
    },
    "successfulRoleEvidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/successfulRoleEvidence"
      }
    },
    "terminalAttemptReceiptHash": {
      "$ref": "#/$defs/sha256"
    },
    "terminalAttemptChainHash": {
      "$ref": "#/$defs/sha256"
    },
    "machineEvaluationFinalized": {
      "const": false
    },
    "includedInUnifiedNonresolvedUniverse": {
      "const": true
    },
    "missingReceiptBundleHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "x-mais-cross-field-constraint": "itemAttemptReceipts is the exact unique sequenceNumber-ordered complete ProviderAttemptReceiptV1 subchain for this manifest item; successfulRoleEvidence is in the same order as and exactly one-to-one with SUCCESS attempts; terminal receipt and chain hashes are recomputed; reasonCode is accepted only for the frozen planned-role terminal graph",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deepSeekFrozenProviderRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelopeStage",
        "model",
        "stream",
        "thinking",
        "reasoning_effort",
        "temperature",
        "response_format",
        "max_tokens",
        "requestedSeed",
        "role",
        "prompt_hash",
        "response_schema_hash",
        "input"
      ],
      "properties": {
        "envelopeStage": {
          "const": "LOGICAL_REQUEST_PRE_ADAPTER_V4"
        },
        "model": {
          "const": "deepseek-v4-pro"
        },
        "stream": {
          "const": false
        },
        "thinking": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "enabled"
            }
          }
        },
        "reasoning_effort": {
          "const": "high"
        },
        "temperature": {
          "const": 0
        },
        "response_format": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "json_object"
            }
          }
        },
        "max_tokens": {
          "const": 8192
        },
        "requestedSeed": {
          "type": "null"
        },
        "role": {
          "enum": [
            "B_PRIME_CRITIQUE",
            "B_PRIME_REVISION",
            "C0_PRIME_ROLE_1",
            "C0_PRIME_ROLE_2",
            "C0_PRIME_ROLE_3",
            "C0_PRIME_ROLE_4",
            "C0_PRIME_ROLE_5"
          ]
        },
        "prompt_hash": {
          "$ref": "#/$defs/sha256"
        },
        "response_schema_hash": {
          "$ref": "#/$defs/sha256"
        },
        "input": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "successfulRoleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "attemptReceiptHash",
        "requestBody",
        "responseBody",
        "output",
        "wireEvidence"
      ],
      "properties": {
        "role": {
          "enum": [
            "B_PRIME_CRITIQUE",
            "B_PRIME_REVISION",
            "C0_PRIME_ROLE_1",
            "C0_PRIME_ROLE_2",
            "C0_PRIME_ROLE_3",
            "C0_PRIME_ROLE_4",
            "C0_PRIME_ROLE_5"
          ]
        },
        "attemptReceiptHash": {
          "$ref": "#/$defs/sha256"
        },
        "requestBody": {
          "$ref": "#/$defs/deepSeekFrozenProviderRequest"
        },
        "responseBody": {
          "type": "object",
          "minProperties": 1
        },
        "output": {
          "$ref": "https://mais.hk/schemas/research/DeepSeekRoleOutputV1.schema.json"
        },
        "wireEvidence": {
          "$ref": "https://mais.hk/schemas/research/ProviderWireEvidenceV1.schema.json"
        }
      }
    }
  }
}
