{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/NaturalCaPilotDesignRegistrationV2.schema.json",
  "title": "NaturalCaPilotDesignRegistrationV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "designKind", "version", "frozenAt", "baselineCommitSha", "supersedes", "provenance", "scope", "runtimePopulation", "eligibility", "stratification", "homologyClustering", "deterministicSelection", "machineReferenceWorkflow", "taxonomy", "labeling", "analysis", "runtimeAccommodation", "providerControls", "executionLifecycle", "interfaces", "artifactStorage", "artifactKinds", "freezeChain", "registrationHash"],
  "properties": {
    "schemaVersion": { "const": "NaturalCaPilotDesignRegistrationV2" },
    "designId": { "const": "MAIS-NATURAL-CA60-V2" },
    "designKind": { "const": "IMMUTABLE_PRE_EXECUTION_DESIGN_REGISTRATION" },
    "version": { "const": 2 },
    "frozenAt": { "type": "string", "format": "date-time" },
    "baselineCommitSha": { "$ref": "#/$defs/sha1" },
    "supersedes": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "designId", "version", "registrationHash", "artifactPath", "reason"], "properties": { "schemaVersion": { "const": "NaturalCaPilotDesignRegistrationV1" }, "designId": { "const": "MAIS-NATURAL-CA60-V1" }, "version": { "const": 1 }, "registrationHash": { "$ref": "#/$defs/sha256" }, "artifactPath": { "const": "design-registration.json" }, "reason": { "type": "string", "minLength": 1 } } },
    "provenance": { "type": "object", "additionalProperties": true },
    "scope": { "type": "object", "additionalProperties": true },
    "runtimePopulation": { "type": "object", "additionalProperties": true },
    "eligibility": { "type": "object", "additionalProperties": true },
    "stratification": { "type": "object", "additionalProperties": true },
    "homologyClustering": { "type": "object", "additionalProperties": true },
    "deterministicSelection": { "type": "object", "additionalProperties": true },
    "machineReferenceWorkflow": { "type": "object", "additionalProperties": true },
    "taxonomy": { "type": "object", "additionalProperties": true },
    "labeling": { "type": "object", "additionalProperties": true },
    "analysis": { "type": "object", "additionalProperties": true },
    "runtimeAccommodation": { "type": "object", "additionalProperties": false, "required": ["maxAnswerChoices", "accommodationBasedOptionTruncationAllowed", "runtimeConfigHashMustBindTheseValues"], "properties": { "maxAnswerChoices": { "const": 0 }, "accommodationBasedOptionTruncationAllowed": { "const": false }, "runtimeConfigHashMustBindTheseValues": { "const": true } } },
    "providerControls": { "type": "object", "additionalProperties": true },
    "executionLifecycle": { "type": "object", "additionalProperties": true },
    "interfaces": { "type": "object", "additionalProperties": true },
    "artifactStorage": { "type": "object", "additionalProperties": true },
    "artifactKinds": { "type": "object", "additionalProperties": true },
    "freezeChain": { "type": "array", "minItems": 7, "maxItems": 7, "prefixItems": [{"const":"DESIGN_REGISTRATION_V2"},{"const":"FRAME_REGISTRATION"},{"const":"SAMPLE_REGISTRATION"},{"const":"QWEN_AUTHORIZATION"},{"const":"REFERENCE_LABEL_SEAL"},{"const":"DEEPSEEK_AUTHORIZATION"},{"const":"EXECUTION_REGISTRATION"}], "items": false },
    "registrationHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
