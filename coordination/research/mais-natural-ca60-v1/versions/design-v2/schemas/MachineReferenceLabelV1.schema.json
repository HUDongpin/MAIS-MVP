{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/MachineReferenceLabelV1.schema.json",
  "title": "MachineReferenceLabelV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "registrationHash", "sampleManifestHash", "clusterId", "itemId", "referenceSourceType", "humanReferenceClaimAllowed", "labelStage", "role", "raterPseudonym", "adjudicatorPseudonym", "requestedProvider", "observedProvider", "requestedModel", "observedModel", "promptHash", "schemaHash", "inputReceiptHash", "solveAttemptReceiptHash", "labelAttemptReceiptHash", "blindingAttestations", "rawLabel", "rawTaxonomyCodes", "rawSeverity", "rawFindingFamilies", "rawUncertain", "requiresAdjudication", "finalLabel", "finalTaxonomyCodes", "finalSeverity", "finalFindingFamilies", "acceptedCodeSets", "rawLabelHashes", "disagreementStatus", "adjudicationReasonCodes", "disagreementAdjudicationReceiptHash", "labeledAt", "labelHash"],
  "properties": {
    "schemaVersion": { "const": "MachineReferenceLabelV1" },
    "designId": { "const": "MAIS-NATURAL-CA60-V2" },
    "registrationHash": { "$ref": "#/$defs/sha256" },
    "sampleManifestHash": { "$ref": "#/$defs/sha256" },
    "clusterId": { "type": "string", "minLength": 1 },
    "itemId": { "type": "string", "minLength": 1 },
    "referenceSourceType": { "const": "MACHINE_REFERENCE_PANEL" },
    "humanReferenceClaimAllowed": { "const": false },
    "labelStage": { "enum": ["RAW_RATER", "FINAL_ADJUDICATED"] },
    "role": { "enum": ["A_LABEL", "B_LABEL", "ADJUDICATOR"] },
    "raterPseudonym": { "$ref": "#/$defs/nullableIdentity" },
    "adjudicatorPseudonym": { "$ref": "#/$defs/nullableIdentity" },
    "requestedProvider": { "const": "ALIBABA_CLOUD_MODEL_STUDIO" },
    "observedProvider": { "const": "ALIBABA_CLOUD_MODEL_STUDIO" },
    "requestedModel": { "const": "qwen3.8-max" },
    "observedModel": { "const": "qwen3.8-max" },
    "promptHash": { "$ref": "#/$defs/sha256" },
    "schemaHash": { "$ref": "#/$defs/sha256" },
    "inputReceiptHash": { "$ref": "#/$defs/sha256" },
    "solveAttemptReceiptHash": { "$ref": "#/$defs/sha256" },
    "labelAttemptReceiptHash": { "$ref": "#/$defs/sha256" },
    "blindingAttestations": { "type": "object", "additionalProperties": false, "required": ["deepSeekOutputNotSeen", "otherRaterLabelNotSeen", "adjudicatorInputsLimitedToItemAndRawLabels"], "properties": { "deepSeekOutputNotSeen": { "const": true }, "otherRaterLabelNotSeen": { "anyOf": [{ "const": true }, { "type": "null" }] }, "adjudicatorInputsLimitedToItemAndRawLabels": { "anyOf": [{ "const": true }, { "type": "null" }] } } },
    "rawLabel": { "$ref": "#/$defs/nullableLabel" },
    "rawTaxonomyCodes": { "$ref": "#/$defs/rawCodes" },
    "rawSeverity": { "$ref": "#/$defs/nullableSeverity" },
    "rawFindingFamilies": { "$ref": "#/$defs/nullableFamilyMap" },
    "rawUncertain": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
    "requiresAdjudication": { "type": "boolean" },
    "finalLabel": { "$ref": "#/$defs/nullableLabel" },
    "finalTaxonomyCodes": { "$ref": "#/$defs/finalCodes" },
    "finalSeverity": { "$ref": "#/$defs/nullableSeverity" },
    "finalFindingFamilies": { "$ref": "#/$defs/nullableFamilyMap" },
    "acceptedCodeSets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/acceptedCodeSet" } },
    "rawLabelHashes": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "disagreementStatus": { "anyOf": [{ "enum": ["AGREEMENT", "DISAGREEMENT", "ADJUDICATOR_UNDECIDED"] }, { "type": "null" }] },
    "adjudicationReasonCodes": { "type": "array", "uniqueItems": true, "items": { "enum": ["ANY_FIELD_DISAGREEMENT", "ANY_RATER_UNCERTAIN", "ANY_RATER_P0", "ANY_RATER_P1", "AMBIGUOUS_LITERAL_CODE_FALSE_ACCEPT_CORRECT_RESPONSE"] } },
    "disagreementAdjudicationReceiptHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "labeledAt": { "type": "string", "format": "date-time" },
    "labelHash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    { "if": { "properties": { "labelStage": { "const": "RAW_RATER" } }, "required": ["labelStage"] }, "then": { "properties": { "role": { "enum": ["A_LABEL", "B_LABEL"] }, "raterPseudonym": { "type": "string", "minLength": 1 }, "adjudicatorPseudonym": { "type": "null" }, "rawLabel": { "$ref": "#/$defs/label" }, "rawTaxonomyCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/rawCode" } }, "rawSeverity": { "$ref": "#/$defs/severity" }, "rawFindingFamilies": { "$ref": "#/$defs/familyMap" }, "rawUncertain": { "type": "boolean" }, "finalLabel": { "type": "null" }, "finalTaxonomyCodes": { "maxItems": 0 }, "finalSeverity": { "type": "null" }, "finalFindingFamilies": { "type": "null" }, "acceptedCodeSets": { "maxItems": 0 }, "rawLabelHashes": { "maxItems": 0 }, "disagreementStatus": { "type": "null" }, "adjudicationReasonCodes": { "maxItems": 0 }, "disagreementAdjudicationReceiptHash": { "type": "null" } } } },
    { "if": { "properties": { "labelStage": { "const": "FINAL_ADJUDICATED" } }, "required": ["labelStage"] }, "then": { "properties": { "role": { "const": "ADJUDICATOR" }, "raterPseudonym": { "type": "null" }, "adjudicatorPseudonym": { "type": "string", "minLength": 1 }, "rawLabel": { "type": "null" }, "rawTaxonomyCodes": { "maxItems": 0 }, "rawSeverity": { "type": "null" }, "rawFindingFamilies": { "type": "null" }, "rawUncertain": { "type": "null" }, "finalLabel": { "$ref": "#/$defs/label" }, "finalTaxonomyCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/finalCode" } }, "finalSeverity": { "$ref": "#/$defs/severity" }, "finalFindingFamilies": { "$ref": "#/$defs/familyMap" }, "rawLabelHashes": { "minItems": 2, "maxItems": 2 }, "disagreementStatus": { "enum": ["AGREEMENT", "DISAGREEMENT", "ADJUDICATOR_UNDECIDED"] }, "disagreementAdjudicationReceiptHash": { "$ref": "#/$defs/sha256" } } } }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableIdentity": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "label": { "enum": ["DEFECT", "NO_FINDING", "UNRESOLVED_REFERENCE"] },
    "nullableLabel": { "anyOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
    "severity": { "enum": ["NONE", "P2", "P1", "P0", "UNRESOLVED"] },
    "nullableSeverity": { "anyOf": [{ "$ref": "#/$defs/severity" }, { "type": "null" }] },
    "rawCode": { "enum": ["WRONG_CANONICAL_ANSWER", "UNSOLVABLE_OR_INTERNALLY_INCONSISTENT", "FALSE_ACCEPT_CORRECT_RESPONSE", "FALSE_ACCEPT_NEAR_MISS", "FALSE_REJECT_CORRECT_RESPONSE", "ORACLE_OR_PROMPT_LEAKAGE", "EQUIVALENT_ANSWER_NOT_ACCEPTED", "MULTIPLE_CORRECT_OPTIONS", "MISSING_OR_MISMATCHED_OPTIONS", "EXPLANATION_ANSWER_MISMATCH", "EVIDENCE_MISMATCH", "LANGUAGE_SEMANTIC_MISMATCH", "CURRICULUM_OR_METADATA_MISMATCH", "MINOR_WORDING_OR_FORMAT", "MINOR_EXPLANATION_WEAKNESS", "REDUNDANT_OR_NEAR_DUPLICATE", "MINOR_METADATA_MISMATCH", "NO_FINDING", "UNASSESSABLE", "SCHEMA_GAP"] },
    "finalCode": { "enum": ["WRONG_CANONICAL_ANSWER", "UNSOLVABLE_OR_INTERNALLY_INCONSISTENT", "FALSE_ACCEPT_NEAR_MISS", "FALSE_REJECT_CORRECT_RESPONSE", "ORACLE_OR_PROMPT_LEAKAGE", "EQUIVALENT_ANSWER_NOT_ACCEPTED", "MULTIPLE_CORRECT_OPTIONS", "MISSING_OR_MISMATCHED_OPTIONS", "EXPLANATION_ANSWER_MISMATCH", "EVIDENCE_MISMATCH", "LANGUAGE_SEMANTIC_MISMATCH", "CURRICULUM_OR_METADATA_MISMATCH", "MINOR_WORDING_OR_FORMAT", "MINOR_EXPLANATION_WEAKNESS", "REDUNDANT_OR_NEAR_DUPLICATE", "MINOR_METADATA_MISMATCH", "NO_FINDING", "UNASSESSABLE", "SCHEMA_GAP"] },
    "operationalCode": { "enum": ["WRONG_CANONICAL_ANSWER", "UNSOLVABLE_OR_INTERNALLY_INCONSISTENT", "FALSE_ACCEPT_NEAR_MISS", "FALSE_REJECT_CORRECT_RESPONSE", "ORACLE_OR_PROMPT_LEAKAGE", "EQUIVALENT_ANSWER_NOT_ACCEPTED", "MULTIPLE_CORRECT_OPTIONS", "MISSING_OR_MISMATCHED_OPTIONS", "EXPLANATION_ANSWER_MISMATCH", "EVIDENCE_MISMATCH", "LANGUAGE_SEMANTIC_MISMATCH", "CURRICULUM_OR_METADATA_MISMATCH", "MINOR_WORDING_OR_FORMAT", "MINOR_EXPLANATION_WEAKNESS", "REDUNDANT_OR_NEAR_DUPLICATE", "MINOR_METADATA_MISMATCH"] },
    "rawCodes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/rawCode" } },
    "finalCodes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/finalCode" } },
    "family": { "enum": ["CANONICAL_ANSWER_SOLVABILITY", "RESPONSE_ACCEPTANCE", "ORACLE_PROMPT_INTEGRITY", "OPTION_SET_INTEGRITY", "EXPLANATION_INTEGRITY", "EVIDENCE_INTEGRITY", "LANGUAGE_SEMANTICS", "CURRICULUM_METADATA", "WORDING_FORMAT", "DUPLICATION_HOMOLOGY"] },
    "familyMap": { "type": "object", "propertyNames": { "$ref": "#/$defs/rawCode" }, "additionalProperties": { "anyOf": [{ "$ref": "#/$defs/family" }, { "type": "null" }] } },
    "nullableFamilyMap": { "anyOf": [{ "$ref": "#/$defs/familyMap" }, { "type": "null" }] },
    "acceptedCodeSet": { "type": "object", "additionalProperties": false, "required": ["primaryCode", "family", "acceptedCodes"], "properties": { "primaryCode": { "$ref": "#/$defs/operationalCode" }, "family": { "$ref": "#/$defs/family" }, "acceptedCodes": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/operationalCode" } } } }
  }
}
