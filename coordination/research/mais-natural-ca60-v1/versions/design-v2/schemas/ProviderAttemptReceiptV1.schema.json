{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/ProviderAttemptReceiptV1.schema.json",
  "title": "ProviderAttemptReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "runId", "registrationHash", "frameRegistrationHash", "sampleManifestHash", "runtimeConfigHash", "authorizationHash", "referenceSealHash", "executionRegistrationHash", "itemIdPseudonym", "itemHash", "attemptId", "role", "sequenceNumber", "requestedProvider", "observedProvider", "requestedModel", "observedModel", "requestedEndpoint", "observedEndpointHostname", "requestBodyHash", "responseBodyHash", "startedAt", "finishedAt", "latencyMs", "httpStatus", "providerRequestId", "finishReason", "parseStatus", "schemaStatus", "attemptStatus", "inputTokens", "outputTokens", "reasoningTokens", "totalTokens", "costRateSnapshotHash", "estimatedCost", "cumulativeCost", "retryClassification", "redactedError", "appendOnly", "atomicWrite", "fileMode", "completedItemCommitMarkerHash", "cacheHit", "providerInvoiceAuthoritative", "previousReceiptHash", "selfHash"],
  "properties": {
    "schemaVersion": { "const": "ProviderAttemptReceiptV1" },
    "designId": { "const": "MAIS-NATURAL-CA60-V2" },
    "runId": { "type": "string", "minLength": 1 },
    "registrationHash": { "$ref": "#/$defs/sha256" },
    "frameRegistrationHash": { "$ref": "#/$defs/sha256" },
    "sampleManifestHash": { "$ref": "#/$defs/sha256" },
    "runtimeConfigHash": { "$ref": "#/$defs/sha256" },
    "authorizationHash": { "$ref": "#/$defs/sha256" },
    "referenceSealHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "executionRegistrationHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "itemIdPseudonym": { "type": "string", "minLength": 1 },
    "itemHash": { "$ref": "#/$defs/sha256" },
    "attemptId": { "type": "string", "minLength": 1 },
    "role": { "$ref": "#/$defs/role" },
    "sequenceNumber": { "type": "integer", "minimum": 1 },
    "requestedProvider": { "$ref": "#/$defs/provider" },
    "observedProvider": { "anyOf": [{ "$ref": "#/$defs/provider" }, { "type": "null" }] },
    "requestedModel": { "enum": ["qwen3.8-max", "deepseek-v4-pro"] },
    "observedModel": { "anyOf": [{ "enum": ["qwen3.8-max", "deepseek-v4-pro"] }, { "type": "null" }] },
    "requestedEndpoint": { "enum": ["https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions", "https://api.deepseek.com/chat/completions"] },
    "observedEndpointHostname": { "anyOf": [{ "enum": ["dashscope.aliyuncs.com", "api.deepseek.com"] }, { "type": "null" }] },
    "requestBodyHash": { "$ref": "#/$defs/sha256" },
    "responseBodyHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "latencyMs": { "type": "integer", "minimum": 0 },
    "httpStatus": { "anyOf": [{ "type": "integer", "minimum": 100, "maximum": 599 }, { "type": "null" }] },
    "providerRequestId": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "finishReason": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "parseStatus": { "enum": ["NOT_ATTEMPTED", "VALID", "INVALID"] },
    "schemaStatus": { "enum": ["NOT_ATTEMPTED", "VALID", "INVALID"] },
    "attemptStatus": { "enum": ["SUCCESS", "TRANSIENT_NETWORK_FAILURE", "HTTP_429", "HTTP_5XX", "TIMEOUT", "MALFORMED_200", "SCHEMA_FAILURE", "PERMANENT_PROVIDER_FAILURE", "CAP_BLOCKED_BEFORE_REQUEST"] },
    "inputTokens": { "type": "integer", "minimum": 0 },
    "outputTokens": { "type": "integer", "minimum": 0 },
    "reasoningTokens": { "type": "integer", "minimum": 0 },
    "totalTokens": { "type": "integer", "minimum": 0 },
    "costRateSnapshotHash": { "$ref": "#/$defs/sha256" },
    "estimatedCost": { "type": "number", "minimum": 0 },
    "cumulativeCost": { "type": "number", "minimum": 0 },
    "retryClassification": { "enum": ["NONE", "TRANSIENT_RETRY_ALLOWED", "SCHEMA_RETRY_ALLOWED", "PERMANENT_NO_RETRY", "CAP_NO_RETRY"] },
    "redactedError": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "appendOnly": { "const": true },
    "atomicWrite": { "const": true },
    "fileMode": { "const": "0600" },
    "completedItemCommitMarkerHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "cacheHit": { "const": false },
    "providerInvoiceAuthoritative": { "const": true },
    "previousReceiptHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "selfHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider": { "enum": ["ALIBABA_CLOUD_MODEL_STUDIO", "DEEPSEEK_DIRECT"] },
    "role": { "enum": ["A_SOLVE", "A_LABEL", "B_SOLVE", "B_LABEL", "ADJUDICATOR", "B_PRIME_CRITIQUE", "B_PRIME_REVISION", "C0_PRIME_ROLE_1", "C0_PRIME_ROLE_2", "C0_PRIME_ROLE_3", "C0_PRIME_ROLE_4", "C0_PRIME_ROLE_5"] }
  }
}
