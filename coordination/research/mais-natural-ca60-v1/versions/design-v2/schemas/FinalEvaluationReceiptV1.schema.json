{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/FinalEvaluationReceiptV1.schema.json",
  "title": "FinalEvaluationReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "registrationHash", "frameRegistrationHash", "sampleManifestHash", "referenceSealHash", "executionRegistrationHash", "authorizationHashes", "attemptChainHeadHash", "itemResultSetHash", "expectedSampleSize", "completedItemCount", "failedItemCount", "missingItemCount", "resolvedPositiveN", "resolvedNegativeN", "unresolvedN", "invalidN", "confusionMatrix", "metricResults", "findingMatchingMatrixHash", "clusterStrataWeightSummaryHash", "machinePanelAgreement", "executionSummary", "requestedObservedProviderModels", "deviations", "completionStatus", "executionIntegrityStatus", "generalizationRequested", "policyRevisionRequired", "decisionCeiling", "claimCeiling", "conclusion", "calculatedAt", "previousReceiptHash", "receiptHash"],
  "properties": {
    "schemaVersion": { "const": "FinalEvaluationReceiptV1" },
    "designId": { "const": "MAIS-NATURAL-CA60-V2" },
    "registrationHash": { "$ref": "#/$defs/sha256" },
    "frameRegistrationHash": { "$ref": "#/$defs/sha256" },
    "sampleManifestHash": { "$ref": "#/$defs/sha256" },
    "referenceSealHash": { "$ref": "#/$defs/sha256" },
    "executionRegistrationHash": { "$ref": "#/$defs/sha256" },
    "authorizationHashes": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "attemptChainHeadHash": { "$ref": "#/$defs/sha256" },
    "itemResultSetHash": { "$ref": "#/$defs/sha256" },
    "expectedSampleSize": { "const": 60 },
    "completedItemCount": { "$ref": "#/$defs/count" },
    "failedItemCount": { "$ref": "#/$defs/count" },
    "missingItemCount": { "$ref": "#/$defs/count" },
    "resolvedPositiveN": { "$ref": "#/$defs/count" },
    "resolvedNegativeN": { "$ref": "#/$defs/count" },
    "unresolvedN": { "$ref": "#/$defs/count" },
    "invalidN": { "$ref": "#/$defs/count" },
    "confusionMatrix": { "type": "object", "additionalProperties": false, "required": ["tp", "fp", "fn", "tn"], "properties": { "tp": { "$ref": "#/$defs/count" }, "fp": { "$ref": "#/$defs/count" }, "fn": { "$ref": "#/$defs/count" }, "tn": { "$ref": "#/$defs/count" } } },
    "metricResults": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/metricResult" } },
    "findingMatchingMatrixHash": { "$ref": "#/$defs/sha256" },
    "clusterStrataWeightSummaryHash": { "$ref": "#/$defs/sha256" },
    "machinePanelAgreement": { "type": "object", "additionalProperties": false, "required": ["rawAgreement", "cohensKappa", "gwetAc1", "familyJaccard", "codeJaccard", "severityAgreement", "adjudicationRate", "sameModelCorrelatedErrorRisk", "humanValidityClaimAllowed"], "properties": { "rawAgreement": { "$ref": "#/$defs/nullableProportion" }, "cohensKappa": { "$ref": "#/$defs/nullableNumber" }, "gwetAc1": { "$ref": "#/$defs/nullableNumber" }, "familyJaccard": { "$ref": "#/$defs/nullableProportion" }, "codeJaccard": { "$ref": "#/$defs/nullableProportion" }, "severityAgreement": { "$ref": "#/$defs/nullableProportion" }, "adjudicationRate": { "$ref": "#/$defs/nullableProportion" }, "sameModelCorrelatedErrorRisk": { "const": true }, "humanValidityClaimAllowed": { "const": false } } },
    "executionSummary": { "type": "object", "additionalProperties": false, "required": ["attempts", "retries", "successfulCalls", "latencyMs", "inputTokens", "outputTokens", "reasoningTokens", "totalTokens", "estimatedUsd", "invoiceIsAuthoritative"], "properties": { "attempts": { "type": "integer", "minimum": 0, "maximum": 1460 }, "retries": { "type": "integer", "minimum": 0 }, "successfulCalls": { "type": "integer", "minimum": 0, "maximum": 720 }, "latencyMs": { "type": "integer", "minimum": 0 }, "inputTokens": { "type": "integer", "minimum": 0 }, "outputTokens": { "type": "integer", "minimum": 0 }, "reasoningTokens": { "type": "integer", "minimum": 0 }, "totalTokens": { "type": "integer", "minimum": 0, "maximum": 10000000 }, "estimatedUsd": { "type": "number", "minimum": 0, "maximum": 50 }, "invoiceIsAuthoritative": { "const": true } } },
    "requestedObservedProviderModels": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["requestedProvider", "observedProvider", "requestedModel", "observedModel", "requestedEndpoint", "observedEndpointHostname"], "properties": { "requestedProvider": { "type": "string" }, "observedProvider": { "type": "string" }, "requestedModel": { "type": "string" }, "observedModel": { "type": "string" }, "requestedEndpoint": { "type": "string" }, "observedEndpointHostname": { "type": "string" } } } },
    "deviations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["code", "material", "detailHash"], "properties": { "code": { "type": "string", "minLength": 1 }, "material": { "type": "boolean" }, "detailHash": { "$ref": "#/$defs/sha256" } } } },
    "completionStatus": { "enum": ["COMPLETE_60", "INCOMPLETE"] },
    "executionIntegrityStatus": { "enum": ["INTACT", "FAILED"] },
    "generalizationRequested": { "type": "boolean" },
    "policyRevisionRequired": { "type": "boolean" },
    "decisionCeiling": { "const": "INCONCLUSIVE_MACHINE_REFERENCE" },
    "claimCeiling": { "const": "CALIFORNIA_RUNTIME_EGRESS_ELIGIBLE_MACHINE_REFERENCE_PILOT_ONLY" },
    "conclusion": { "enum": ["INVALID_FOR_GENERALIZATION", "EXECUTION_INTEGRITY_FAILED", "POLICY_REVISION_REQUIRED_MACHINE_REFERENCE", "INCONCLUSIVE_MACHINE_REFERENCE"] },
    "calculatedAt": { "type": "string", "format": "date-time" },
    "previousReceiptHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "receiptHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 60 },
    "nullableProportion": { "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }] },
    "nullableNumber": { "anyOf": [{ "type": "number", "minimum": -1, "maximum": 1 }, { "type": "null" }] },
    "metricStatus": { "enum": ["MET", "NOT_MET", "UNDERPOWERED"] },
    "metricResult": { "type": "object", "additionalProperties": false, "required": ["metric", "numerator", "denominator", "pointEstimate", "oneSidedWilsonLcb95", "oneSidedWilsonUcb95", "twoSidedWilsonL95", "twoSidedWilsonU95", "clusterBootstrapP5", "clusterBootstrapP95", "worstCaseMissingLower", "worstCaseMissingUpper", "conservativeDecisionBound", "status", "decisionEligible"], "properties": { "metric": { "enum": ["SURFACE_SENSITIVITY", "SPECIFICITY", "FALSE_POSITIVE_RATE", "FAMILY_RECALL", "EXACT_CODE_AND_FAMILY_RECALL", "FAMILY_PRECISION", "EXACT_CODE_PRECISION", "FALSE_FINDINGS_PER_100", "P0_FALSE_NEGATIVE_COUNT", "P1_RECALL", "P2_MISSED_OR_UNRESOLVED_RATE"] }, "numerator": { "type": "integer", "minimum": 0 }, "denominator": { "type": "integer", "minimum": 0 }, "pointEstimate": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }, "oneSidedWilsonLcb95": { "$ref": "#/$defs/nullableProportion" }, "oneSidedWilsonUcb95": { "$ref": "#/$defs/nullableProportion" }, "twoSidedWilsonL95": { "$ref": "#/$defs/nullableProportion" }, "twoSidedWilsonU95": { "$ref": "#/$defs/nullableProportion" }, "clusterBootstrapP5": { "$ref": "#/$defs/nullableProportion" }, "clusterBootstrapP95": { "$ref": "#/$defs/nullableProportion" }, "worstCaseMissingLower": { "$ref": "#/$defs/nullableProportion" }, "worstCaseMissingUpper": { "$ref": "#/$defs/nullableProportion" }, "conservativeDecisionBound": { "$ref": "#/$defs/nullableProportion" }, "status": { "$ref": "#/$defs/metricStatus" }, "decisionEligible": { "type": "boolean" } } }
  }
}
