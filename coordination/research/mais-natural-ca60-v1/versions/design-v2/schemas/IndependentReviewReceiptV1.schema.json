{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/IndependentReviewReceiptV1.schema.json",
  "title": "IndependentReviewReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "registrationHash", "frameRegistrationHash", "sampleManifestHash", "referenceSealHash", "finalEvaluationReceiptHash", "reviewerLane", "reviewerPseudonym", "provenanceType", "humanReferenceClaimAllowed", "sourceArtifactsReadOnly", "mainScorerImported", "recomputationImplementationHash", "recomputedFrameHash", "recomputedSampleHash", "recomputedReferenceSealHash", "recomputedAttemptChainHash", "recomputedMatchingHash", "recomputedMetricSetHash", "recomputedDecision", "reviewedItemCount", "reviewedAttemptCount", "reviewStatus", "discrepancyCodes", "reviewedAt", "previousReceiptHash", "receiptHash"],
  "properties": {
    "schemaVersion": { "const": "IndependentReviewReceiptV1" },
    "designId": { "const": "MAIS-NATURAL-CA60-V2" },
    "registrationHash": { "$ref": "#/$defs/sha256" },
    "frameRegistrationHash": { "$ref": "#/$defs/sha256" },
    "sampleManifestHash": { "$ref": "#/$defs/sha256" },
    "referenceSealHash": { "$ref": "#/$defs/sha256" },
    "finalEvaluationReceiptHash": { "$ref": "#/$defs/sha256" },
    "reviewerLane": { "const": "A11" },
    "reviewerPseudonym": { "type": "string", "minLength": 1 },
    "provenanceType": { "const": "A11_INDEPENDENT_RECOMPUTATION" },
    "humanReferenceClaimAllowed": { "const": false },
    "sourceArtifactsReadOnly": { "const": true },
    "mainScorerImported": { "const": false },
    "recomputationImplementationHash": { "$ref": "#/$defs/sha256" },
    "recomputedFrameHash": { "$ref": "#/$defs/sha256" },
    "recomputedSampleHash": { "$ref": "#/$defs/sha256" },
    "recomputedReferenceSealHash": { "$ref": "#/$defs/sha256" },
    "recomputedAttemptChainHash": { "$ref": "#/$defs/sha256" },
    "recomputedMatchingHash": { "$ref": "#/$defs/sha256" },
    "recomputedMetricSetHash": { "$ref": "#/$defs/sha256" },
    "recomputedDecision": { "enum": ["INVALID_FOR_GENERALIZATION", "EXECUTION_INTEGRITY_FAILED", "POLICY_REVISION_REQUIRED_MACHINE_REFERENCE", "INCONCLUSIVE_MACHINE_REFERENCE"] },
    "reviewedItemCount": { "type": "integer", "minimum": 0, "maximum": 60 },
    "reviewedAttemptCount": { "type": "integer", "minimum": 0, "maximum": 1460 },
    "reviewStatus": { "enum": ["CONCURRED", "DISCREPANCY", "UNREVIEWABLE"] },
    "discrepancyCodes": { "type": "array", "uniqueItems": true, "items": { "enum": ["DESIGN_DRIFT", "FRAME_DRIFT", "SAMPLE_DRIFT", "AUTHORIZATION_DRIFT", "RECEIPT_CHAIN_DRIFT", "LABEL_DISCREPANCY", "MATCHING_DISCREPANCY", "METRIC_DISCREPANCY", "DECISION_DISCREPANCY", "INSUFFICIENT_EVIDENCE"] } },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "previousReceiptHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "receiptHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
