{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/SampleManifestV2.schema.json",
  "title": "SampleManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "designId", "registrationHash", "designHash",
    "frameRegistrationHash", "samplingFrameHash", "frameSelectionContentRootHash", "frameHash",
    "sourceEnumerationReceiptHash", "sourceEnumerationEvidenceContractHash", "fullSourceEnumerationRootHash",
    "rawEvidenceArtifactRootHash", "extractorImplementationHash", "extractorRunnerCommit", "extractorRunnerHash",
    "clusterAuditHash", "clusterAuditSelectionContentHash", "manifestFrozenAt", "freezeSequence",
    "predecessorArtifactHash", "sampleVersion", "supersedesSampleManifestHash", "supersededSampleManifest",
    "registeredPreResultExclusions", "replacementHistory", "algorithmVersion", "algorithmHash",
    "selectionFormula", "selectionDigestCanonicalization", "selectionDigestByteEncoding",
    "selectionDigestFieldOrder", "selectionDesignHashSemantic", "selectionFrameHashSemantic",
    "selectionGoldenVectorDigest", "allocationMethod", "clusterOwnershipRule", "selectedClusterRule",
    "stratumAllocations", "hamiltonAudit", "totalEligibleClusterCount", "clusterCount", "selectedRows",
    "manifestTupleRootOrder", "manifestTupleRootFormula", "manifestTupleRootHash", "primaryAnalysisWeight",
    "secondaryWeightMethod", "secondaryEstimand", "representativeSelectionRule", "secondaryWeightSummary",
    "resultBlind", "rerollAfterAnyLabelOrResult", "replacementAfterAnyLabelOrResult",
    "sampleSelectionContentRootHash", "sampleManifestHash"
  ],
  "properties": {
    "schemaVersion": { "const": "SampleManifestV2" },
    "designId": { "const": "MAIS-NATURAL-CA60-V3" },
    "registrationHash": { "$ref": "#/$defs/sha256" },
    "designHash": { "$ref": "#/$defs/sha256" },
    "frameRegistrationHash": { "$ref": "#/$defs/sha256" },
    "samplingFrameHash": { "$ref": "#/$defs/sha256" },
    "frameSelectionContentRootHash": { "$ref": "#/$defs/sha256" },
    "frameHash": { "$ref": "#/$defs/sha256" },
    "sourceEnumerationReceiptHash": { "$ref": "#/$defs/sha256" },
    "sourceEnumerationEvidenceContractHash": { "const": "7dbcce3a4f723fdfa8c9aa08acb0bcf4b78f3a696d144209f352d7c7677e005f" },
    "fullSourceEnumerationRootHash": { "$ref": "#/$defs/sha256" },
    "rawEvidenceArtifactRootHash": { "$ref": "#/$defs/sha256" },
    "extractorImplementationHash": { "$ref": "#/$defs/sha256" },
    "extractorRunnerCommit": { "$ref": "#/$defs/gitOid" },
    "extractorRunnerHash": { "$ref": "#/$defs/sha256" },
    "clusterAuditHash": { "$ref": "#/$defs/sha256" },
    "clusterAuditSelectionContentHash": { "$ref": "#/$defs/sha256" },
    "manifestFrozenAt": { "type": "string", "format": "date-time" },
    "freezeSequence": { "const": 2 },
    "predecessorArtifactHash": { "$ref": "#/$defs/sha256" },
    "sampleVersion": { "type": "integer", "minimum": 1, "maximum": 61 },
    "supersedesSampleManifestHash": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "supersededSampleManifest": {
      "anyOf": [{ "$ref": "#" }, { "type": "null" }]
    },
    "registeredPreResultExclusions": {
      "type": "array", "maxItems": 60, "uniqueItems": true,
      "items": { "$ref": "#/$defs/preResultExclusion" }
    },
    "replacementHistory": {
      "type": "array", "maxItems": 60, "uniqueItems": true,
      "items": { "$ref": "#/$defs/replacement" }
    },
    "algorithmVersion": { "const": "natural-ca60-full-frame-hamilton-v3" },
    "algorithmHash": { "const": "952bf9d73d0aeec80add57af3b7da9b11ba892feb52eb4bcaa31e7691187ba94" },
    "selectionFormula": { "const": "SHA256(UTF8(JCS([designHash,frameHash,algorithmVersion,stratum,clusterId,itemHash])))" },
    "selectionDigestCanonicalization": { "const": "RFC8785_JCS" },
    "selectionDigestByteEncoding": { "const": "UTF-8" },
    "selectionDigestFieldOrder": {
      "const": ["designHash", "frameHash", "algorithmVersion", "stratum", "clusterId", "itemHash"]
    },
    "selectionDesignHashSemantic": { "const": "designHash is the frozen design registrationHash" },
    "selectionFrameHashSemantic": { "const": "frameHash is the timestamp-excluded frameSelectionContentRootHash; it is not samplingFrameHash and not frameRegistrationHash" },
    "selectionGoldenVectorDigest": { "const": "e8e1baec2d4685808b99bf15624401646b04c88d3e769300e395befad00b9028" },
    "allocationMethod": { "const": "CAPACITY_AWARE_ITERATIVE_HAMILTON_MINIMUM_TWO" },
    "clusterOwnershipRule": { "const": "LOWEST_MEMBER_SELECTION_DIGEST_THEN_ITEM_ID" },
    "selectedClusterRule": { "const": "LOWEST_REPRESENTATIVE_SELECTION_DIGEST_THEN_ITEM_ID" },
    "stratumAllocations": {
      "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true,
      "items": { "$ref": "#/$defs/allocation" }
    },
    "hamiltonAudit": {
      "type": "array", "minItems": 1, "maxItems": 9,
      "items": { "$ref": "#/$defs/hamiltonRound" }
    },
    "totalEligibleClusterCount": { "type": "integer", "minimum": 60 },
    "clusterCount": { "const": 60 },
    "selectedRows": {
      "type": "array", "minItems": 60, "maxItems": 60, "uniqueItems": true,
      "items": { "$ref": "#/$defs/row" }
    },
    "manifestTupleRootOrder": { "const": "SORTED_ITEM_ID_PLUS_ITEM_HASH_PLUS_CLUSTER_ID" },
    "manifestTupleRootFormula": { "const": "SHA256(JCS(SORTED([itemId,itemHash,clusterId])))" },
    "manifestTupleRootHash": { "$ref": "#/$defs/sha256" },
    "primaryAnalysisWeight": { "const": 1 },
    "secondaryWeightMethod": { "const": "INVERSE_INCLUSION_PROBABILITY_DESCRIPTIVE_WITH_KISH_EFFECTIVE_N" },
    "secondaryEstimand": { "const": "FROZEN_ELIGIBLE_HOMOLOGY_CLUSTER_REPRESENTATIVE_INVENTORY" },
    "representativeSelectionRule": { "const": "DETERMINISTIC_LOWEST_MEMBER_SELECTION_DIGEST_THEN_ITEM_ID" },
    "secondaryWeightSummary": { "$ref": "#/$defs/weightSummary" },
    "resultBlind": { "const": true },
    "rerollAfterAnyLabelOrResult": { "const": false },
    "replacementAfterAnyLabelOrResult": { "const": false },
    "sampleSelectionContentRootHash": { "$ref": "#/$defs/sha256" },
    "sampleManifestHash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "sampleVersion": { "const": 1 } }, "required": ["sampleVersion"] },
      "then": {
        "properties": {
          "supersedesSampleManifestHash": { "type": "null" },
          "supersededSampleManifest": { "type": "null" },
          "registeredPreResultExclusions": { "maxItems": 0 },
          "replacementHistory": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "sampleVersion": { "minimum": 2 } }, "required": ["sampleVersion"] },
      "then": {
        "properties": {
          "supersedesSampleManifestHash": { "$ref": "#/$defs/sha256" },
          "supersededSampleManifest": { "$ref": "#" },
          "registeredPreResultExclusions": { "minItems": 1 },
          "replacementHistory": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitOid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "responseForm": { "enum": ["multiple-choice", "fill-in", "short-answer"] },
    "difficulty": { "enum": ["Low", "Medium", "High"] },
    "stratum": { "type": "string", "pattern": "^(multiple-choice|fill-in|short-answer)::(Low|Medium|High)$" },
    "preResultExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "itemHash", "exclusionCode", "evidenceHash", "registeredAt"],
      "properties": {
        "itemId": { "type": "string", "minLength": 1, "pattern": "^[^|]+$" },
        "itemHash": { "$ref": "#/$defs/sha256" },
        "exclusionCode": { "enum": ["RESTRICTED_EGRESS_CONTENT", "UNSTABLE_SERIALIZATION"] },
        "evidenceHash": { "$ref": "#/$defs/sha256" },
        "registeredAt": { "type": "string", "format": "date-time" }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stratum", "responseForm", "difficulty", "eligibleClusterCount", "executionEligibleClusterCount", "baseMinimumAllocation", "finalAllocation"],
      "properties": {
        "stratum": { "$ref": "#/$defs/stratum" },
        "responseForm": { "$ref": "#/$defs/responseForm" },
        "difficulty": { "$ref": "#/$defs/difficulty" },
        "eligibleClusterCount": { "type": "integer", "minimum": 0 },
        "executionEligibleClusterCount": { "type": "integer", "minimum": 0 },
        "baseMinimumAllocation": { "type": "integer", "minimum": 0, "maximum": 2 },
        "finalAllocation": { "type": "integer", "minimum": 0, "maximum": 60 }
      }
    },
    "hamiltonRound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round", "remainingBefore", "remainingAfter", "denominator", "cells"],
      "properties": {
        "round": { "type": "integer", "minimum": 1, "maximum": 9 },
        "remainingBefore": { "type": "integer", "minimum": 1, "maximum": 60 },
        "remainingAfter": { "type": "integer", "minimum": 0, "maximum": 59 },
        "denominator": { "type": "integer", "minimum": 1 },
        "cells": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/hamiltonCell" } }
      }
    },
    "hamiltonCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stratum", "index", "weight", "residualBefore", "numerator", "denominator", "floorQuota", "floorAward", "remainderNumerator", "remainderAward"],
      "properties": {
        "stratum": { "$ref": "#/$defs/stratum" },
        "index": { "type": "integer", "minimum": 0, "maximum": 8 },
        "weight": { "type": "integer", "minimum": 0 },
        "residualBefore": { "type": "integer", "minimum": 0 },
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 },
        "floorQuota": { "type": "integer", "minimum": 0, "maximum": 60 },
        "floorAward": { "type": "integer", "minimum": 0, "maximum": 60 },
        "remainderNumerator": { "type": "integer", "minimum": 0 },
        "remainderAward": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusterId", "itemId", "itemHash", "stratum", "responseForm", "difficulty", "selectionDigest", "clusterInclusionProbability", "representativeSelectionProbability", "itemInclusionProbability", "inclusionProbability", "analysisWeight", "secondaryAnalysisWeight"],
      "properties": {
        "clusterId": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "minLength": 1, "pattern": "^[^|]+$" },
        "itemHash": { "$ref": "#/$defs/sha256" },
        "stratum": { "$ref": "#/$defs/stratum" },
        "responseForm": { "$ref": "#/$defs/responseForm" },
        "difficulty": { "$ref": "#/$defs/difficulty" },
        "selectionDigest": { "$ref": "#/$defs/sha256" },
        "clusterInclusionProbability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "representativeSelectionProbability": { "const": 1 },
        "itemInclusionProbability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "inclusionProbability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "analysisWeight": { "const": 1 },
        "secondaryAnalysisWeight": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "weightSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemCount", "sumWeights", "sumSquaredWeights", "kishEffectiveSampleSize"],
      "properties": {
        "itemCount": { "const": 60 },
        "sumWeights": { "type": "number", "exclusiveMinimum": 0 },
        "sumSquaredWeights": { "type": "number", "exclusiveMinimum": 0 },
        "kishEffectiveSampleSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 }
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exclusionIndex", "removedItemId", "removedItemHash", "exclusionCode", "exclusionEvidenceHash", "replacementItemId", "replacementItemHash", "replacementClusterId", "replacementStratum"],
      "properties": {
        "exclusionIndex": { "type": "integer", "minimum": 1, "maximum": 60 },
        "removedItemId": { "type": "string", "minLength": 1, "pattern": "^[^|]+$" },
        "removedItemHash": { "$ref": "#/$defs/sha256" },
        "exclusionCode": { "enum": ["RESTRICTED_EGRESS_CONTENT", "UNSTABLE_SERIALIZATION"] },
        "exclusionEvidenceHash": { "$ref": "#/$defs/sha256" },
        "replacementItemId": { "anyOf": [{ "type": "string", "minLength": 1, "pattern": "^[^|]+$" }, { "type": "null" }] },
        "replacementItemHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "replacementClusterId": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "replacementStratum": { "anyOf": [{ "$ref": "#/$defs/stratum" }, { "type": "null" }] }
      }
    }
  },
  "$comment": "SampleManifestV2 is the only semantic execution sample interface for V3; SampleManifestV1 is legacy structural compatibility only. Cross-field roots, chronology, exact Hamilton recomputation, no-reroll, and replacement history are enforced by validateSampleAgainstFrame."
}
