{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/ProviderAttemptReceiptV1.schema.json",
  "title": "ProviderAttemptReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "runId", "registrationHash", "frameRegistrationHash", "sampleManifestHash", "runtimeConfigHash", "authorizationHash", "referenceSealHash", "executionRegistrationHash", "itemIdPseudonym", "itemId", "itemHash", "clusterId", "attemptId", "role", "sequenceNumber", "requestedProvider", "observedProvider", "requestedModel", "observedModel", "requestedEndpoint", "observedEndpointHostname", "requestBodyHash", "responseBodyHash", "parsedOutputHash", "startedAt", "finishedAt", "latencyMs", "httpStatus", "providerRequestId", "finishReason", "parseStatus", "schemaStatus", "attemptStatus", "inputTokens", "outputTokens", "reasoningTokens", "totalTokens", "rawUsage", "usageMappingVersion", "costRateSnapshotHash", "estimatedCost", "cumulativeCost", "retryClassification", "redactedError", "appendOnly", "atomicWrite", "fileMode", "completedItemCommitMarkerHash", "cacheHit", "providerInvoiceAuthoritative", "previousReceiptHash", "selfHash"],
  "properties": {
    "schemaVersion": { "const": "ProviderAttemptReceiptV1" },
    "designId": { "const": "MAIS-NATURAL-CA60-V3" },
    "runId": { "type": "string", "minLength": 1 },
    "registrationHash": { "$ref": "#/$defs/sha256" },
    "frameRegistrationHash": { "$ref": "#/$defs/sha256" },
    "sampleManifestHash": { "$ref": "#/$defs/sha256" },
    "runtimeConfigHash": { "$ref": "#/$defs/sha256" },
    "authorizationHash": { "$ref": "#/$defs/sha256" },
    "referenceSealHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "executionRegistrationHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "itemIdPseudonym": { "type": "string", "minLength": 1 },
    "itemId": { "type": "string", "minLength": 1 },
    "itemHash": { "$ref": "#/$defs/sha256" },
    "clusterId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "role": { "$ref": "#/$defs/role" },
    "sequenceNumber": { "type": "integer", "minimum": 1 },
    "requestedProvider": { "$ref": "#/$defs/provider" },
    "observedProvider": { "anyOf": [{ "$ref": "#/$defs/provider" }, { "type": "null" }] },
    "requestedModel": { "enum": ["qwen3.8-max", "deepseek-v4-pro"] },
    "observedModel": { "anyOf": [{ "enum": ["qwen3.8-max", "deepseek-v4-pro"] }, { "type": "null" }] },
    "requestedEndpoint": { "enum": ["https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions", "https://api.deepseek.com/chat/completions"] },
    "observedEndpointHostname": { "anyOf": [{ "enum": ["dashscope.aliyuncs.com", "api.deepseek.com"] }, { "type": "null" }] },
    "requestBodyHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "responseBodyHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "parsedOutputHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "latencyMs": { "type": "integer", "minimum": 0 },
    "httpStatus": { "anyOf": [{ "type": "integer", "minimum": 100, "maximum": 599 }, { "type": "null" }] },
    "providerRequestId": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "finishReason": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "parseStatus": { "enum": ["NOT_ATTEMPTED", "VALID", "INVALID"] },
    "schemaStatus": { "enum": ["NOT_ATTEMPTED", "VALID", "INVALID"] },
    "attemptStatus": { "enum": ["SUCCESS", "TRANSIENT_NETWORK_FAILURE", "TIMEOUT", "HTTP_429", "HTTP_500", "MALFORMED_200", "SCHEMA_FAILURE", "CAP_BLOCKED_BEFORE_REQUEST"] },
    "inputTokens": { "type": "integer", "minimum": 0 },
    "outputTokens": { "type": "integer", "minimum": 0 },
    "reasoningTokens": { "type": "integer", "minimum": 0 },
    "totalTokens": { "type": "integer", "minimum": 0 },
    "rawUsage": { "type": "object", "additionalProperties": false, "required": ["promptTokens", "completionTokens", "reasoningTokens"], "properties": { "promptTokens": { "type": "integer", "minimum": 0 }, "completionTokens": { "type": "integer", "minimum": 0 }, "reasoningTokens": { "type": "integer", "minimum": 0 } } },
    "usageMappingVersion": { "const": "OPENAI_COMPAT_REASONING_INCLUDED_IN_COMPLETION_V1" },
    "costRateSnapshotHash": { "$ref": "#/$defs/sha256" },
    "estimatedCost": { "type": "number", "minimum": 0 },
    "cumulativeCost": { "type": "number", "minimum": 0 },
    "retryClassification": { "enum": ["NONE", "TRANSIENT_RETRY_ALLOWED", "SCHEMA_RETRY_ALLOWED", "PERMANENT_NO_RETRY", "CAP_BLOCKED"] },
    "redactedError": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "appendOnly": { "const": true },
    "atomicWrite": { "const": true },
    "fileMode": { "const": "0600" },
    "completedItemCommitMarkerHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "cacheHit": { "const": false },
    "providerInvoiceAuthoritative": { "const": true },
    "previousReceiptHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "selfHash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    { "if": { "properties": { "requestedProvider": { "const": "ALIBABA_CLOUD_MODEL_STUDIO" } }, "required": ["requestedProvider"] }, "then": { "properties": { "requestedModel": { "const": "qwen3.8-max" }, "requestedEndpoint": { "const": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions" }, "role": { "enum": ["A_SOLVE", "A_LABEL", "B_SOLVE", "B_LABEL", "ADJUDICATOR"] }, "observedProvider": { "enum": ["ALIBABA_CLOUD_MODEL_STUDIO", null] }, "observedModel": { "enum": ["qwen3.8-max", null] }, "observedEndpointHostname": { "enum": ["dashscope.aliyuncs.com", null] }, "referenceSealHash": { "type": "null" }, "executionRegistrationHash": { "type": "null" } } } },
    { "if": { "properties": { "requestedProvider": { "const": "DEEPSEEK_DIRECT" } }, "required": ["requestedProvider"] }, "then": { "properties": { "requestedModel": { "const": "deepseek-v4-pro" }, "requestedEndpoint": { "const": "https://api.deepseek.com/chat/completions" }, "role": { "enum": ["B_PRIME_CRITIQUE", "B_PRIME_REVISION", "C0_PRIME_ROLE_1", "C0_PRIME_ROLE_2", "C0_PRIME_ROLE_3", "C0_PRIME_ROLE_4", "C0_PRIME_ROLE_5"] }, "observedProvider": { "enum": ["DEEPSEEK_DIRECT", null] }, "observedModel": { "enum": ["deepseek-v4-pro", null] }, "observedEndpointHostname": { "enum": ["api.deepseek.com", null] }, "referenceSealHash": { "$ref": "#/$defs/sha256" }, "executionRegistrationHash": { "$ref": "#/$defs/sha256" } } } },
    { "if": { "properties": { "attemptStatus": { "not": { "const": "CAP_BLOCKED_BEFORE_REQUEST" } } }, "required": ["attemptStatus"] }, "then": { "properties": { "requestBodyHash": { "$ref": "#/$defs/sha256" } } } },
    { "if": { "properties": { "attemptStatus": { "const": "SUCCESS" } }, "required": ["attemptStatus"] }, "then": { "properties": { "observedProvider": { "type": "string" }, "observedModel": { "type": "string" }, "observedEndpointHostname": { "type": "string" }, "requestBodyHash": { "$ref": "#/$defs/sha256" }, "responseBodyHash": { "$ref": "#/$defs/sha256" }, "parsedOutputHash": { "$ref": "#/$defs/sha256" }, "httpStatus": { "const": 200 }, "providerRequestId": { "type": "string", "minLength": 1 }, "finishReason": { "type": "string", "minLength": 1 }, "parseStatus": { "const": "VALID" }, "schemaStatus": { "const": "VALID" }, "retryClassification": { "const": "NONE" }, "redactedError": { "type": "null" } } } },
    { "if": { "properties": { "attemptStatus": { "enum": ["TRANSIENT_NETWORK_FAILURE", "TIMEOUT"] } }, "required": ["attemptStatus"] }, "then": { "properties": { "httpStatus": { "type": "null" }, "responseBodyHash": { "type": "null" }, "parsedOutputHash": { "type": "null" }, "providerRequestId": { "type": "null" }, "finishReason": { "type": "null" }, "parseStatus": { "const": "NOT_ATTEMPTED" }, "schemaStatus": { "const": "NOT_ATTEMPTED" }, "inputTokens": { "const": 0 }, "outputTokens": { "const": 0 }, "reasoningTokens": { "const": 0 }, "totalTokens": { "const": 0 }, "estimatedCost": { "const": 0 }, "retryClassification": { "const": "TRANSIENT_RETRY_ALLOWED" } } } },
    { "if": { "properties": { "attemptStatus": { "const": "HTTP_429" } }, "required": ["attemptStatus"] }, "then": { "properties": { "httpStatus": { "const": 429 }, "parsedOutputHash": { "type": "null" }, "finishReason": { "type": "null" }, "parseStatus": { "const": "NOT_ATTEMPTED" }, "schemaStatus": { "const": "NOT_ATTEMPTED" }, "inputTokens": { "const": 0 }, "outputTokens": { "const": 0 }, "reasoningTokens": { "const": 0 }, "totalTokens": { "const": 0 }, "estimatedCost": { "const": 0 }, "retryClassification": { "const": "TRANSIENT_RETRY_ALLOWED" } } } },
    { "if": { "properties": { "attemptStatus": { "const": "HTTP_500" } }, "required": ["attemptStatus"] }, "then": { "properties": { "httpStatus": { "const": 500 }, "parsedOutputHash": { "type": "null" }, "finishReason": { "type": "null" }, "parseStatus": { "const": "NOT_ATTEMPTED" }, "schemaStatus": { "const": "NOT_ATTEMPTED" }, "inputTokens": { "const": 0 }, "outputTokens": { "const": 0 }, "reasoningTokens": { "const": 0 }, "totalTokens": { "const": 0 }, "estimatedCost": { "const": 0 }, "retryClassification": { "const": "TRANSIENT_RETRY_ALLOWED" } } } },
    { "if": { "properties": { "attemptStatus": { "const": "MALFORMED_200" } }, "required": ["attemptStatus"] }, "then": { "properties": { "httpStatus": { "const": 200 }, "providerRequestId": { "type": "string", "minLength": 1 }, "parseStatus": { "const": "INVALID" }, "schemaStatus": { "const": "NOT_ATTEMPTED" }, "parsedOutputHash": { "type": "null" }, "retryClassification": { "enum": ["SCHEMA_RETRY_ALLOWED", "PERMANENT_NO_RETRY"] } } } },
    { "if": { "properties": { "attemptStatus": { "const": "SCHEMA_FAILURE" } }, "required": ["attemptStatus"] }, "then": { "properties": { "httpStatus": { "const": 200 }, "providerRequestId": { "type": "string", "minLength": 1 }, "parseStatus": { "const": "VALID" }, "schemaStatus": { "const": "INVALID" }, "parsedOutputHash": { "$ref": "#/$defs/sha256" }, "retryClassification": { "enum": ["SCHEMA_RETRY_ALLOWED", "PERMANENT_NO_RETRY"] } } } },
    { "if": { "properties": { "attemptStatus": { "const": "CAP_BLOCKED_BEFORE_REQUEST" } }, "required": ["attemptStatus"] }, "then": { "properties": { "observedProvider": { "type": "null" }, "observedModel": { "type": "null" }, "observedEndpointHostname": { "type": "null" }, "requestBodyHash": { "type": "null" }, "responseBodyHash": { "type": "null" }, "parsedOutputHash": { "type": "null" }, "httpStatus": { "type": "null" }, "providerRequestId": { "type": "null" }, "finishReason": { "type": "null" }, "parseStatus": { "const": "NOT_ATTEMPTED" }, "schemaStatus": { "const": "NOT_ATTEMPTED" }, "inputTokens": { "const": 0 }, "outputTokens": { "const": 0 }, "reasoningTokens": { "const": 0 }, "totalTokens": { "const": 0 }, "estimatedCost": { "const": 0 }, "retryClassification": { "const": "CAP_BLOCKED" } } } }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider": { "enum": ["ALIBABA_CLOUD_MODEL_STUDIO", "DEEPSEEK_DIRECT"] },
    "role": { "enum": ["A_SOLVE", "A_LABEL", "B_SOLVE", "B_LABEL", "ADJUDICATOR", "B_PRIME_CRITIQUE", "B_PRIME_REVISION", "C0_PRIME_ROLE_1", "C0_PRIME_ROLE_2", "C0_PRIME_ROLE_3", "C0_PRIME_ROLE_4", "C0_PRIME_ROLE_5"] }
  }
}
