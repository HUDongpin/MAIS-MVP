{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/ProviderAuthorizationV1.schema.json",
  "title": "ProviderAuthorizationV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "registrationHash", "frameRegistrationHash", "samplingFrameHash", "sampleManifestHash", "runtimeConfigHash", "promptSetHash", "schemaSetHash", "runnerCommit", "runnerHash", "adapterHash", "provider", "region", "endpoint", "model", "roleSet", "requestTemplateHash", "payloadSetHash", "allowedOrigin", "egressAllowlist", "egressDenylist", "privacyScreenHash", "rightsScreenHash", "issuedAt", "expiresAt", "maximumAttempts", "maximumSuccessfulCalls", "maximumInputTokens", "maximumOutputTokens", "maximumTokens", "maximumEstimatedUsd", "currency", "concurrencyCap", "worstCaseUsagePlan", "worstCaseCostPreviewUsd", "costBufferMultiplier", "bufferedWorstCaseUsd", "priceSnapshot", "authorizedBy", "ownerGrantHash", "authorizationEvidenceHash", "nonAuthorizations", "previousAuthorizationHash", "authorizationHash"],
  "properties": {
    "schemaVersion": { "const": "ProviderAuthorizationV1" },
    "designId": { "const": "MAIS-NATURAL-CA60-V3" },
    "registrationHash": { "$ref": "#/$defs/sha256" },
    "frameRegistrationHash": { "$ref": "#/$defs/sha256" },
    "samplingFrameHash": { "$ref": "#/$defs/sha256" },
    "sampleManifestHash": { "$ref": "#/$defs/sha256" },
    "runtimeConfigHash": { "$ref": "#/$defs/sha256" },
    "promptSetHash": { "$ref": "#/$defs/sha256" },
    "schemaSetHash": { "$ref": "#/$defs/sha256" },
    "runnerCommit": { "$ref": "#/$defs/sha1" },
    "runnerHash": { "$ref": "#/$defs/sha256" },
    "adapterHash": { "$ref": "#/$defs/sha256" },
    "provider": { "enum": ["ALIBABA_CLOUD_MODEL_STUDIO", "DEEPSEEK_DIRECT"] },
    "region": { "enum": ["cn-beijing", "PROVIDER_MANAGED"] },
    "endpoint": { "enum": ["https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions", "https://api.deepseek.com/chat/completions"] },
    "model": { "enum": ["qwen3.8-max", "deepseek-v4-pro"] },
    "roleSet": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/role" } },
    "requestTemplateHash": { "$ref": "#/$defs/sha256" },
    "payloadSetHash": { "$ref": "#/$defs/sha256" },
    "allowedOrigin": { "const": "FROZEN_RUNTIME_VISIBLE_CA_FRAME" },
    "egressAllowlist": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["prompt", "options", "locale", "grade", "topic", "responseForm", "storedAnswer", "acceptedAnswers", "explanation", "itemSolveArtifact", "aSolveArtifact", "aLabelArtifact", "bSolveArtifact", "bLabelArtifact", "rubric", "difficulty", "itemPseudonym"] } },
    "egressDenylist": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "enum": ["QWEN_FINAL_REFERENCE_TO_DEEPSEEK", "DEEPSEEK_OUTPUT_TO_QWEN", "SOURCE_PATH", "GIT_METADATA", "CREDENTIAL", "STUDENT_OR_USER_DATA", "OTHER_ITEM", "UNAUTHORIZED_COPYRIGHT_CONTENT", "INTERNAL_RESEARCH_RECORD"] } },
    "privacyScreenHash": { "$ref": "#/$defs/sha256" },
    "rightsScreenHash": { "$ref": "#/$defs/sha256" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "maximumAttempts": { "type": "integer", "minimum": 1, "maximum": 850 },
    "maximumSuccessfulCalls": { "type": "integer", "minimum": 1, "maximum": 420 },
    "maximumInputTokens": { "type": "integer", "minimum": 1, "maximum": 6000000 },
    "maximumOutputTokens": { "type": "integer", "minimum": 1, "maximum": 6000000 },
    "maximumTokens": { "type": "integer", "minimum": 1, "maximum": 6000000 },
    "maximumEstimatedUsd": { "type": "number", "exclusiveMinimum": 0, "maximum": 25 },
    "currency": { "const": "USD" },
    "concurrencyCap": { "const": 4 },
    "worstCaseUsagePlan": { "type": "object", "additionalProperties": false, "required": ["inputTokens", "outputTokens", "reasoningTokens", "totalTokens", "maximumSuccessfulCalls"], "properties": { "inputTokens": { "type": "integer", "minimum": 0 }, "outputTokens": { "type": "integer", "minimum": 0 }, "reasoningTokens": { "type": "integer", "minimum": 0 }, "totalTokens": { "type": "integer", "minimum": 0 }, "maximumSuccessfulCalls": { "type": "integer", "minimum": 1, "maximum": 420 } } },
    "worstCaseCostPreviewUsd": { "type": "number", "minimum": 0 },
    "costBufferMultiplier": { "const": 1.2 },
    "bufferedWorstCaseUsd": { "type": "number", "minimum": 0, "maximum": 25 },
    "priceSnapshot": { "type": "object", "additionalProperties": false, "required": ["priceSnapshotHash", "officialSourceHash", "snapshotAt", "dataRegion", "currency", "inputRate", "outputRate", "reasoningRate", "reasoningIncludedInCompletion", "usageMappingVersion", "rateUnit", "currentAtAuthorization"], "properties": { "priceSnapshotHash": { "$ref": "#/$defs/sha256" }, "officialSourceHash": { "$ref": "#/$defs/sha256" }, "snapshotAt": { "type": "string", "format": "date-time" }, "dataRegion": { "type": "string", "minLength": 1 }, "currency": { "const": "USD" }, "inputRate": { "type": "number", "minimum": 0 }, "outputRate": { "type": "number", "minimum": 0 }, "reasoningRate": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }, "reasoningIncludedInCompletion": { "type": "boolean" }, "usageMappingVersion": { "const": "OPENAI_COMPAT_REASONING_INCLUDED_IN_COMPLETION_V1" }, "rateUnit": { "const": "USD_PER_MILLION_TOKENS" }, "currentAtAuthorization": { "const": true } } },
    "authorizedBy": { "type": "string", "minLength": 1 },
    "ownerGrantHash": { "$ref": "#/$defs/sha256" },
    "authorizationEvidenceHash": { "$ref": "#/$defs/sha256" },
    "nonAuthorizations": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "enum": ["NO_DEPLOYMENT", "NO_LIVE_QUESTION_BANK_MUTATION", "NO_GIT_MUTATION", "NO_MODEL_FALLBACK", "NO_BUDGET_TRANSFER", "NO_PROMPT_TUNING", "NO_RESULT_DEPENDENT_REPLACEMENT"] } },
    "previousAuthorizationHash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "authorizationHash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    { "if": { "properties": { "provider": { "const": "ALIBABA_CLOUD_MODEL_STUDIO" } }, "required": ["provider"] }, "then": { "properties": { "region": { "const": "cn-beijing" }, "endpoint": { "const": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions" }, "model": { "const": "qwen3.8-max" }, "roleSet": { "const": ["A_SOLVE", "A_LABEL", "B_SOLVE", "B_LABEL", "ADJUDICATOR"] }, "egressAllowlist": { "const": ["prompt", "options", "locale", "grade", "topic", "responseForm", "storedAnswer", "acceptedAnswers", "explanation", "itemSolveArtifact", "aSolveArtifact", "aLabelArtifact", "bSolveArtifact", "bLabelArtifact"] }, "maximumAttempts": { "const": 610 }, "maximumSuccessfulCalls": { "const": 300 }, "maximumInputTokens": { "const": 4000000 }, "maximumOutputTokens": { "const": 4000000 }, "maximumTokens": { "const": 4000000 }, "priceSnapshot": { "properties": { "dataRegion": { "const": "cn-beijing" } } } } } },
    { "if": { "properties": { "provider": { "const": "DEEPSEEK_DIRECT" } }, "required": ["provider"] }, "then": { "properties": { "region": { "const": "PROVIDER_MANAGED" }, "endpoint": { "const": "https://api.deepseek.com/chat/completions" }, "model": { "const": "deepseek-v4-pro" }, "roleSet": { "const": ["B_PRIME_CRITIQUE", "B_PRIME_REVISION", "C0_PRIME_ROLE_1", "C0_PRIME_ROLE_2", "C0_PRIME_ROLE_3", "C0_PRIME_ROLE_4", "C0_PRIME_ROLE_5"] }, "egressAllowlist": { "const": ["prompt", "options", "storedAnswer", "acceptedAnswers", "explanation", "rubric", "difficulty", "itemPseudonym"] }, "maximumAttempts": { "const": 850 }, "maximumSuccessfulCalls": { "const": 420 }, "maximumInputTokens": { "const": 6000000 }, "maximumOutputTokens": { "const": 6000000 }, "maximumTokens": { "const": 6000000 }, "priceSnapshot": { "properties": { "dataRegion": { "const": "DIRECT_BILLING_ROUTE" } } } } } }
  ],
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "role": { "enum": ["A_SOLVE", "A_LABEL", "B_SOLVE", "B_LABEL", "ADJUDICATOR", "B_PRIME_CRITIQUE", "B_PRIME_REVISION", "C0_PRIME_ROLE_1", "C0_PRIME_ROLE_2", "C0_PRIME_ROLE_3", "C0_PRIME_ROLE_4", "C0_PRIME_ROLE_5"] }
  }
}
