{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/NaturalCaPilotDesignRegistrationV1.schema.json",
  "title": "NaturalCaPilotDesignRegistrationV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "designKind", "version", "frozenAt", "baselineCommitSha", "provenance", "scope", "eligibility", "stratification", "homologyClustering", "deterministicSelection", "machineReferenceWorkflow", "taxonomy", "labeling", "analysis", "providerControls", "artifactKinds", "freezeChain", "registrationHash"],
  "properties": {
    "schemaVersion": { "const": "NaturalCaPilotDesignRegistrationV1" },
    "designId": { "const": "MAIS-NATURAL-CA60-V1" },
    "designKind": { "const": "IMMUTABLE_PRE_EXECUTION_DESIGN_REGISTRATION" },
    "version": { "const": 1 },
    "frozenAt": { "type": "string", "format": "date-time" },
    "baselineCommitSha": { "$ref": "#/$defs/sha1" },
    "provenance": { "type": "object", "additionalProperties": true, "required": ["preservedPriorNaturalDesignSha256", "preservationArchiveSha256", "priorThreeRegionPlanStatus"] },
    "scope": { "type": "object", "additionalProperties": true, "required": ["targetClusterCount", "claimBasis", "humanGoldClaim", "claimCeiling"] },
    "eligibility": { "type": "object", "additionalProperties": false, "required": ["inclusion", "exclusion"], "properties": { "inclusion": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "exclusion": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "stratification": { "type": "object", "additionalProperties": true },
    "homologyClustering": { "type": "object", "additionalProperties": true },
    "deterministicSelection": { "type": "object", "additionalProperties": true },
    "machineReferenceWorkflow": { "type": "object", "additionalProperties": true },
    "taxonomy": { "type": "object", "additionalProperties": true },
    "labeling": { "type": "object", "additionalProperties": true },
    "analysis": { "type": "object", "additionalProperties": true },
    "providerControls": { "type": "object", "additionalProperties": true, "required": ["firstProviderExecutionAllowed", "egress", "budgetEnvelope"] },
    "artifactKinds": { "type": "object", "additionalProperties": true },
    "freezeChain": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "string" } },
    "registrationHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
