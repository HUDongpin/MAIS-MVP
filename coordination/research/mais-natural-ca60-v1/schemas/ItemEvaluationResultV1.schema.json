{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/ItemEvaluationResultV1.schema.json",
  "title": "ItemEvaluationResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "registrationHash", "sampleManifestHash", "clusterId", "itemId", "machineReferenceLabelHash", "evaluatedAttemptReceiptHash", "provenanceType", "rawLabel", "rawTaxonomyCodes", "rawSeverity", "finalLabel", "finalTaxonomyCodes", "finalSeverity", "adjudicationStatus", "matchStatus", "resultHash"],
  "properties": {
    "schemaVersion": { "const": "ItemEvaluationResultV1" },
    "designId": { "const": "MAIS-NATURAL-CA60-V1" },
    "registrationHash": { "$ref": "#/$defs/sha256" },
    "sampleManifestHash": { "$ref": "#/$defs/sha256" },
    "clusterId": { "type": "string" },
    "itemId": { "type": "string" },
    "machineReferenceLabelHash": { "$ref": "#/$defs/sha256" },
    "evaluatedAttemptReceiptHash": { "$ref": "#/$defs/sha256" },
    "provenanceType": { "const": "EVALUATED_PROVIDER_MACHINE_OUTPUT" },
    "rawLabel": { "$ref": "#/$defs/label" },
    "rawTaxonomyCodes": { "$ref": "#/$defs/codes" },
    "rawSeverity": { "$ref": "#/$defs/severity" },
    "finalLabel": { "$ref": "#/$defs/label" },
    "finalTaxonomyCodes": { "$ref": "#/$defs/codes" },
    "finalSeverity": { "$ref": "#/$defs/severity" },
    "adjudicationStatus": { "enum": ["NOT_REQUIRED", "ADJUDICATED", "UNRESOLVED"] },
    "matchStatus": { "enum": ["MATCHED", "INVALID_DUPLICATE", "INVALID_MISSING_COUNTERPART"] },
    "resultHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "label": { "enum": ["POSITIVE_DEFECT", "NEGATIVE_NO_DEFECT", "UNRESOLVED"] },
    "severity": { "enum": ["NONE", "MINOR", "MAJOR", "CRITICAL", "UNRESOLVED"] },
    "codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["CORRECT", "FINAL_ANSWER_ERROR", "MATHEMATICAL_REASONING_ERROR", "INCOMPLETE_JUSTIFICATION", "INSTRUCTION_NONCOMPLIANCE", "AMBIGUOUS_OR_UNSCORABLE", "LANGUAGE_OR_NOTATION_ERROR", "SAFETY_OR_PRIVACY_ERROR", "MACHINE_REFERENCE_UNRESOLVED"] } }
  }
}
