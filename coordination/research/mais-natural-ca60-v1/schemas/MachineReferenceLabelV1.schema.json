{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mais.hk/schemas/research/MachineReferenceLabelV1.schema.json",
  "title": "MachineReferenceLabelV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "registrationHash", "sampleManifestHash", "clusterId", "itemId", "provider", "model", "provenanceType", "attemptReceiptHash", "rawLabel", "rawTaxonomyCodes", "rawSeverity", "finalLabel", "finalTaxonomyCodes", "finalSeverity", "adjudicationStatus", "labeledAt", "labelHash"],
  "properties": {
    "schemaVersion": { "const": "MachineReferenceLabelV1" },
    "designId": { "const": "MAIS-NATURAL-CA60-V1" },
    "registrationHash": { "$ref": "#/$defs/sha256" },
    "sampleManifestHash": { "$ref": "#/$defs/sha256" },
    "clusterId": { "type": "string" },
    "itemId": { "type": "string" },
    "provider": { "const": "QWEN" },
    "model": { "const": "qwen3.8-max" },
    "provenanceType": { "const": "MACHINE_REFERENCE" },
    "attemptReceiptHash": { "$ref": "#/$defs/sha256" },
    "rawLabel": { "$ref": "#/$defs/label" },
    "rawTaxonomyCodes": { "$ref": "#/$defs/codes" },
    "rawSeverity": { "$ref": "#/$defs/severity" },
    "finalLabel": { "$ref": "#/$defs/label" },
    "finalTaxonomyCodes": { "$ref": "#/$defs/codes" },
    "finalSeverity": { "$ref": "#/$defs/severity" },
    "adjudicationStatus": { "enum": ["NOT_REQUIRED", "ADJUDICATED", "UNRESOLVED"] },
    "labeledAt": { "type": "string", "format": "date-time" },
    "labelHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "label": { "enum": ["POSITIVE_DEFECT", "NEGATIVE_NO_DEFECT", "UNRESOLVED"] },
    "severity": { "enum": ["NONE", "MINOR", "MAJOR", "CRITICAL", "UNRESOLVED"] },
    "codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["CORRECT", "FINAL_ANSWER_ERROR", "MATHEMATICAL_REASONING_ERROR", "INCOMPLETE_JUSTIFICATION", "INSTRUCTION_NONCOMPLIANCE", "AMBIGUOUS_OR_UNSCORABLE", "LANGUAGE_OR_NOTATION_ERROR", "SAFETY_OR_PRIVACY_ERROR", "MACHINE_REFERENCE_UNRESOLVED"] } }
  }
}
